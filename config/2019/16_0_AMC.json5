{AMC_NAME: "Bandhan Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Bandhan Asset Management Company Limited", mutual_fund_name: "Bandhan Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "IDFC.+?(?:Funds?|Path|Saver|ETF|F[oO]F)\\s*(?:of [Ff]unds?.*?Plan|[Ff]und of [Ff]unds?.*?Plan|[Ff]unds?|F[oO]F|.*?Plan)?", bbox: [0, 0, 460, 55]}, clip_bbox: [[0, 0, 202, 820]], line_x: 200.0, data: {size: [6, 9], color: [23], update_size: 30.0, font: ["Ubuntu-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 11, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "([\\d,.]+\\s*crores?)", benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))", scheme: ["About the Fund", "Monthly Avg AUM", "Month end AUM", "Inception Date", "Fund Manager", "Other Parameter", "Portfolio Turnover", "Expense Ratio", "Benchmark:?", "SIP\\s*\\(Minimum Amount", "Fund Manager", "Portfolio Turnover Ratio", "Benchmark:?", "SIP\\s*\\(Minimum Amount", "Fund Manager", "Other Parameter", "Benchmark:?", "SIP\\s*\\(Minimum Amount", "Minimum Investment Amount", "Option Available", "Exit Load", "NAV\\s*\\(", "EOL"], min_amt: "([\\d,]+).*?(\\d+|any)\\s*(?:amount|thereafter)?", manager: {name: "(?:Mr|Mrs|Ms)\\.?\\s*([A-Za-z]+\\s+[A-Za-z]+)", since: "(\\d{1,2}(?:nd|st|rd|th)?\\s*[A-Za-z]+,?\\s*\\d{4}|[A-Za-z]+\\s*\\d{2},?\\s*\\d{4})"}, nav: "(Regular Plan Growth|Regular Plan IDCW|Direct Plan Growth|Direct Plan IDCW)[\\s]+([\\d]+(?:\\.\\d+)?|NA|Nil)", metric: "(Aggregate|Beta|R\\s*Square|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)", ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)", escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+|\\(Annualized\\)|\u00b7"}, PATTERN_TO_FUNCTION: {"^(before|dummy.*)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*minimum_investment": ["_extract_amt_data", "min_amt"], ".*(total_expense_ratio|portfolio_turnover|other_parameter)": ["_extract_generic_data", "metric"], ".*fund_mana": ["_extract_manager_data", "manager"], ".*benchmark": ["_extract_generic_data", "benchmark"], ".*(monthly_avg_aum|month_end_aum)": ["_extract_generic_data", "aum"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*inception_date", ".*fund_manager", "metrics", ".*benchmark", ".*minimum_investment", ".*monthly_avg_aum$", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "amc_name", "load"], MERGEKEYS: {load: [".*exit_load"], metrics: ["metrics", ".*(total_expense_ratio|portfolio_turnover|other_parameter)"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}