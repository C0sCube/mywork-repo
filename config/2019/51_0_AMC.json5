{AMC_NAME: "Iti Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "ITI Asset Management Limited", mutual_fund_name: "ITI Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(ITI.*?(?:Fund|ETF|Path|Index|Plan)\\s*(?:of Funds?|F[Oo]F|[Ff]und of [Ff]unds?|Funds?)?)", bbox: [0, 0, 460, 65]}, clip_bbox: [[0, 65, 170, 812]], line_x: 180.0, data: {size: [5, 8], color: [23], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 8, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "\\D*?([\\d,]+\\.?\\d+)", bench: "(.*TRI|.*Index|.*Arbitrage)", metric: "(Average PE|Average PB|Standard Deviation|Beta|Sharpe Ratio|Average Maturity|Modified Duration|Yield to Maturity\\D+?|Macaulay Duration|Portfolio Turnover Ratio\\D*)\\s*\\:?\\s*([\\-\\d,]+(?:\\.\\d+)?\\s*(?:days?|months?|years?|%)?)", manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([^\\(]+)\\s*\\([a-z]*Since\\s*([\\d\\s\\w-]+)\\)\\s*Total\\s*Experience\\s*\\:?\\s*([\\d]+\\s*years)", fields: ["name", "since", "exp"]}, scheme: ["INVESTMENT\\s+OBJECTIVE", "Inception\\s+Date", "Benchmark", "Minimum\\s+Application", "Load\\s+Structure", "Entry\\s+Load", "Exit\\s+Load", "Total Expense Ratio", "FUND\\s+MANAGER", "PORTFOLIO\\s+DETAILS", "AUM", "AAUM", "QUANTITATIVE\\s*DATA", "NAV as on", "EOL", "AAUM", "RISK\\s*RATIO", "NAV as on", "EOL", "AAUM", "DEBT.+?INCOME", "NAV as on", "EOL", "AAUM", "QUANTITATIVE\\s*DATA", "NAV as on", "EOL"], min_amt: "([\\d,]+).*?([\\d,]+)", date: "\\(Date of Allotment\\)\\s*\\:?\\s*(.+)(?:Benchmark)?", escape: "[^A-Za-z0-9\\-\\(\\)\\.\\,\\+\\s\\%\\:\\&]+"}, PATTERN_TO_FUNCTION: {"^(scheme.*|before)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*aaum$": ["_extract_generic_data", "aum"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*minimum_applic.*": ["_extract_amt_data", "min_amt"], 