{AMC_NAME: "Baroda Bnp Paribas Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Baroda BNP Paribas Asset Management India Private Limited", mutual_fund_name: "Baroda BNP Paribas Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Baroda.*?(?:Fund|Path|ETF|F[Oo]F|Index|Plan|ELSS.+?96)\\s*(?:Funds?|of [Ff]und?|Fund of [Ff]unds?)?)", bbox: [0, 0, 460, 65]}, clip_bbox: [[0, 60, 170, 820]], line_x: 170.0, data: {size: [9, 10], color: [-1], update_size: 30.0, font: ["Unnamed-T3"]}, content_size: [30.0, 8.0], method: "line", line_side: "left", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "aaum\\s*([\\d,.]+\\s*crs?)", metric: "(RoE\\D+|Portfolio\\s*Yield\\D*|Portfolio Turnover|Average Maturity\\D+|Macaulay Duration\\D+|Tracking Error\\s*(?:Regular)?|Modified Duration\\D*|YTM\\D*|Portfolio Turnover Ratio|Standard Deviation|Beta|Sharpe|Tracking Error Direct)\\s*[\\:\\-]?\\s*\\(?(-?\\d+\\.?\\d*(?:\\))?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)", manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([A-Za-z]+\\s*[A-Za-z]+).+?\\(\\s*Experience\\s*(\\d*\\s*years?)\\)", fields: ["name", "exp"]}, escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+", scheme: ["Investment Objective", "Date of Inception", "Benchmark", "Minimum Investment", "Load Structure", "Plans\\s*&\\s*Option", "AAUM\\s*&\\s*AUM", "Risk Profile", "Fund Managers?", "EOL", "AAUM\\s*&\\s*AUM", "Portfolio Characteristic", "EOL"], min_amt: "([\\d,]+).+?in multiples.+?\\s*([\\d,]+)", load: "(?:Entry Load)?(.*?)Exit Load\\s*(.*)$", lumpsum: ".+Lumpsum investment(.+?)Minimum Additional Purchase Amount(.+?)$"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*load_structure": ["_extract_load_data", "load"], ".*(minimum_investment)": ["_extract_amt_data", "min_amt"], ".*aaum_aum$": ["_extract_generic_data", "aum"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*(portfolio_characteristic|quantitative.*|key_statistics|risk_profile)$": ["_extract_generic_data", "metric"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*benchmark", ".*date_of_allotment", "monthly_aaum_value", ".*fund_manager", "load", "metrics", "amc_name", "main_scheme_name", "monthly_aaum_date", "mutual_fund_name", "page_number", ".*(minimum_investment|minimum_amount|minimum_additional_purchase_amount|minimum_application_amount|minimum_additional_application_amount)"], MERGEKEYS: {metrics: [".*portfolio_characteristic", ".*key_statistics$", ".*quantitative.*$", ".*risk_profile"], load: [".*load_structure"]}, CLONEKEYS: {monthly_aaum_value: ".*aaum_aum$"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}