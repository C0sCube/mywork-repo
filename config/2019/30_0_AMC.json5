{AMC_NAME: "Ppfas Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "PPFAS Asset Management Private Limited", mutual_fund_name: "PPFAS Mutual Fund"}, PARAMS: {title: {ocr: true, pattern: "(Parag\\s*Parikh.*?(?:Fu\\s*n\\s*ds?|ETF|Fo?O?F|Plans?|rune|Fund))", bbox: [0, 0, 580, 80]}, clip_bbox: [[0, 80, 300, 850]], line_x: 210.0, data: {size: [6, 12], color: [-1], update_size: 30.0, font: ["Arial-BoldMT"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 4, pdf_ocr: true, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: ".+Average AUM\\D*\\s*([\\d,.]+\\s*Crores)", benchmark: "(.+?)Additional Bench", benchmark2: "(.+?(?:Index|TRI)\\s*(?:TRI)?)", scheme: ["Name of the Fund", "Investment Objective", "Type of the Scheme", "Date of Allotment", "Assets Under Management", "Net Asset Value", "Entry Load", "Exit Load", "Benchmark Index", "New Purchase", "Additional Purchase", "Monthly SIP", "Q\\s*u\\s*a\\s*n\\s*t\\s*i\\s*t?\\s*a?\\s*t\\s*i\\s*v\\s*e\\s*I\\s*n\\s*d\\s*i\\s*c\\s*a\\s*t\\s*o\\s*r\\s*s?", "EOL"], date: ".+?Date of Allotment(.+?\\d{3,4})", manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*(\\w+\\s\\w+)\\s*(.+?)\\s*\\(Since (Inception|.+?)\\)", fields: ["name", "desig", "since"]}, min_amt: "([\\d.,]+).*?([\\d.,]+|any|$)", metrics: "(Beta|Standard\\s*Deviation|Sharpe\\s*Ratio|Macaulay\\s*Duration\\D*?|Portfolio\\s*Turnover\\D*?|Avg\\s*maturity\\D*?|Modified\\s*Duration\\D*?|Yield\\s*to\\s*Maturity\\D*?)\\s*(-?[\\d.\\s]+\\s*(?:[Tt]imes?|[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)", load: "Entry Load(.+?)Exit Load(.+)$", escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%]+"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_non_esc_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(quantitative|q_u_a_n_t_i_t_a_t_i_v_e|quantitive)": ["_extract_whitespace_data", "metrics"], ".*load_structure": ["_extract_load_data", "load"], ".*assets_under_management": ["_extract_generic_data", "aum"], ".*(new_purchase|additional_purchase)": ["_extract_amt_data", "min_amt"], ".*date_of_allotment": ["_extract_manager_data", "manager"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["amc_name", "mutual_fund_name", "main_scheme_name", "page_number", "monthly_aaum_date", "monthly_aaum_value", "load", ".*(assets_under_management|benchmark_index)", ".*(minimum_application_amount|additional_purchase)", "fund_manager", "inception_date", "metrics"], MERGEKEYS: {load: [".*(entry_load|exit_load)"]}, CLONEKEYS: {fund_manager: ".*date_of_allotment", minimum_application_amount: ".*new_purchase", metrics: ".*(quantitative_indicators|q_u_a_n_t_i_t_a_t_i_v_e.*|quantitive.*)"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}