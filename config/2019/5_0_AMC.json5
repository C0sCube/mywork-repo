{AMC_NAME: "Bank Of India Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "BOI STAR Investment Managers Private Limited", mutual_fund_name: "Bank of India Mutual Fund"}, PARAMS: {method: "line", line_side: "both", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: [], title: {ocr: false, pattern: "((?:Bank of India|BOI).*?(?:Plan|Funds?|ETF|FOF|FTF|Saver)\\s*(?:of Funds?|FO?o?F)?)", bbox: [0, 0, 360, 150]}, clip_bbox: [[0, 150, 285, 810], [285, 150, 570, 810]], line_x: 290.0, data: {size: [6, 9], color: [666], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 10.0]}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {load: "Entry Load\\s*(Nil|.*?)\\s*Exit Load\\s*(.+?)$", ptr: "(\\d+\\.\\d+\\s*times?)", scheme: ["INVESTMENT OBJECTIVE", "BENCHMARK", "DATE\\s*OF\\s*ALLOTMENT", "FUND\\s*MANAGER", "AVERAGE\\s*AUM", "LATEST\\s*AUM", "MINIMUM\\s*APPLICATION", "ADDITIONAL\\s*PURCHASE\\s*AMOUNT", "PORTFOLIO\\s*TURNOVER\\s*RATIO", "OTHER\\s*PARAMETERS", "LOAD\\s*STRUCTURE", "EOL"], manager: {pattern: "([A-Za-z]+\\s[A-Za-z]+)\\s*(?:\\([A-Za-z\\s]+\\))?\\s*\\:?\\s*(?:\\(\\s*w\\.?e\\.?f\\.?\\s*([A-Za-z]+[\\d,\\s]+)\\))?\\s*\\-?\\s*(?:More\\s*Than|Around|About).+?(\\d{1,2}\\s+years)", fields: ["name", "since", "exp"]}, benchmark: "(.+?)\\s*\\(w.+?", min_amt: "([\\d,]+).*?([\\d,]+)", metrics: "(Standard Deviation|Portfolio Yield|Modified Duration|Annualised Yield|Average\\s*\\_?Residual Maturity|Average\\s*Maturity|Macaulay Duration|Tracking Error|Sharpe Ratio|Beta|R\\s*Squared|Treynor)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%)?)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(Annualized\\)"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*load_structure": ["_extract_load_data", "load"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*other_parameter": ["_extract_generic_data", "metrics"], ".*(additional_purchase_amount|minimum_application)": ["_extract_amt_data", "min_amt"], ".*portfolio_turn": ["_extract_generic_data", "ptr"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["load", ".*additional_purchase_amount", ".*minimum_application", ".*average_aum", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "metrics", ".*fund_manager", ".*date_of_allotment", ".*benchmark"], MERGEKEYS: {load: [".*load_structure"], metrics: ["metrics", ".*portfolio_turnover_ratio.*", ".*other_parameter"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}