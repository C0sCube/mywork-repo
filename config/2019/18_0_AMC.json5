{AMC_NAME: "IIFL Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "IIFL Asset Management Limited", mutual_fund_name: "IIFL Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(IIFL.*?(?:FUNDS?|Funds?|ETF|FOF|INDEX|PATH)\\s*(?:OF FUNDS?|FUND OF FUNDS?|F[Oo]F|FUND|.+?PLAN)?)", bbox: [0, 0, 520, 50]}, clip_bbox: [[0, 75, 160, 812]], line_x: 160.0, data: {size: [6, 10], color: [-1], update_size: 30.0, font: ["SpaceGrotesk-SemiBold"]}, content_size: [30.0, 8.0], method: "clip", line_side: "left", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: true, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {manager: {pattern: "(?:Mr|Mrs|Ms)\\.?\\s*(.+?)\\s*has.*?((?:[0-9\\.]+|[A-Za-z]+)\\s*years?)", fields: ["name", "exp"]}, min_amt: "([\\d,]+).*?([\\d,]+)", ter: "([\\d.]+)", date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4}+)", aum: "(Net\\s*AUM|Monthly Average\\D*)\\s*(-?[\\d,.]+\\s*crores?)", scheme: ["Investment Objective", "Fund Manager", "Fund Details", "Date of Allotment", "Bloomberg\\s*Code", "Benchmark\\s*Index\\s*\\:?", "Plans Offered", "Options Offered", "Additional Purchase", "Monthly SIP Option", "Quarterly SIP Option", "Entry Load", "Exit Load", "Dematerialization", "Portfolio Turnover", "NAV as on", "AUM as on", "Monthly Average", "Total Expense Ratio", "EOL", "Tracking Error", "Portfolio Turnover", "Tracking Error", "EOL"], ptr: "([\\d\\.]+\\s*(?:times?)?).*", metrics: "(Std\\.?\\s*Dev|Sharpe\\s*Ratio|Modi.+?Duration|Portfolio\\s*Beta|Residual Maturity|Average Maturity|R\\s*-?\\s*Squared|Treynor|Macaulay Duration|Annualised Portfolio|Yield to Maturity)\\s*\\:?\\s*[:-]?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Dd]ays?|[Mm]onths?|%)?|NA)\\s*(?:(-?[\\d.]+\\s*(?:years|days|months|%)?|NA))?", escape: "[^A-Za-z0-9\\s\\.,\\-\\(\\)\\+\\%\\:\\&]+|\u00b7|\\(Annualised\\)"}, PATTERN_TO_FUNCTION: {"(before|dummy.*)": ["_extract_scheme_non_esc_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(options_offered