{AMC_NAME: "Aditya Birla Sun Life Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Aditya Birla Sun Life Asset Management Company Limited", mutual_fund_name: "Aditya Birla Sun Life Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Aditya\\s*Birla.*?(?:Plan|Funds?|Path|Saver|F[Oo]F)\\s*(?:[Ss]cheme|.+?Plan\\s*(?:A|B)?|of Funds?|F[Oo]F|Funds?|Fund of Funds?|ETF)?)", bbox: [0, 0, 550, 50]}, clip_bbox: [[25, 45, 230, 770]], line_x: 230.0, data: {size: [4, 10], color: [-1, 0], update_size: 30.0, font: ["AnekLatin-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 9, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "([\\d,.]+)\\s*crores", load: "Entry Load(.*?)\\s*Exit Load(.*)$", scheme: ["Fund Manager", "Managing Fund Since", "Experience in Managing", "Date of Allotment", "Type of Scheme", "Application Amount", "Min.\\s*Addl.\\s*Investment", "Benchmark", "Monthly\\s*Average\\s*AUM", "AUM as on", "Load\\s*Structure", "Other\\s*Parameters?", "EOL"], manager: {name: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)?\\s+([A-Z][a-z]+\\s[A-Z][a-z]+)", exp: "\\d+\\.\\d+\\s*Years?", since: "[A-Za-z]+\\s*\\d{1,2},\\s*\\d{4}"}, tracking: "regular\\s*(-?[\\d.]+)", min_amt: "([\\d,]+).*?([\\d,]+)", metric: "(Macaulay Duration|Modif?i?ed Duration|Average Maturity|Yield to Maturity|Standard Deviation|Beta|Sharpe Ratio|Portfolio Turnover|Treynor Ratio|Average PE|Average PBV|Average Dividend Yield)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Dd]ays?|[Mm]onths?|%|[Tt]imes?)?)", escape: "[^A-Za-z0-9\\s\\.,\\-\\(\\)\\+\\%\\:]+"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(application_amount|min._addl._investment).*": ["_extract_amt_data", "min_amt"], ".*other_parameter": ["_extract_generic_data", "metric"], ".*load_structure": ["_extract_load_data", "load"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["main_scheme_name", "amc_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "metrics", "load", ".*monthly_average_aum", ".*(date_of|benchmark).*", ".*(application_amount|min_addl_amt).*", "fund_manager"], MERGEKEYS: {load: [".*load_structure"], min_addl_amt: [".*min._addl._investment"], fund_manager: ["fund_manager", "experience_in_managing", "managing_fund_since"], metrics: ["metrics", "tracking_error", ".*other_parameter"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {fund_manager: "_update_manager_data"}}