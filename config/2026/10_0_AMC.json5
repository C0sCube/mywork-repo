{
  AMC_NAME: "Quant Mutual Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Quant Money Managers Limited",
    mutual_fund_name: "Quant Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "([Qq]uant.*?(?:FUNDS?|Funds?|ETF|Index|Plan|Path)\\s*(?:of [Ff]unds?|F[oO]F|Funds?|Fund of [Ff]unds?)?)",
      bbox: [0, 0, 480, 80],
    },
    clip_bbox: [
      [0, 96, 180, 812],
      [430, 0, 650, 500],
      [170, 740, 560, 812],
    ],
    line_x: 200.0,
    data: {
      size: [7, 20],
      color: [-1],
      update_size: 30.0,
      font: ["Calibri,Bold", "Inter-Bold"],
    },
    content_size: [30.0, 14.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: ["^dummy.*"],
  REGEX: {
    scheme: [
      "INCEPTION DATE",
      "RISK ADJUSTED MEASURES",
      "CONTRIBUTION BY MARKET CAP",
      "FUND MANAGERS",
      "LOAD STRUCTURE|MINIMUM INVESTMENT|EOL",
      "SUBSEQUENT INVESTMENT|EOL",
      "LOAD STRUCTURE",
      "NAV Details|BENCHMARK INDEX",
      "BENCHMARK INDEX",
      "Scheme",
      "EOL",
    ],
    scheme2: [
      "MINIMUM INVESTMENT",
      "SUBSEQUENT INVESTMENT",
      "FUND SIZE",
      "EOL",
    ],
    load: "Entry(.+?)Exit(.+?)\\s*(?=NAV Details|BENCHMARK INDEX|$)",
    aum: "([\\d,.]+\\s*[Cc]r?)",
    manager: {
      pattern: "([A-Za-z\\s]{2,}),?",
      fields: ["name"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([0-9]+\\s*[A-Za-z]+\\s*[0-9]+)",
    metrics: "(Sharpe\\s*Ratio|Sortino\\s*Ratio|Jensen\\s*s?\\s*Alpha|R-?\\s*Squared|Downside\\s*Deviation|Upside\\s*Deviation|Average Maturity| Modified Duration|Macaulay Duration|Yield to Maturity)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^before": ["_extract_scheme_data", "scheme"],
    ".*dummy": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(subsequent_investment|minimum_investment)$": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*fund_size": ["_extract_generic_data", "aum"],
    ".*risk_adjusted_measures": ["_extract_generic_data", "metrics"],
    ".*inception_date": ["_extract_generic_data", "date"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "main_scheme_name",
    "mutual_fund_name",
    "page_number",
    "monthly_aaum_date",
    ".*(subsequent_investment|minimum_investment|benchmark_index|inception_date)",
    ".*fund_managers",
    ".*load_structure",
    ".*risk.*measures$",
    ".*fund_size",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
