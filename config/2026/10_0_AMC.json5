{
  AMC_NAME: "Quant Mutual Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Quant Money Managers Limited",
    mutual_fund_name: "Quant Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "([Qq]uant.*?(?:FUNDS?|Funds?|ETF|Index|Plan|Path)\\s*(?:of [Ff]unds?|F[oO]F|Funds?|Fund of [Ff]unds?)?)",
      bbox: [135, 15, 460, 90],
    },
    clip_bbox: [
      [0, 75, 205, 810],
      [405, 90, 590, 810],
    ],
    line_x: 200.0,
    data: {
      size: [7, 20],
      color: [-1],
      update_size: 30.0,
      font: ["Calibri,Bold", "Inter-Bold"],
    },
    content_size: [30.0, 14.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 3,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    scheme: [
      "Date of.+?Allotment",
      "Benchmark Name",
      "NAV",
      "AUM",
      "AAUM",
      "Fund Manager Details",
      "Minimum Investment",
      "SIP Amount",
      "Load Structure",
      "Exit Load",
      "Expense Ratio",
      "EOL",
    ],
    scheme2: [
      "Quantitative Measures?",
      "EOL",
    ],
    load: "Entry(.+?)Exit(.+?)",
    aum: "([\\d,.]+\\s*[Cc]r?)",
    manager: {
      // pattern: "([A-Za-z\\s]{2,}),?",
      "name":"Name\\s+[Oo]f\\s+[fF]und\\s+[mM]anager:?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      "exp":"(\\d+\\s+[Yy]ears?)",
      "since":"Managing\\s+Since:?\\s+(\\d{2}\\s+[A-Za-z]+\\s+\\d{4})",
      // fields: ["name"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([0-9]+\\s*[A-Za-z]+\\s*[0-9]+)",
    metrics: "(Beta|Information\\s+Ratio|Equity Turnover|Sharpe\\s*Ratio|Sortino\\s*Ratio|Jensen\\s*s?\\s*Alpha|R-?\\s*Squared|Downside\\s*Deviation|Upside\\s*Deviation|Average Maturity| Modified Duration|Macaulay Duration|Yield to Maturity)\\s*(?:\\:?|\\(.+?\\))?\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+|TRI",
  },
  PATTERN_TO_FUNCTION: {
    "^before": ["_extract_scheme_data", "scheme"],
    ".*dummy": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(sip_amount|minimum_investment)$": [
      "_extract_amt_data",
      "min_amt",
    ],
    // ".*load_structure": ["_extract_load_data", "load"],
    ".*aaum$": ["_extract_generic_data", "aum"],
    ".*quantitative_measures": ["_extract_generic_data", "metrics"],
    ".*allotment": ["_extract_generic_data", "date"],
    // ".*(?:fund|money)_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "main_scheme_name",
    "mutual_fund_name",
    "page_number",
    "monthly_aaum_date",
    ".*minimum_investment",
    "benchmark",
    "date_of_inception$",
    ".*fund_manager",
    "load",
    "addl_amt",
    ".*aaum$",
    "metrics"
  ],
  MERGEKEYS: {load:[".*(exit_load|entry_load)$"],metrics:[".*quantitative_measures?"]},
  CLONEKEYS: {addl_amt:".*sip_amount","benchmark":".*benchmark_name", date_of_inception:".*allotment"},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {fund_manager:"_update_manager_data"},
  Z_MUTUAL_FUND_DATA: {},
}
