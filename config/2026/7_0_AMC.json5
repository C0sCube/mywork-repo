{
  AMC_NAME: "Pgim India Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "PGIM India Asset Management Private Limited",
    mutual_fund_name: "PGIM India Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "([A-Z0-9\\s\\-]+\\s*PGIM INDIA)",
      bbox: [0, 0, 300, 80],
    },
    clip_bbox: [
      [0, 115, 210, 812],
      [0, 680, 570, 812],
    ],
    line_x: 210.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["PrudentialModern-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: true,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [
    "fund_details",
    "^regular_plan_and_direct_plan.*",
    "for_subscription_as_*",
  ],
  REGEX: {
    aum: ".*Monthly Average AUM.*?([\\d,.]+)$",
    benchmark: "((?:Nifty|BSE|NYSE|Domestic|CRISIL).+?(?:Gold|Silver|TRI|Index))",
    date: "(\\d+\\/\\d+\\/\\d{3,4})",
    scheme: [
      "Investment Objective",
      "Fund Manager",
      "Benchmark",
      "Option",
      "Quarterly.+?Average AUM",
      "Monthly\\s*[aA]verage AUM",
      "AUM as on",
      "NAV",
      "Load Structure",
      "IDCW\\s*History",
      "EOL",
    ],
    scheme2: [
      "Regular Plan",
      "Direct Plan",
      "EOL",
      "Application Amount",
      "Additional Purchase",
      "SIP",
      "EOL",
    ],
    min_amt: "([\\d,.]+)\\s*\\/?\\s*\\-?\\s*and in multiples of\\s*([\\d,.]+)\\s*\\/?\\s*\\-?\\s*thereafter\\.?",
    manager: {
      pattern: "(?:\\(w\\.e\\.f\\.?\\s*(.*?)\\)?)?\\s*(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s*(?:\\(.+?\\))?\\s*\\(.*?([0-9]+ years) of experience.*?\\)",
      fields: ["since", "name", "exp"],
    },
    metrics: "(Portfolio Turnover|Standard Deviation of Fund|Beta|Sharpe Ratio| Average Maturity|Modified Duration|Macaulay Duration|Portfolio Yield).*?\\s*(-?[\\d.,]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]e?a?rs|%)?)",
    load: "Entry Load(.+)Exit Load(.+)$",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\/\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before)": ["_extract_scheme_data", "scheme"],
    "^(dummy.*)": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*aum_as_on$": ["_extract_generic_data", "metrics"],
    "regular_plan.*(application_amount|additional_purchase)$": [
      "_extract_amt_data",
      "min_amt",
    ],
    "^for_subscription.*": ["_extract_amt_data", "min_amt"],
    ".*inception_date": ["_extract_generic_data", "date"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(additional_purchase|application_amount)$",
    ".*(fund_manager|average_aum|benchmark)",
    ".*load_structure",
    "amc_name",
    "metrics",
    "main_scheme_name",
    "mutual_fund_name",
    "page_number",
    "monthly_aaum_date",
    "scheme_launch_date",
  ],
  MERGEKEYS: { metrics: [".*aum_as_on"] },
  CLONEKEYS: { scheme_launch_date: "dummy.*regular_plan" },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {
