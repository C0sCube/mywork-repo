{
  "AMC_NAME": "Pgim India Mutual Fund",
  "CLONEKEYS": {
    "scheme_launch_date": "dummy.*regular_plan"
  },
  "DUPLICATE_MUTUAL_FUNDS": {},
  "IMP_DATA": {
    "amc_name": "PGIM India Asset Management Private Limited",
    "mutual_fund_name": "PGIM India Mutual Fund"
  },
  "MAIN_MAP": {
    "map": true,
    "select": true,
    "special": true
  },
  "MERGEKEYS": {
    "metrics": [
      ".*aum_as_on"
    ]
  },
  "PARAMS": {
    "clip_bbox": [
      [
        0,
        115,
        210,
        812
      ],
      [
        0,
        680,
        570,
        812
      ]
    ],
    "content_size": [
      30,
      10
    ],
    "data": {
      "color": [
        -1
      ],
      "font": [
        "PrudentialModern-Bold"
      ],
      "size": [
        6,
        12
      ],
      "update_size": 30
    },
    "line_side": "",
    "line_x": 210,
    "max_financial_index_highlight": 7,
    "method": "clip",
    "pdf_ocr": false,
    "sanitize_fund": true,
    "stop_words": [],
    "title": {
      "bbox": [
        0,
        0,
        300,
        80
      ],
      "ocr": false,
      "pattern": "([A-Z0-9\\s\\-]+\\s*PGIM INDIA)"
    },
    "update_min_add": true
  },
  "PATTERN_TO_FUNCTION": {
    "^(before)": [
      "_extract_scheme_data",
      "scheme"
    ],
    "^(dummy.*)": [
      "_extract_scheme_data",
      "scheme2"
    ]
  },
  "PRE_DATA_SELECT": [
    "fund_details",
    "^regular_plan_and_direct_plan.*",
    "for_subscription_as_*"
  ],
  "PROMOTE_KEYS": {},
  "REGEX": {
    "aum": ".*Monthly Average AUM.*?([\\d,.]+)$",
    "benchmark": "((?:Nifty|BSE|NYSE|Domestic|CRISIL).+?(?:Gold|Silver|TRI|Index))",
    "date": "(\\d+\\/\\d+\\/\\d{3,4})",
    "escape": "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\/\\:]+",
    "load": "Entry Load(.+)Exit Load(.+)$",
    "manager": {
      "fields": [
        "since",
        "name",
        "exp"
      ],
      "pattern": "(?:\\(w\\.e\\.f\\.?\\s*(.*?)\\)?)?\\s*(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s*(?:\\(.+?\\))?\\s*\\(.*?([0-9]+ years) of experience.*?\\)"
    },
    "metrics": "(Portfolio Turnover|Standard Deviation of Fund|Beta|Sharpe Ratio| Average Maturity|Modified Duration|Macaulay Duration|Portfolio Yield).*?\\s*(-?[\\d.,]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]e?a?rs|%)?)",
    "min_amt": "([\\d,.]+)\\s*\\/?\\s*\\-?\\s*and in multiples of\\s*([\\d,.]+)\\s*\\/?\\s*\\-?\\s*thereafter\\.?",
    "scheme": [
      "Investment Objective",
      "Fund Manager",
      "Benchmark",
      "Option",
      "Quarterly.+?Average AUM",
      "Monthly\\s*[aA]verage AUM",
      "AUM as on",
      "NAV",
      "Load Structure",
      "IDCW\\s*History",
      "EOL"
    ],
    "scheme2": [
      "Regular Plan",
      "Direct Plan",
      "EOL",
      "Application Amount",
      "Additional Purchase",
      "SIP",
      "EOL"
    ]
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*aum_as_on$": [
      "_extract_generic_data",
      "metrics"
    ],
    ".*fund_manager": [
      "_extract_manager_data",
      "manager"
    ],
    ".*inception_date": [
      "_extract_generic_data",
      "date"
    ],
    ".*load_structure": [
      "_extract_load_data",
      "load"
    ],
    "^for_subscription.*": [
      "_extract_amt_data",
      "min_amt"
    ],
    "regular_plan.*(application_amount|additional_purchase)$": [
      "_extract_amt_data",
      "min_amt"
    ]
  },
  "SELECTKEYS": [
    ".*(additional_purchase|application_amount)$",
    ".*(fund_manager|average_aum|benchmark)",
    ".*load_structure",
    "amc_name",
    "metrics",
    "main_scheme_name",
    "mutual_fund_name",
    "page_number",
    "monthly_aaum_date",
    "scheme_launch_date"
  ],
  "SPECIAL_FUNCTIONS": {},
  "TERTIARY_PATTERN_TO_FUNCTION": {},
  "Z_MUTUAL_FUND_DATA": {
