{
  AMC_NAME: "Zerodha Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Zerodha Asset Management Private Limited",
    mutual_fund_name: "Zerodha Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Zerodha.+?(?:Funds?|ETF|Index|Path)\\s*(?:Fo?O?F|of Funds?)?)",
      bbox: [0, 60, 500, 180],
    },
    clip_bbox: [
      [0, 120, 300, 700],
      [300, 120, 600, 700],
    ],
    line_x: 340.0,
    data: {
      size: [14, 20],
      color: [-16777216],
      update_size: 30.0,
      font: ["Unnamed-T3"],
    },
    content_size: [30.0, 14.0],
    method: "clip",
    line_side: "both",
    max_financial_index_highlight: 4,
    pdf_ocr: true,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    scheme: [
      "Allotment Date|Launched",
      "Min\\.? Investment",
      "Expense Ratio",
      "Exit Load",
      "Benchmark",
      "Expense Ratio",
      "NAV",
      "Month end AUM",
      "Monthly average AUM",
      "Quarterly average AUM",
      "EOL",
      "Fund Managers?|Gold ETF|Returns Index",
      "Qualitative Data",
      "EOL",
    ],
    aum: "(.+?Cr)",
    benchmark: "(.+?)\\s*NAV",
    min_amt: "([\\d,]+).*?(\\d*)",
    metrics: "(Portfolio Turnover Ratio|Average Maturity|Macaulay Duration|Tracking Error)\\s*([\\d,.]+)",
    escape: "[^A-Za-z0-9\\s\\(\\),\\-\\.\\+\\%]+|\u2028",
    manager: {
      pattern: "(.+?)\\s*Total experience (\\d+ years) (?:Co-)?Managing.+?since ([A-Za-z]+\\s*[0-9]+)",
      fields: ["name", "exp", "since"],
    },
  },
  PATTERN_TO_FUNCTION: {
    before: ["_extract_scheme_data", "scheme"],
    "^dummy.*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*qualitative_data": ["_extract_generic_data", "metrics"],
    ".*min_investment": ["_extract_amt_data", "min_amt"],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
    ".*(fund_manager|returns_index|gold_etf)": [
      "_extract_manager_data",
      "manager",
    ],
    ".*monthly_average_aum": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
    "metrics",
    ".*qualitative_data",
    ".*fund_managers?",
    ".*monthly_average_aum",
    "load",
    ".*(exit_load|benchmark|min_investment)",
    ".*(allotment_date|launched)",
  ],
  MERGEKEYS: { load: [".*exit_load"] },
  CLONEKEYS: { fund_manager: ".*(gold_etf|returns_index)" },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
