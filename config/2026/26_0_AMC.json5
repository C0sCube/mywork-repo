{AMC_NAME: "Mahindra Manulife Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Mahindra Manulife Investment Management Private Limited", mutual_fund_name: "Mahindra Manulife Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Mahindra\\s*Manulife.*?(?:Funds?|ETF|EOF|F[Oo]F|Plan|Path|Saver|Index|Growth)\\s*(?:F[Oo]F|of Funds?|Fund of Funds?|Funds?)?)", bbox: [170, 0, 500, 80]}, clip_bbox: [[0, 65, 200, 812]], line_x: 200.0, data: {size: [7, 10], color: [-1], update_size: 30.0, font: ["QuantumRise-Bold", "QuantumRise", "QuantumRise-Semibold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: ["experience"], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {benchmark: "(?:Nifty|BSE|FTSE|CRISIL|Domestic).+?(?:TRI|Gold|Silver|Index\\s*(?:TRI)?)", manager: {pattern: "(?:Ms\\.?|Mrs\\.?|Mr\\.?)\\s*([\\w\\s]+?)(?:\\s*\\(.*?\\))?\\s+Total Experience\\s*\\:?\\s+([0-9]+(?:\\s+years)?)?\\s*Experience in managing this fund(.+?(?:months?|years?))\\s*\\(.*?Managing since\\s+([^)]+)\\)", fields: ["name", "exp", "desig", "since"]}, scheme: ["Investment Objective", "Fund Features", "Fund Manager", "Portfolio Stats", "Date of allotment", "Benchmark", "Option", "Minimum Application Amount", "Minimum Additional Purchase Amount", "Minimum Repurchase Amount", "Monthly AAUM", "Quarterly AAUM", "Monthly AUM", "Total Expense Ratio", "Load Structure", "Portfolio Information", "NAV", "EOL", "Minimum Application\\s*\\/?\\s*Additional Purchase", "Minimum Amount for Switch", "EOL"], aum: ".+?in cr\\D*?(\\d+,?\\d+.\\d+)", load: "Entry Load\\s*(.+?)\\s*Exit Load\\s*(.+)$", min_amt: "Rs\\.?\\s*([\\d,]+)(?:-)?\\D+R[es]?\\.?\\s*([\\d,]+)", metrics: "(Modif?i?ed Duration|Residual Maturity|Macaulay Duration|Annualised\\s*Portfolio YTM\\s*2?|Portfolio Turnover Ratio\\s*\\(.*?\\)|Standard Deviation|Treynor|Beta|Sharpe Ratio|Alpha)\\s*\\:?\\s*(-?[\\d,\\.]+\\s*(?:[Yy]ears?|[Dd]ays?|[Mm]onths?|%)?)", escape: "[^A-Za-z0-9\\s\\(\\)\\,\\-\\.\\/\\+\\%\\:]+"}, PATTERN_TO_FUNCTION: {"^before.*": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*load": ["_extract_load_data", "load"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*monthly_aaum$": ["_extract_generic_data", "aum"], ".*(minimum_application.*|minimum_additional_purchase_amount)": ["_extract_amt_data", "min_amt"], ".*(portfolio_information|portfolio_stats)": ["_extract_generic_data", "metrics"], ".*benchmark": ["_extract_generic_data", "benchmark"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*(date_of_allotment|benchmark|load_structure)", ".*(application_amount|additional_purchase_amount)$", ".*minimum_application.+?purchase$", "amc_name", ".*fund_manager", "fund_manager", "main_scheme_name", ".*(portfolio_stats|portfolio_information)$", "metrics", "monthly_aaum_date", ".*monthly_aaum$", "monthly_aaum_value", "page_number", "mutual_fund_name"], MERGEKEYS: {metrics: [".*portfolio_stats", ".*portfolio_information"]}, CLONEKEYS: {minimum_additional_application_amount: "minimum_application.+?purchase$", minimum_application_amount: "minimum_application.+?purchase$"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}, Z_MUTUAL_FUND_DATA: {}}