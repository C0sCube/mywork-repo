{
  AMC_NAME: "Bajaj Life Insurance Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Bajaj Life Insurance AMC Limited",
    mutual_fund_name: "Bajaj Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Group.+?Fund\\s*[I]{0,3})",
      bbox: [0, 45, 300, 115],
    },
    clip_bbox: [[291.5, 42.14, 590.89, 471.48]],
    port_bbox: [
      {
        bbox: [0, 147.0, 300, 835],
        support_lines: [50, 270],
        anchor_t: "Company/Issuer",
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
        anchor: {
          anchor_t: "Company/Issuer",
          anchor_b: null,
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    data: {
      size: [6, 15],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 15.0],
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    method:"clip"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+)\\s*[Ee]quity",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Fund\\s*[dD]etails",
      "SFIN\\s*[nN]umber",
      "Launch\\s*[dD]ate",
      "Face\\s*[vV]alue",
      "Benchmark",
      "Fund Manager",
      "Number\\s*[Oo]f\\s*[Ff]unds",
      "NAV\\s*[Aa]s\\s*[Oo]n",
      "AUM",
      "Lumpsum Investment",
      "EOL",
    ],
    manager: {
      pattern: "([A-Za-z]+\\s*[A-Za-z]+)\\s*(?:\\(.+?\\))?\\s*(?:Nearly|Over)\\s*(\\d{1,2}\\s*[Yy]ears?)",
      fields: ["name", "exp"],
    },
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*aum$": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin|benchmark|launch_date)",
    ".*fund_manager",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*aum$",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
