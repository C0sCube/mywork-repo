        587,
        970,
      ],
    ],
    port_bbox: [
      {
        bbox: [
          290,
          320,
          587,
          970,
        ],
        support_lines: [
          535,
        ],
        anchor_t: "Security Name",
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
        anchor: {
          anchor_t: "Security Name",
          anchor_b: null,
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    data: {
      size: [
        6,
        20,
      ],
      color: [
        23,
      ],
      update_size: 30.0,
      font: [
        "Ubuntu-Bold",
      ],
    },
    content_size: [
      30.0,
      20.0,
    ],
    max_financial_index_highlight: 4,
    pdf_ocr: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "(\\d+\\,?\\d+\\.\\d+)",
    date: "\\d{2}-[A-Za-z]+-\\d{2}",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Objective",
      "ASSET\\s+ALLOCATION",
      "AUM\\s+\\(Rs",
      "NAV\\s+\\(Per",
      "Fund\\s+Management\\s+Charge",
      "Inception\\s+Date",
      "Fund\\s+Managers?",
      "Benchmark",
      "EOL",
      "FUND\\s+PROFILE",
      "EOL",
    ],
    metric: "(Beta|Yield\\s+[tT]o\\s+Maturity|Average\\s+Maturity|Modified\\s+Duration)\\s+(?:\\(.+\\))?\\s+([\\d,.]+\\s+%)",
    manager: {
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)",
      fields: [
        "name",
      ],
    },
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": [
      "_extract_scheme_data",
      "scheme",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_manager": [
      "_extract_manager_data",
      "manager",
    ],
    ".*aum_rs": [
      "_extract_generic_data",
      "aum",
    ],
    ".*fund_profile": [
      "_extract_generic_data",
      "metric",
    ],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin|date_of_inception|inception_date)",
    ".*fund_manager",
    "metric",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*aum_rs",
    metric: ".*fund_profile",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}