{
  AMC_NAME: "Axis Max Life Insurance Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Axis Max Life Insurance AMC Limited",
    mutual_fund_name: "Axis Max Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(^.+$)",
      bbox: [5.01, 74.08, 582.61, 127.13],
    },
    clip_bbox: [
      [0, 80, 295, 900],
    ],
    port_bbox: [
      {
        bbox: [290, 80, 585, 925],
        support_lines: [470,570],
        anchor_t: null,
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
      },
    ],
    line_x: 200.0,
    data: {
      size: [6, 20],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 20.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum:  "Rs.\\s*([\\d,.]+)",
    date:"\\d{2}-[A-Za-z]+-\\d{2}",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Objective",
      "ASSET\\s+ALLOCATION",
      "AUM\\s+(Rs",
      "Date of Inception",
      "AUM",
      "crore",
      "Equity",
      "Targeted Asset Allocation",
      "Quantitative Indicators",
      "EOL",
    ],
    metric:{
      key:"(Std\\s+Dev|Sharpe\\s+Ratio|Portfolio\\s+Beta)",
      value:"([\\d.]+\\s*(?:%)?)"
    },
    manager: {
      pattern: "([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*crore":["_extract_manager_data", "manager"],
    "before.aum$":["_extract_generic_data", "aum"],
    ".*date_of_inception":["_extract_generic_data", "date"],
    ".*quantitative_indicators":["_extract_metric_data", "metric"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin|date_of_inception)",
    ".*fund_manager",
    "metric",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*aum$",
    fund_manager: ".*crore",
    metric:".*quantitative_indicators"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
