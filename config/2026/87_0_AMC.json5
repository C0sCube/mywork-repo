    amc_name: "Axis Max Life Insurance AMC Limited",
    mutual_fund_name: "Axis Max Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(^.+)ULI",
      bbox: [
        5.01,
        74.08,
        582.61,
        127.13,
      ],
    },
    clip_bbox: [
      [
        0,
        0,
        295,
        320,
      ],
      [
        290,
