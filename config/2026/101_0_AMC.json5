{
  AMC_NAME: "Choice Mutual Fund",
  CLONEKEYS: {},
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Choice AMC Private Limited",
    mutual_fund_name: "Choice Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    metrics: [".*tracking_error", ".*portfolio_turnover"],
    load: [".*load_structure"],
  },
  PARAMS: {
    clip_bbox: [
      [0, 150, 300, 850],
      [240, 90, 590, 850],
    ],
    content_size: [30, 17],
    data: {
      color: [0],
      font: ["Swiss721BT-Bold"],
      size: [8, 18],
      update_size: 30,
    },
    line_side: "",
    line_x: 590,
    max_financial_index_highlight: 7,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0.0, 470, 140],
      ocr: false,
      pattern: "((?:Choice|CHOICE).+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^before.*": ["_extract_scheme_data", "scheme"],
    "^dummy.*": ["_extract_scheme_data", "scheme2"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)",
    date: "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)",
    load: "Entry Load (.*?)Exit load (.*)$",
    manager: {
      fields: ["name", "since", "exp"],
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)\\s*\\(.+?since([A-Za-z0-9\\s\\,]+)\\).+?more than (\\d+ [Yy]ears?)",
    },
    metrics: "(Yield to Maturity|Actual Duration|Macaulay Duration|Yield\\s*to|average maturity|Modified Duration|Tracking\\s*Error|Portfolio\\s*Turnover\\s*Ratio)(?:\\(.+?\\))?\\s*\\-?\\:?\\s*((?:\\([Dd]ays?\\)|\\([Mm]onths?\\)|\\([Yy]ears?\\)|%)?\\s*-?\\d+\\.?\\d*\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)",
    min_amt: "([\\d,]+).*?(\\d+|any)",
    scheme: [
      "Type of Scheme",
      "Investment Objective",
      "Date of Allotment",
      "Fund Manager",
      "Average AUM",
      "AUM as on",
      "NAV as on",
      "Load Structure",
      "Benchmark",
      "Total Expense Ratio",
      "EOL",
    ],
    scheme2: [
      "Portfolio Turnover",
      "Dividend History",
      "Tracking Error as on",
      "Exchange Listed",
      "EOL",
    ],
    decimal: "(\\d+\\.\\d+)",
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    // ".*(minimum_additional|minimum_investment)": [
    //   "_extract_amt_data",
    //   "min_amt",
    // ],
    ".*(tracking_error|portfolio_turnover)": [
      "_extract_generic_data",
      "decimal",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*load_structure": ["_extract_load_data", "load"],
  },
  SELECTKEYS: [
    "load",
    "metrics",
    ".*fund_manager",
    ".*(inception_date|date_of_allotment)$",
    ".*benchmark",
    ".*average_aum$",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
}
