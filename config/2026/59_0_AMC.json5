{
  "AMC_NAME": "Bajaj Finserv Mutual Fund",
  "CLONEKEYS": {
    "benchmark_index": ".*date_of_allotment",
    "scheme_launch_date": ".*date_of_allotment"
  },
  "DUPLICATE_MUTUAL_FUNDS": {},
  "IMP_DATA": {
    "amc_name": "Bajaj Finserv Asset Management Limited",
    "mutual_fund_name": "BajaJ Finserv Mutual Fund"
  },
  "MAIN_MAP": {
    "map": true,
    "select": true,
    "special": true
  },
  "MERGEKEYS": {
    "load": [
      ".*entry_load",
      ".*exit_load"
    ],
    "metrics": [
      "metrics",
      "^other_parameters",
      "^metrics_.*"
    ]
  },
  "PARAMS": {
    "clip_bbox": [
      [
        0,
        65,
        190,
        812
      ],
      [
        180,
        45,
        360,
        300
      ],
      [
        360,
        45,
        580,
        300
      ],
      [
        180,
        500,
        580,
        812
      ]
    ],
    "content_size": [
      30,
      10
    ],
    "data": {
      "color": [
        23
      ],
      "font": [
        "Rubik-SemiBold",
        "Rubik-Bold"
      ],
      "size": [
        6,
        12
      ],
      "update_size": 30
    },
    "line_side": "left",
    "line_x": 180,
    "max_financial_index_highlight": 7,
    "method": "both",
    "pdf_ocr": false,
    "sanitize_fund": false,
    "stop_words": [],
    "table": "11-14",
    "title": {
      "bbox": [
        0,
        0,
        470,
        50
      ],
      "ocr": false,
      "pattern": "(Bajaj.*?(?:Fund|Path|ETF|FOF|EOF)\\s*(?:FO?o?F|of Fund|-\\s*Growth)?)"
    },
    "update_min_add": false
  },
  "PATTERN_TO_FUNCTION": {
    "^(before|dummy.*)": [
      "_extract_scheme_non_esc_data",
      "scheme"
    ]
  },
  "PRE_DATA_SELECT": [],
  "PROMOTE_KEYS": {},
  "REGEX": {
    "aum": "(\\d+\\,?\\d+\\.\\d+)",
    "benchmark": "((?:BSE|NSE|NYSE|Nifty|Domestic).+?(?:Gold|Silver|TRI|Index|Total Return Index))",
    "date": "(.+?)BENCHMARK",
    "escape": "[^a-zA-Z0-9.,\\s\\-\\(\\)\\+\\%]+|’",
    "manager": {
      "fields": [
        "name",
        "desig",
        "since",
        "exp"
      ],
      "pattern": "(?:Mr\\.?|Ms\\.?|Mrs\\.?)?\\s*([\\w\\s]+)\\s*(?:\\(([\\w\\s]+)\\))?\\s*\\(Managing fund\\s*since\\s*([\\w\\s\\d]+|inception)\\s*Overall experience.+?(\\d+ years)\\)"
    },
    "metrics": "(Tracking\\s*[Ee]rror|Sharpe\\s*ratio|Standard\\s*deviation|Information ratio|Jensen.+?Alpha|Beta|Average Maturity|Modi.*?ed Duration|Macaulay Duration|Yield to Maturity|YTM)\\s*(\\-?[\\d,.]+\\s*\\(?\\s*(?:\\s*in\\s*[Dd]ays?|.*?[Mm]onths?|.*?[Yy]ears?|.*?[Tt]imes?|%)?\\s*\\)?)",
    "min_amt": "([\\d,]+).*?([\\d,]+)",
    "scheme": [
      "INVESTMENT OBJECTIVE",
      "SCHEME DETAILS",
      "Scheme Category",
      "Options",
      "Minimum Investment Amount",
      "Minimum Additional Investment Amount",
      "Entry Load",
      "Exit Load",
      "TOTAL EXPENSE RATIO",
      "EOL",
      "Month end AUM",
      "AAUM",
      "DATE\\s*OF\\s*ALLOTMENT",
      "PORTFOLIO",
      "EOL",
      "FUND MANAGER",
      "EOL",
      "Portfolio Turnover\\s*\\(Times\\)",
      "EOL"
    ]
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*(minimum|additional)_investment": [
      "_extract_amt_data",
      "min_amt"
    ],
    ".*(month_end_aum|aaum$)": [
      "_extract_generic_data",
      "aum"
    ],
    ".*fund_manager": [
      "_extract_manager_data",
      "manager"
    ],
    "^(metrics|other_parameters)": [
      "_extract_generic_data",
      "metrics"
    ]
  },
  "SELECTKEYS": [
    ".*(minimum|additional).*",
    "load",
    "benchmark_index",
    ".*aaum",
    "scheme_launch_date",
    ".*fund_manager",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "metrics"
  ],
  "SPECIAL_FUNCTIONS": {
    "benchmark_index": "_update_bench_data",
    "scheme_launch_date": "_update_date_data"
  },
  "TERTIARY_PATTERN_TO_FUNCTION": {},
  "Z_MUTUAL_FUND_DATA": {}
}