{
  AMC_NAME: "Generali Central Life Insurance Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Generali Central Life Insurance AMC Limited",
    mutual_fund_name: "Generali Central Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "FUTURE.+?FUND",
      bbox: [100, 0, 470, 85],
    },
    clip_bbox: [
      [0, 65, 185, 700],
      [370, 5, 600, 95],
    ],
    port_bbox: [
      {
        bbox: [183.46, 4.1, 430.81, 791.18],
        support_lines: [104.02, 279.29],
        anchor_t: "PORTFOLIO AS ON",
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
        anchor: {
          anchor_t: "PORTFOLIO AS ON",
          anchor_b: null,
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    data: {
      size: [6, 15],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 15.0],
    max_financial_index_highlight: 3,
    pdf_ocr: false,
    method:"clip"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "\\d+\\.\\d+\\s*([\\d,.]+)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "OBJECTIVE",
      "Fund\\s*Manager\\s*Details",
      "Equity\\s*Debt\\s*Hybrid",
      "ASSET\\s*ALLOCATION",
      "RISK RETURN PROFILE",
      "DATE\\s*OF\\s*INCEPTION",
      "FUND\\s*PERFORMANCE",
      "AUM\\s*as\\s*on",
      "NAV\\s*AUM\\s*\\(?\\s*In\\s*Lakhs?\\)?",
      "ASSET ALLOCATION",
      "EOL",
      "SFIN\\s*No.?",
      "EOL",
    ],
    manager: {
      pattern: "([A-Z]{1}[a-z]+\\s*[A-Z]{1}[a-z]+)",
      fields: ["name"],
    },
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*equity_debt_hybrid": ["_extract_manager_data", "manager"],
    ".*nav_aum_in_lakhs": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin|date_of_inception)",
    ".*fund_manager",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*nav_aum_in_lakhs$",
    fund_manager: ".*equity_debt_hybrid$",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
