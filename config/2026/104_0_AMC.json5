{
  AMC_NAME: "Altiva SIF",
  CLONEKEYS: {
    fund_manager: ".*nav_inr",
    monthly_aaum_value: ".*monthly_avg",
    exit_load: ".*plan.+?options",
    scheme_launch_date: ".*min_investment",
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Edelweiss Asset Management Limited",
    mutual_fund_name: "Altiva SIF",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
  },
  PARAMS: {
    clip_bbox: [[0, 60, 800, 840]],
    content_size: [30, 14],
    data: {
      color: [-1],
      font: ["Calibri,Bold", "Inter-Bold"],
      size: [7, 20],
      update_size: 30,
    },
    line_side: "",
    line_x: 175,
    max_financial_index_highlight: 5,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 305, 590, 570],
      ocr: false,
      pattern: "((?:Altiva).*?(?:FUNDS?|Funds?|ETF|Index|Plan|Path)\\s*(?:of [Ff]unds?|F[oO]F|Funds?|Fund of [Ff]unds?)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^before": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]r?)",
    date: "(\\d{1,2}\\s*(?:th|st|rd|nd)?\\s*[A-Za-z]+\\s*\\d{4})",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
    load: "Entry(.+?)Exit(.+?)\\s*(?=NAV Details|BENCHMARK INDEX|$)",
    manager: {
      fields: ["name","exp"],
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)",
      name: "(?:Mr|Mrs|Ms)\\.?\\s*([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d+\\s*[Yy]ears?)",
      since:"(\\d{1,2}\\s*(?:Oct|Nov|Dec|Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep)?)"
    },
    metrics: "(Sharpe\\s*Ratio|Sortino\\s*Ratio|Jensen\\s*s?\\s*Alpha|R-?\\s*Squared|Downside\\s*Deviation|Upside\\s*Deviation|Average Maturity| Modified Duration|Macaulay Duration|Yield to Maturity)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)",
    min_amt: "([\\d,]+\\s*Lakh)\\s*()",
    scheme: [
      "Investment\\s*[Oo]bjective",
      "Benchmark",
      "Category\\s*[Oo]f\\s*[Ii]nvestment\\s*[Ss]trategy",
      "Type\\s*[Oo]f\\s*[Ii]nvestment\\s*[Ss]trategy",
      "NAV.+?INR",
      "Plan.+?Options",
      "Min\\s*[Aa]pplication\\s*[Aa]mount",
      "Min\\s*[Ii]nvestment",
      "Expense\\s*Ratio",
      "AUM",
      "Monthly Avg",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(subsequent_investment|application_amount)$": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*nav_inr": ["_update_manager_data", null],
    ".*monthly_avg": ["_extract_generic_data", "aum"],
    ".*min_investment$": ["_extract_generic_data", "date"],
    // ".*nav_inr":["_extract_manager_data","manager"],
    ".*risk_adjusted_measures": ["_extract_generic_data", "metrics"],
  },
  SELECTKEYS: [
    "amc_name",
    "main_scheme_name",
    "mutual_fund_name",
    "page_number",
    "monthly_aaum_date",
    ".*(application_amount|benchmark|inception_date)",
    "scheme_launch_date",
    "monthly_aaum_value",
    "fund_manager",
    "load",
    ".*risk.*measures$",
    ".*fund_size",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
