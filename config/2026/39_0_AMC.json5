{AMC_NAME: "Taurus Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Taurus Asset Management Company Limited", mutual_fund_name: "Taurus Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "((?:TAURUS|Taurus).+?(?:FUNDs?|Funds?|ETF|Path|.+?Plan|F[oO]F|Saver)\\s*(?:Funds?|of Funds?|Fund of Funds?|F[oO]F|.+?Plan)?)", bbox: [0, 0, 480, 40]}, clip_bbox: [[0, 65, 210, 812]], line_x: 210.0, data: {size: [6, 12], color: [-1], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: [], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(Monthly Average AUM)\\s*([\\d,.]+\\s*Cr)", scheme: ["Investment Objec.*?ve", "Fund Manager", "Date of Allotment", "Benchmark", "Monthly AUM", "Monthly Average AUM", "Month End AUM", "Entry Load", "Exit Load", "Minimum Applica.*?on Amount", "Net Asset Value", "Quan.*?ta.*?ve Data", "DIVIDEND HISTORY", "EOL"], min_amt: "([\\d,]+).*?([\\d,]+)", manager: {pattern: "(?:Mr|Mrs|Ms)?\\.?([A-Za-z\\s]+)\\(w.e.f.?(.+?)\\)\\s*Total work experience\\s*(\\d+\\s*[Yy]rs)", fields: ["name", "since", "exp"]}, load: "Entry Load\\s*(.*?)\\s*Exit Load\\s*(.*)$", metric: "(Por.+?olio Turnover|Standard Devia.+?on|Modified Duration|Annualised Yield|Macaulay Duration|Tracking Error|Sharpe Ra.+?o|Beta|R Squared|Treynor)\\s*(-?[\\d,.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%)?)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\u00b7"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*minimum.+?amount": ["_extract_amt_data", "min_amt"], "(^metric|.*quan.+?ata)": ["_extract_generic_data", "metric"], ".*fund_manag.*": ["_extract_manager_data", "manager"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*date_of_allotment", ".*fund_manager", ".*benchmark", ".*monthly_average_aum$", "monthly_aaum_date", "mutual_fund_na