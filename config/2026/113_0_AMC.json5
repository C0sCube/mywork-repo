{
  AMC_NAME: "Sapphire SIF",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Franklin Templeton Asset Management (India) Pvt. Ltd.",
    mutual_fund_name: "Sapphire SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "Sapphire.+?SIF",
      bbox: [0, 0, 420, 85],
    },
    clip_bbox: [[0, 80, 175, 840]],
    line_x: 200.0,
    data: {
      size: [6, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "SCHEME\\s+CATEGORY",
      "SCHEME\\s+CHARACTERISTICS",
      "INVESTMENT\\s+OBJECTIVE",
      "DATE\\s+OF\\s+ALLOTMENT",
      "FUND\\s+MANAGER",
      "BENCHMARK",
      "NAV\\s+AS\\s+OF\\s+MAY",
      "Month\\s+End",
      "Monthly\\s+Average",
      "TURNOVER",
      "BASE\\s+EXPENSE\\s+RATIO",
      "MINIMUM\\s+INVESTMENT",
      "ADDITIONAL\\s+INVESTMENT",
      "ENTRY\\s+LOAD",
      "EXIT\\s+LOAD",
      "EOL"
    ],
    manager: {
      pattern: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(dummy.*|before)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(additional_investment|minimum_investment.*)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*date_of_allotment",
    ".*fund_manager",
    // "metrics",
    ".*benchmark",
    ".*(additional_investment|minimum_investment)",
    ".*monthly_average",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
