{
  AMC_NAME: "Invesco Asset Management (India) Private Limited",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Invesco Asset Management (India) Private Limited",
    mutual_fund_name: "Summit SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(?:Summit|SUMMIT)\\s*.+?(?:FUND|Fund)",
      bbox: [200, 0, 590, 90],
    },
    clip_bbox: [[0, 70, 200, 835]],
    line_x: 200.0,
    data: {
      size: [3, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*crores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Investment Objective",
      "Load Structure",
      "Exit Load:?",
      "Minimum Investment:?",
      "Additional Purchase:?",
      "Date of Allotment:?",
      "NAV.+?as on",
      "Benchmark Index",
      "AA[uU]M\\s+for\\s+the\\s+month",
      "A[uU]M as on",
      "Fund Manager",
      "EOL",
    ],
    min_amt: "(Rs.\\s+[\\d,]+).*?(\\d+|any)\\s*thereafter",
    manager: {
      pattern: "([A-Za-z]+\\s*[A-Za-z]+)\\s+Total\\s+Experience\\s+(\\d+\\s+Years?)\\s+.+?since\\s+([A-Za-z]+\\s+\\d{2},?\\s+\\d{4})",
      fields: ["name","exp","since"],
    },
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+|\\(Annualized\\)|\u00b7",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_investment|additional)": ["_extract_amt_data", "min_amt"],
    ".*(expense_ratio)": ["_extract_generic_data", "metric"],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
    ".*(aaum)": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*inception_date",
    ".*fund_manager",
    "metrics",
    ".*benchmark",
    ".*minimum_investment",
    ".*monthly_avg_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*exit_load"],
    metrics: ["metrics", ".*(expense_ratio)"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
