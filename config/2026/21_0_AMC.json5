{
  "AMC_NAME": "Invesco Mutual Fund",
  "MAIN_MAP": {
    "select": true,
    "map": true,
    "special": true
  },
  "IMP_DATA": {
    "amc_name": "Invesco Asset Management (India) Private Limited",
    "mutual_fund_name": "Invesco Mutual Fund"
  },
  "PARAMS": {
    "title": {
      "ocr": false,
      "pattern": "(Invesco India.*?(?:Fund\\s*(?:of Funds?)?|ETF\\s*(?:Fund of F?f?unds?)?|FOF|Path))",
      "bbox": [
        180,
        0,
        590,
        40
      ]
    },
    "clip_bbox": [
      [
        0,
        135,
        185,
        812
      ]
    ],
    "line_x": 180.0,
    "data": {
      "size": [
        7,
        9
      ],
      "color": [
        -1
      ],
      "update_size": 30.0,
      "font": [
        "Graphik-Semibold"
      ]
    },
    "content_size": [
      30.0,
      10.0
    ],
    "method": "clip",
    "line_side": "",
    "max_financial_index_highlight": 5,
    "pdf_ocr": false,
    "sanitize_fund": false,
    "stop_words": [],
    "update_min_add": false
  },
  "DUPLICATE_MUTUAL_FUNDS": {},
  "PRE_DATA_SELECT": [],
  "REGEX": {
    "load": "(?:Entry Load)?(.*?)\\s*Exit Load\\s*(.+)$",
    "min_amt": "([\\d,]+).*?([\\d,]+)",
    "ptr": "([\\d.]+)\\s*weighted.*",
    "aum": "([\\d,.]+\\s*crores?)",
    "scheme": [
      "Investment Objective",
      "Load Structure",
      "Exit Load",
      "Minimum Investment",
      "Additional Purchase",
      "Date of Allotment",
      "NAV",
      "Portfolio Turnover Ratio",
      "Benchmark Index",
      "AAu?U?M for the month",
      "Au?U?M as on",
      "Fund Manager",
      "Asset Allocation",
      "Performance Attributes",
      "EOL",
      "Maturity Profile",
      "EOL"
    ],
    "manager": {
      "pattern": "(?P<name>[A-Za-z\\s]+)\\s*(?:\\([A-Za-z\\s]+\\))?\\s+Total Experience\\s+(?P<experience>\\d+ years?).*?\\s*Experience in managing this fund.*?\\s*Since\\s+(?P<managing_since>[A-Za-z]+\\s*[0-9]+,?\\s*[0-9]+)",
      "fields": [
        "name",
        "exp",
        "since"
      ]
    },
    "metrics": "(YTM\\d+|Modified Duration|Macaulay Duration|Average Maturity|Standard Deviation|Beta|Sharpe Ratio|Fund\\s*P\\s*E.+?E\\s*\\d+?|Fund P\\s*B|Modified Duration)\\s*\\:?\\s*([\\d,]+\\.?\\d*\\s*(?:[Dd]ays|[Mm]onths|[Yy]ears|%|times?)?)",
    "escape": "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+"
  },
  "PATTERN_TO_FUNCTION": {
    "before": [
      "_extract_scheme_data",
      "scheme"
    ]
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*aaum_for_the_month$": [
      "_extract_generic_data",
      "aum"
    ],
    ".*(minimum_investment|additional_purchase)": [
      "_extract_amt_data",
      "min_amt"
    ],
    ".*fund_manager": [
      "_extract_manager_data",
      "manager"
    ],
    ".*portfolio_turnover": [
      "_extract_generic_data",
      "ptr"
    ],
    ".*(performance_attributes|maturity_profile|asset_allocation)": [
      "_extract_generic_data",
      "metrics"
    ]
  },
  "TERTIARY_PATTERN_TO_FUNCTION": {},
  "SELECTKEYS": [
    "load",
    ".*(minimum_investment|additional_purchase)",
    ".*date_of_allotment",
    ".*benchmark_index",
    ".*aaum_for_the_month$",
    ".*fund_manager",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name"
  ],
  "MERGEKEYS": {
    "metrics": [
      ".*performance_attributes",
      ".*portfolio_turnover.*",
      ".*asset_alloc.*",
      ".*maturity_profile"
    ],
    "load": [
      ".*exit_load"
    ]
  },
  "CLONEKEYS": {},
  "PROMOTE_KEYS": {},
  "SPECIAL_FUNCTIONS": {},
  "Z_MUTUAL_FUND_DATA": {}
}