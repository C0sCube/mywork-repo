{
  AMC_NAME: "Motilal Oswal Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Motilal Oswal Asset Management Company Limited",
    mutual_fund_name: "Motilal Oswal Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Motilal.*?(?:Fund\\s*(?:o?O?f Funds?(?:.+?Aggressive|.+?Conservative)?)?|ETF(?:.+? of Funds?)?|FoF))",
      bbox: [0, 0, 600, 60],
    },
    clip_bbox: [
      [0, 65, 170, 812],
      [370, 265, 700, 812],
    ],
    line_x: 170.0,
    data: {
      size: [7, 14],
      color: [-1],
      update_size: 30.0,
      font: ["Calibri-Bold"],
    },
    content_size: [30.0, 15.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: ["category"],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    benchmark: "^(.*?)(?:\\s*Redemption\\b|\\b[lL]umpsum|$)",
    metric: "(Monthly AAUM|Information Ratio|Latest AUM|Beta|Portfolio Turnover Ratio|Standard Deviation|Sharpe Ratio|Average Maturity|YTM|Macaulay Duration|Modified Duration)\\s*(?:\\-|\\:)?\\s*(-?[\\d,.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|[Tt]imes?|[Yy]rs?|%)?)",
    load: "(?:Entry Load)?\\s*(Nil|\\S.*?)\\s*(?:Exit Load\\s*(Nil|\\S.*?))?$",
    lumpsum: "Minimum Application Amount(.+?)Minimum Additional Purchase(.+)$",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "\\d{2}\\-?[A-Za-z]+\\-?\\d{4}",
    aum: "([\\d,.]+)",
    scheme: [
      "Investment Objective",
      "Benchmark",
      "Minimum\\s*[Aa]pplication\\s*[Aa]mount",
      "Minimum\\s*[Aa]dditional\\s*[Pp]urchase\\s*[Aa]mount",
      "Entry\\s*Load",
      "Exit\\s*Load",
      "Allotment Date",
      "NAV",
      "Monthly AAUM",
      "Latest AUM",
      "Fund Manager",
      "Total Expenses Ratio",
      "EOL",
      "Total Expenses Ratio",
      "Quantitative Indicators",
      "EOL",
      "Fund Manager",
      "Quantitative Indicators",
      "Total Expenses Ratio",
      "EOL",
      "Monthly AAUM",
      "Latest AUM",
      "Quantitative Indicators",
      "EOL",
      "Benchmark",
      "Redemption\\s*P?p?roceeds",
    ],
    manager: {
      name: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d{1,2}\\+?\\s*[Yy]ears?)",
      since: "(\\d{1,2}\\-[A-Za-z]+\\-\\d{4}|Inception)",
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s*(?:Managing this|has managed this) fund since\\s*(\\d{1,2}\\-?[A-Za-z,]+\\-?\\d{3,4}|Inception).*?([0-9]+\\s*\\+\\s*years)",
      fields: ["name", "since", "exp"],
    },
    exit: ".+?Exit\\s*Load(.+)(?:NAV|Fund Manager|$)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(latest_aum|quantitative_indicators)": [
      "_extract_generic_data",
      "metric",
    ],
    ".*exit_load": ["_extract_generic_data", "exit"],
    ".*minimum.+?amount$": ["_extract_amt_data", "min_amt"],
    ".*monthly_aaum": ["_extract_generic_data", "aum"],
    "befo.+?benchmark": ["_extract_generic_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(minimum_application_amount|minimum_additional.+?amount)",
    "load",
    ".*allotment_date",
    "benchmark_index",
    "metrics",
    ".*fund_manager",
    "main_scheme_name",
    "amc_name",
    "page_number",
    "mutual_fund_name",
    "monthly_aaum_date",
    "check_monthly_aaum",
    ".*monthly_aaum$",
  ],
  MERGEKEYS: {
    load: [".*entry_load", ".*exit_load"],
    metrics: [".*latest_aum", ".*quantitative_indicators"],
  },
  CLONEKEYS: { benchmark_index: "befo.+?benchmark" },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { ".*fund_manager": "_update_manager_data" },
  Z_MUTUAL_FUND_DATA: {},
}
