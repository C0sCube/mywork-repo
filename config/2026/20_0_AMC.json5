{
  AMC_NAME: "Groww Mutual Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Groww Asset Management Limited",
    mutual_fund_name: "Groww Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(GROWW.*?(?:FUNDS?|Funds?|ETF|PLAN|PATH)\\s*(?:F[oO]F|FUND\\s+OF\\s+FUNDS?|OF\\s+FUNDS?|FUNDS?)?)",
      bbox: [0, 0, 465, 70],
    },
    clip_bbox: [
      [0.0, 111.51, 188.77, 307.3],
      [179.99, 110.63, 355.59, 310.8],
      [3.51, 225.65, 353.83, 831.46],
      [349.44, 107.99, 594.4, 834.1]
    ],
    line_x: 220.0,
    data: {
      size: [6, 10],
      color: [-1],
      update_size: 30.0,
      font: ["NunitoSans7pt-ExtraBold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "left",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "(Monthly Average AUM|Month end AUM)\\s*([\\d,.]+\\s*crore)",
    date: "\\(Date of Allotment\\)\\s*(.+)$",
    scheme: [
      "INVESTMENT OBJECTIVE",
      "DATE\\s+OF\\s+ALLOTMENT",
      "BENCHMARK",
      "PORTFOLIO\\s+TURNOVER",
      "PORTFOLIO\\s+DETAILS",
      "EOL",
      "Monthly\\s+Average",
      "Month\\s+End\\s+AUM",
      "EXPENSE\\s+RATIO",
      "EOL",
    ],
    scheme2: [
      "NAV\\s+[Oo]f\\s+Plans",
      "FUND\\s+MANAGER",
      "Sectoral\\s+Allocation",
      "ENTRY\\s+&\\s+EXIT",
      "Entry\\s+Load",
      "Exit\\s+Load",
      "EOL",
      "Maturity\\s+[Aa]nd\\s+Yield",
      "EOL"  
    ],
    min_amt: "([\\d,]+).*?([\\d,]+)",
    metrics: {
      key: "(Modi?\\s*(?:fi)?ed|Average\\s+Maturity|Macaulay|YTM)",
      value: "(-?[\\d\\.]+\\s*(?:[Dd]ays?|[Yy]ears?|[Mm]onths?|%|[Tt]imes?|%)?)",
    },
    "metric2":"(Deviation|Beta|Sharpe\\s+Ratio|R\\s+Square)\\s+(?:\\:|\\-)?\\s+(-?\\d+\\.?\\d+\\s*(?:[Dd]ays?|[Yy]ears?|[Mm]onths?|%|[Tt]imes?)?)",
    manager: {
      // pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+(?P<name>[A-Za-z\\s]+)(?:\\s*\\(.+?\\))?\\s*\\(Managing\\s*(?:Fund)?\\s*(?:Since)?\\s*(?P<managing_since>[\\w\\d\\s,]+)\\)?\\s*Total experience\\s*-\\s*over\\s*(?P<experience>\\d+\\s+years)",
      // fields: ["name", "since", "exp"],
      name:"(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp:"(\\d+\\s+[Yy]ears?)",
      since:"([A-Z\\,\\s0-9]+\\s+\\d{3,4}|Inception)"
    },
    load: "Entry Load\\s*(.+?)\\s*Exit Load\\s*(.+)$",
    escape: "[^A-Za-z0-9\\/\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*one)": ["_extract_scheme_data", "scheme"],
    "^DUMMY.*(?:two|three)": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*load_structure": ["_extract_load_data", "load"],
    ".*(expense_ratio)$": ["_extract_generic_data", "metric2"],
    ".*(nav_of_plans|maturity_and_yield)":["_extract_iter_data","metrics"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(minimum_investment_amount|minimum_additional_investment|load_structure)",
    "amc_name",
    "load",
    ".*fund_manager",
    ".*(benchmark|date_of_allotment)",
    ".*monthly_avg_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "metrics",
  ],
  MERGEKEYS: {
    metrics: [
      ".*(expense_ratio|volatility_measures?|nav_of_plans|maturity_and_yield)",
    ],
    load:[".*(entry_load|exit_load)"],
  },
  CLONEKEYS: {"monthly_avg_aum":".*monthly_average$"},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {".*fund_manager": "_update_manager_data"}, //".*fund_manager": "_update_manager_data"
  Z_MUTUAL_FUND_DATA: {},
}
