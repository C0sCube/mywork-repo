{
  AMC_NAME: "Bandhan Life Insurance Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Bandhan Life Insurance AMC Limited",
    mutual_fund_name: "Bandhan Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: ".+?FUND",
      bbox: [40, 0, 535, 75],
    },
    clip_bbox: [[20, 0, 545, 160]],
    port_bbox: [
      {
        bbox: [2.16, 150.24, 296.16, 916.58],
        support_lines: [96, 270],
        anchor_t: "EQUITY HOLDINGS",
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
      },
      {
        bbox: [288.91, 147.06, 588.23, 792.55],
        support_lines: [391.72, 538],
        anchor_t: "EQUITY HOLDINGS",
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
      },
    ],
    line_x: 200.0,
    data: {
      size: [6, 15],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 15.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 3,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]r)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "SFIN",
      "Fund Manager",
      "Investment Objective",
      "NAV",
      "AUM",
      "EOL",
    ],
    manager: {
      pattern: "([A-Z]{1}[a-z]+\\s*[A-Z]{1}[a-z]+)",
      fields: ["name"],
    },

    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_mana": ["_extract_manager_data", "manager"],
    // ".*benchmark": ["_extract_generic_data", "benchmark"],
    ".*aum$": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*sfin",
    ".*fund_manager",
    ".*benchmark",
    ".*launch_date",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*aum$",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
