{
  AMC_NAME: "Tata Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Tata Asset Management Private Limited",
    mutual_fund_name: "Titanium SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "((?:Tata|Treasury|TATA|TITANIUM).*?(?:FUNDS?|Funds?(?:.*?Plan)?|ETF\\s*(?:Fund of Funds?)?|FOF|EOF|Plan.*?(?:days)?))",
      bbox: [0, 0, 440, 75],
    },
    clip_bbox: [[0, 70, 175, 770]],
    line_x: 160.0,
    data: {
      size: [5, 8],
      color: [666],
      update_size: 30.0,
      font: ["Swiss721BT-BoldCondensed", "DMSans-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 6,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    nav: "((?:Regular|Direct|Reg)\\s*(?:Growth|IDCW))\\s*([\\d,.]+)",
    aum: "([\\d,]+\\.\\d+)",
    ter: "(Regular|Direct)\\s*([\\d,.]+)",
    metric: "(PE|PB|Average Maturity|Macaul[ea]y\\s*(?:Duration)?|Modified Duration|Modi.+?ed Duration|Yield to Maturity\\D+?|Std\\.?\\s*Dev|Sharpe Ratio|Portfolio Beta|R Squared|Treynor|Jenson|Portfolio Turnover\\D*)\\s*(?:\\:)?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%)?|NA)",
    manager: {
      pattern: "([A-Za-z\\s]+)\\s*(?:\\([A-Za-z\\s]+\\))?\\s*\\(Managing Since\\s*([A-Za-z0-9\\s\\-]+) and overall? experience\\s*of\\s*(\\d{1,2}\\s+[Yy]ears?)\\)",
      fields: ["name", "since", "exp"],
      name: "(?:Mr|Mrs|Ms)\\.?\\s*([A-Za-z]+\\s*[A-Za-z]+)",
      since: "\\d{1,2}\\-[A-Za-z]+\\-\\d{2,4}",
      exp: "(\\d+\\s*[Yy]ears?)",
    },
    scheme: [
      "Inception\\s*[Dd]ate",
      "Benchmark",
      "NAV",
      "Total\\s*Expense\\s*[Rr]atio",
      "Fund\\s*[Ss]ize",
      "Month End AUM",
      "Fund\\s*Manager",
      "Exit\\s*[Ll]oad",
      "Quantitative\\s*[iI]ndicators",
      "EOL",
    ],
    load: "Entry Load\\s*(.*?)Exit Load\\s*(.*?)$",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\&]+|\\(Annualised\\)",
  },
  PATTERN_TO_FUNCTION: { "^before.*": ["_extract_scheme_data", "scheme"] },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*monthly_average": ["_extract_generic_data", "aum"],
    ".*fund_manager": ["_update_manager_data", null],
    ".*(turn_over|volatility|quantitative_indicator)": ["_extract_generic_data", "metric"],
    ".*(minimum_investment|additional_investment)": [
      "_extract_amt_data",
      "min_amt",
    ],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*inception_date",
    ".*fund_manager",
    ".*benchmark",
    ".*month_end_aum",
    "monthly_aaum_date",
    "mutual_fund_name",
    "amc_name",
    "main_scheme_name",
    "metrics",
    "load",
    "page_number",
    ".*quantitative_indicator",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics: [
      "metrics",
      ".*volatility.*$",
      ".*turn_over",
      ".*quantitative_indicators?"
    ],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
