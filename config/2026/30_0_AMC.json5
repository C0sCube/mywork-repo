{
  AMC_NAME: "Ppfas Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "PPFAS Asset Management Private Limited",
    mutual_fund_name: "PPFAS Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: true,
      pattern: "(Parag Parikh.*?(?:Fu\\s*n\\s*ds?|ETF|Fo?O?F|Plans?|rune))",
      bbox: [0, 0, 400, 60],
    },
    clip_bbox: [[0, 60, 300, 812]],
    line_x: 210.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["Arial-BoldMT"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 9,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: ".+Average AUM\\D*\\s*([\\d,.]+\\s*Crores)",
    benchmark: "(.+?)Additional Bench",
    benchmark2: "(.+?(?:Index|TRI)\\s*(?:TRI)?)",
    scheme: [
      "Name of the Fund",
      "Type of the Scheme",
      "Name of the Fund",
      "Date of Allotment",
      "Assets Under Management",
      "Net Asset Value",
      "Benchmark Index",
      "Minimum Application",
      "Additional Purchase Amount",
      "Minimum SIP Investment",
      "Load Structure",
      "Q\\s*u\\s*a\\s*n\\s*t\\s*i\\s*t?\\s*a?\\s*t\\s*i\\s*v\\s*e\\s*I\\s*n\\s*d\\s*i\\s*c\\s*a\\s*t\\s*o\\s*r\\s*s?",
      "EOL",
    ],
    date: ".+?Date of Allotment(.+?\\d{3,4})",
    manager: {
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*(\\w+\\s\\w+)\\s*(.+?)\\s*\\(Since (Inception|.+?)\\)",
      fields: ["name", "desig", "since"],
    },
    min_amt: "(?:Additional.*?|.*Purchase.*?)([\\d.,]+).*?([\\d.,]+|any|$)\\s*(?:Q u a n t i t a t i v e.+)?",
    metrics: "(Beta|Standard\\s*Deviation|Sharpe\\s*Ratio|Macaulay\\s*Duration\\D*?|Portfolio\\s*Turnover\\D*?|Avg\\s*maturity\\D*?|Modified\\s*Duration\\D*?|Yield\\s*to\\s*Maturity\\D*?)\\s*(-?[\\d.\\s]+\\s*(?:[Tt]imes?|[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?)?)",
    load: "Entry Load(.+?)Exit Load(.+)$",
    escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%]+",
  },
  PATTERN_TO_FUNCTION: { before: ["_extract_scheme_non_esc_data", "scheme"] },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(quantitative|q_u_a_n_t_i_t_a_t_i_v_e|quantitive)": [
      "_extract_whitespace_data",
      "metrics",
    ],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*type_of_the_scheme": ["_extract_generic_data", "date"],
    ".*assets_under_management": ["_extract_generic_data", "aum"],
    ".*benchmark": ["_extract_non_esc_data", "benchmark"],
    ".*(minimum_application|additional_purchase_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*date_of_allotment": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {
    ".*benchmark": ["_extract_generic_data", "benchmark2"],
  },
  SELECTKEYS: [
    "amc_name",
    "mutual_fund_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "monthly_aaum_value",
    ".*(load_structure|assets_under_management|benchmark_index)",
    ".*(minimum_application|additional_purchase_amount)",
    "fund_manager",
    "inception_date",
    "metrics",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    inception_date: ".*type_of_the_scheme",
    fund_manager: ".*date_of_allotment",
    metrics: ".*(quantitative_indicators|q_u_a_n_t_i_t_a_t_i_v_e.*|quantitive.*)",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
