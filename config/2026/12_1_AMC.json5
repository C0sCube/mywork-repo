{
  "AMC_NAME": "Hdfc Mutual Fund Passive",
  "CLONEKEYS": {},
  "DUPLICATE_MUTUAL_FUNDS": {},
  "IMP_DATA": {
    "amc_name": "HDFC Asset Management Company Limited",
    "mutual_fund_name": "HDFC Mutual Fund"
  },
  "MAIN_MAP": {
    "map": true,
    "select": true,
    "special": true
  },
  "MERGEKEYS": {
    "load": [
      "exit_load"
    ],
    "metrics": [
      "metrics",
      ".*(assets_under_management|quantitative_data)"
    ]
  },
  "PARAMS": {
    "clip_bbox": [
      [
        0,
        70,
        190,
        812
      ],
      [
        370,
        100,
        570,
        812
      ]
    ],
    "content_size": [
      30,
      10
    ],
    "data": {
      "color": [
        666
      ],
      "font": [
        "Taz-SemiBold",
        "Cambria-Bold"
      ],
      "size": [
        5,
        13
      ],
      "update_size": 30
    },
    "line_side": "",
    "line_x": 200,
    "max_financial_index_highlight": 7,
    "method": "clip",
    "pdf_ocr": false,
    "sanitize_fund": false,
    "stop_words": [],
    "table": "",
    "title": {
      "bbox": [
        0,
        0,
        400,
        60
      ],
      "ocr": false,
      "pattern": "(HDFC.*?(?:[Ss]aver|FUND|Fund|ETF|F[Oo]F|Index)\\s*(?:of Funds?|.+?Plan|Fund of Funds?|Fund)?)"
    },
    "update_min_add": true
  },
  "PATTERN_TO_FUNCTION": {
    "(before|dummy.*)": [
      "_extract_scheme_non_esc_data",
      "scheme"
    ]
  },
  "PRE_DATA_SELECT": [],
  "PROMOTE_KEYS": {},
  "REGEX": {
    "aum": "([\\d,.]+\\s*Cr)",
    "benchmark": "(.+?(?:[Ii]ndex|[Gg]old|[Ss]ilver)).*$",
    "escape": "[^A-Za-z0-9\\/\\s\\-\\(\\)\\.\\,\\+\\%\\&\\:]+",
    "load": "",
    "manager": "",
    "metric": "(Total Turnover|Standard Deviation|Beta|Sharpe Ratio|Residual Maturity|Macaul[ea]y Duration|Modified Duration|Annualized Portfolio YTM|Regular|tracking error.+?last 12 [Mm]onths?)\\s*\\:?\\s*(\\-?[\\d,.]+\\s*(?:[Y]ears?|[Dd]ays?|[Mm]onths?|[Tt]imes?|%)?)",
    "scheme": [
      "INVESTMENT OBJECTIVE",
      "FUND MANAGER",
      "DATE\\s*OF\\s*ALLOTMENT.+?INCEPTION DATE",
      "NAV",
      "ASSETS UNDER MANAGEMENT",
      "EOL",
      "Average for Month",
      "EOL",
      "TOTAL EXPENSE RATIO",
      "BENCHMARK INDEX",
      "TRACKING ERROR",
      "EXIT LOAD",
      "EOL"
    ],
    "track": ".+?months\\s*(?:regular)?\\s*([\\d.]+)"
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*assets_under_management": [
      "_extract_generic_data",
      "metric"
    ],
    ".*average_for_month": [
      "_extract_generic_data",
      "aum"
    ],
    ".*benchmark_index": [
      "_extract_generic_data",
      "benchmark"
    ]
  },
  "SELECTKEYS": [
    ".*fund_manager",
    ".*average_for_month$",
    "metrics",
    ".*benchmark_index",
    "exit_load",
    ".*inception_date$",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "tracking_error",
    "load"
  ],
  "SPECIAL_FUNCTIONS": {
    "fund_manager": "_update_manager_data"
  },
  "TERTIARY_PATTERN_TO_FUNCTION": {},
