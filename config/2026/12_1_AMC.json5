{
  AMC_NAME: "Hdfc Mutual Fund Passive",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "HDFC Asset Management Company Limited",
    mutual_fund_name: "HDFC Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(HDFC.*?(?:FUND|Fund|ETF|FO?o?F|Index|Active)\\s*(?:of Funds?|.+?Plan|Fund of Funds?|Fund)?)",
      bbox: [0, 0, 400, 60],
    },
    clip_bbox: [
      [0, 70, 190, 812],
      [370, 100, 570, 812],
    ],
    line_x: 200.0,
    data: {
      size: [5, 13],
      color: [666],
      update_size: 30.0,
      font: ["Taz-SemiBold", "Cambria-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    table: "",
    update_min_add: true,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*Cr)",
    track: ".+?months\\s*(?:regular)?\\s*([\\d.]+)",
    escape: "[^A-Za-z0-9\\/\\s\\-\\(\\)\\.\\,\\+\\%\\&\\:]+",
    scheme: [
      "INVESTMENT OBJECTIVE",
      "FUND MANAGER",
      "DATE\\s*OF\\s*ALLOTMENT.+?INCEPTION DATE",
      "NAV",
      "ASSETS UNDER MANAGEMENT",
      "EOL",
      "Average for Month",
      "EOL",
      "TOTAL EXPENSE RATIO",
      "BENCHMARK INDEX",
      "TRACKING ERROR",
      "EXIT LOAD",
      "EOL",
    ],
    load: "",
    manager: "",
    benchmark: "(.+?(?:[Ii]ndex|[Gg]old|[Ss]ilver)).*$",
    metric: "(Total Turnover|Standard Deviation|Beta|Sharpe Ratio|Residual Maturity|Macaul[ea]y Duration|Modified Duration|Annualized Portfolio YTM|Regular|tracking error.+?last 12 [Mm]onths?)\\s*\\:?\\s*(\\-?[\\d,.]+\\s*(?:[Y]ears?|[Dd]ays?|[Mm]onths?|[Tt]imes?|%)?)",
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy.*)": ["_extract_scheme_non_esc_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*assets_under_management": ["_extract_generic_data", "metric"],
    ".*average_for_month": ["_extract_generic_data", "aum"],
    ".*benchmark_index": ["_extract_generic_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*fund_manager",
    ".*average_for_month$",
    "metrics",
    ".*benchmark_index",
    "exit_load",
    ".*inception_date$",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "tracking_error",
    "load",
  ],
  MERGEKEYS: {
    load: ["exit_load"],
    metrics: ["metrics", ".*(assets_under_management|quantitative_data)"], //"tracking_error",
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { fund_manager: "_update_manager_data" },
