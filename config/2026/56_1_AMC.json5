{
  AMC_NAME: "Navi Mutual Fund Passive",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Navi Asset Management Company Limited",
    mutual_fund_name: "Navi Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Navi.*?(?:F[oO]F|Fund|ETF|Index)\\s*(?:of Fund|F[oO]F|Fund)?)",
      bbox: [0, 0, 800, 180],
    },
    clip_bbox: [
      [0, 160, 320, 830],
      [315, 160, 600, 830],
    ],
    line_x: 320.0,
    data: {
      size: [14, 20],
      color: [-1],
      update_size: 30.0,
      font: ["NaviHeadline-Bold", "NaviHeadline,Bold"],
    },
    content_size: [30.0, 19.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    tracking: "(Tracking Error).+?\\s*([\\d,.]+)",
    min_amt: "([\\d,]+).*?(\\d+)",
    load: "(?:Entry Load)?\\s*(.*?)\\s*Exit Load\\s*(.*)$",
    aum: "([\\d,.]+\\s*crs?)",
    ptr: "\\(Times\\)\\s*([\\d.]+)",
    metric: "(Portfolio Turnover Ratio\\s*\\(Times\\)|TER - Regular Plan|TER - Direct Plan|Portfolio Turnover Ratio|Std\\.?Dev|Beta|Sharpe Ratio|Tracking Error Regular|Tracking Error Direct|Tracking Error|Avg Mat\\.?|Modified Duration|Portfolio Yield|Macaulay Duration)\\s*([\\d,.]+)",
    manager: {
      pattern: "(?:Mr\\.?|Ms\\.?|Mrs\\.?)\\s*([A-Za-z]+\\s*[A-Za-z]+)\\s*.+?(?:until|from|as of|w\\.e\\.f\\.?)\\s*([A-Za-z]+\\s*\\d{2},?\\s*\\d{4}|\\d{1,2}(?:st|nd|rd|th)\\s*[A-Za-z]+\\,\\s*\\d{3,4})",
      fields: ["name", "since"],
    },
    scheme: [
      "Investment Objective",
      "Fund Manager",
      "Inception Date",
      "Minimum Application",
      "Load Structure",
      "Asset Allocation Pattern",
      "Portfolio Turnover Ratio",
      "Net Asset Value",
      "Monthly Average AUM",
      "Risk Measures",
      "EOL",
    ],
    date: "([0-9]+(?:th|rd|st|nd)?\\s*[A-Za-z]+\\,?\\s*[0-9]+)",
    benchmark: ".+?index(.+)$",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|·|\\(Y?y?rs\\)",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*minimum_application$": ["_extract_amt_data", "min_amt"],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*(risk_measures|debt_quants)": ["_extract_generic_data", "metric"],
    ".*fund_mana.*": ["_extract_manager_data", "manager"],
    // ".*inception_date": ["_extract_generic_data", "date"],
    ".*tracking_error": ["_extract_generic_data", "tracking"],
    ".*monthly_average_aum": ["_extract_generic_data", "aum"],
    ".*portfolio_turnover_ratio$": ["_extract_generic_data", "ptr"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "main_scheme_name",
    "page_number",
    ".*fund_manager",
    ".*(load_structure|minimum_application)$",
    "metrics",
    "tracking_error",
    ".*monthly_average_aum",
    ".*index.*",
    "benchmark_index",
    "date_of_allotment"
  ],
  MERGEKEYS: {
    metrics: [
      ".*risk_measures",
      ".*debt_quants",
      ".*tracking_error",
      ".*portfolio_turnover_ratio",
    ],
  },
  CLONEKEYS: {
    "benchmark_index":".*inception_date",
    "date_of_allotment":".*inception_date"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    // date_of_allotment:"_update_date_data",
    // benchmark_index: "_update_benchmark_data"
  },
  Z_MUTUAL_FUND_DATA: {},
}
