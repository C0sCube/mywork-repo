{
  AMC_NAME: "Navi Mutual Fund Passive",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "Navi Asset Management Company Limited",
    mutual_fund_name: "Navi Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Navi.*?(?:F[oO]F|Fund|ETF|Index)\\s*(?:of Fund|F[oO]F|Fund)?)",
      bbox: [0, 0, 450, 70],
    },
    clip_bbox: [
      [0, 65, 190, 830],
      [405, 65, 590, 830],
    ],
    line_x: 320.0,
    data: {
      size: [14, 20],
      color: [-1],
      update_size: 30.0,
      font: ["NaviHeadline-Bold", "NaviHeadline,Bold"],
    },
    content_size: [30.0, 19.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    min_amt: "([\\d,]+).*?(\\d+|)",
    load: "(?:Entry Load)?\\s*(.*?)\\s*Exit Load\\s*(.*)$",
    aum: "([\\d,.]+\\s*crs?)",
    date:"((?:February|January|March|April|May|June|July|August|September|October|November|December)\\s+\\d{2}\\,?\\s+\\d{4})",
    metric: "(Standard\\s+Deviation|Beta|Sharpe Ratio|Information Ratio|Yield to Maturity|Average Maturity|Equity Turnover|Modified Duration|Portfolio Yield|Macaulay Duration)\\s*(?:\\(.+?\\)|:)?\\s*(-?[\\d,.]+\\s+(?:[Yy]years?|[Mm]onths?|[Dd]ays?)?)",
    // manager: {
    //   pattern: "(?:Mr\\.?|Ms\\.?|Mrs\\.?)\\s*([A-Za-z]+\\s*[A-Za-z]+)\\s*.+?(?:until|from|as of|w\\.e\\.f\\.?)\\s*([A-Za-z]+\\s*\\d{2},?\\s*\\d{4}|\\d{1,2}(?:st|nd|rd|th)\\s*[A-Za-z]+\\,\\s*\\d{3,4})",
    //   fields: ["name", "since"],
    // },
    manager:{
      "name":"(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      "exp":"(\\d+\\s+[Yy]ears?)",
      "since":"((?:February|January|March|April|May|June|July|August|September|October|November|December)\\s+\\d{2}\\,?\\s+\\d{4})"
    },
    scheme: [
      "Fund Details",
      "Date of (?:Inception|Inspection)",
      "Benchmark Name",
      "NAV\\s+as\\s+on",
      "AUM",
      "AAUM",
      "Fund Manager Details?",
      "Minimum Investment",
      "SIP",
      "Load Structure",
      "Exit Load",
      "(?:Base)\\s+Expense\\s+Ratio",
      "EOL",
      "Major Risk Factors?",
      "EOL",
    ],
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\u00b7",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
     ".*minimum_investment$": ["_extract_amt_data", "min_amt"],
    ".*(expense_ratio|risk_factors?)": ["_extract_generic_data", "metric"],
    // ".*fund_mana.*": ["_extract_manager_data", "manager"],
    ".*date_of_inspection":["_extract_generic_data","date"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "main_scheme_name",
    "page_number",
    ".*(fund_manager|minimum_investment)",
    "metrics",
    "load_structure",
    "date_of_inception",
    "benchmark_name",
    ".*aaum$"
  ],
  MERGEKEYS: {
    metrics: [
      ".*risk_measures",
      ".*debt_quants",
      ".*tracking_error",
      ".*(expense_ratio|risk_factors?)",
    ],
    load_structure:[".*(entry_load|exit_load)"]
  },
  CLONEKEYS: {
    "date_of_inception":".*date_of.*$"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    ".*fund_manager":"_update_manager_data"
  },
  Z_MUTUAL_FUND_DATA: {},
}
