{
  AMC_NAME: "Samco Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Samco Asset Management Private Limited",
    mutual_fund_name: "Samco Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Samco.*?(?:Fund|ETF|FOF|Index)\\s*(?:of Funds?|FOF)?)",
      bbox: [0, 30, 600, 105],
    },
    clip_bbox: [
      [0, 75, 170, 825],
      [420, 75, 590, 825],
    ],
    line_x: 200.0,
    data: {
      size: [7, 12],
      color: [-666],
      update_size: 30.0,
      font: ["Inter-SemiBold", "Inter-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 3,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: ["(Fixed Income Portion of Portfolio)"],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: ".+?([\\d,]+\\.\\d{2}\\s*[Cc]rs?)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "\\d{1,2}\\s*[A-Za-z]+\\s*\\d{4}",
    nav: "(Regular Growth|Direct Growth|Regular IDCW|Direct IDCW)\\s*([\\d,.]+)",
    metric: "(Standard\\s*Deviation|Portfolio\\s*Turnover\\s*Ratio|Annualised\\s*Portfolio\\s*YTM|Macaulay\\s*Duration|Residual\\s*Maturity|Modified\\s*Duration|Beta|Treynor\\D*?|Sharpe\\D*?|Portfolio\\s*Turnover)\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Tt]imes?)?)",
    scheme: [
      "Date\\s+[Oo]f\\s+[aA]llotment",
      "Benchmark\\s+Name",
      "NAV\\s+as\\s+on",
      "AUM\\s+as\\s+on",
      "AAUM\\s+as\\s+on",
      "Fund\\s+Manager\\s+Details?",
      "Minimum\\s+Investment",
      "Lumpsum\\s+Amount",
      "SIP\\s+Amount",
      "Load\\s+Structure",
      "Exit\\s+Load",
      "Total\\s+Expense\\s+Ratio",
      "EOL",
      "Major\\s+Risk\\s+Factors?",
      "EOL"
    ],
    manager: {
      name:"(?:Mr|Ms|Mrs)\\.?\\s+([A-Za-z]+\\s+[A-Za-z]+)",
      exp:"(\\d+\\s+[Yy]ears?)",
      since:"((?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{2}\\,?\\s+\\d{3,4})"      
    },
    escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%]+|\\b\\(?TRI\\)?\\b",
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy.*)": ["_extract_scheme_non_esc_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(major_risk_factor)": ["_extract_generic_data", "metric"],
    ".*(lumpsum_amount|sip_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*aaum_as_on": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*date_of_allotment$",
    "benchmark",
    ".*fund_manager",
    "monthly_average_aaum",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "metrics",
    "mutual_fund_name",
    "page_number",
    "load",
    "min_amt",
    "min_addl_amt"
  ],
  MERGEKEYS: {
    load: [".*entry_load", ".*exit_load"],
    metrics: [".*(metrics|major_risk_factor|quantitative_data)"],
  },
  CLONEKEYS: {
    "monthly_average_aaum":".*aaum_as_on",
    "benchmark":".*benchmark_name",
    "min_amt":".*lumpsum_amount",
    "min_addl_amt":".*sip_amount"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {"fund_manager":"_update_manager_data"},
  Z_MUTUAL_FUND_DATA: {},
}
