{
  AMC_NAME: "HSBC Asset Management (India) Private Limited",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "HSBC Asset Management (India) Private Limited",
    mutual_fund_name: "RedHex SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "RedHex.+?(?:FUND|Fund)",
      bbox: [0, 0, 360, 90],
    },
    clip_bbox: [
      [-2.41, 196.51, 112.12, 429.18],
      [107.3, 195.3, 213.38, 420.74],
      [204.95, 197.71, 326.71, 417.13],
      [409.89, 196.51, 537.68, 418.33],
    ],
    line_x: 200.0,
    data: {
      size: [6, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Inception\\s+[Dd]ate",
      "Benchmark",
      "Plans.+?Options",
      "AAUM.+?as\\s+on",
      "AUM.+?as\\s+on",
      "NAV",
      "Fund\\s+Manager",
      "EOL",
      "Minimum\\s+Applicaton\\s+Amount",
      "Exit\\s+Load",
      "EOL",
      "Quantitative Indicators",
      "EOL",
    ],
    manager: {
      pattern: "([A-Za-z]+\\s+[A-Za-z]+).+?Total\\s+Experience\\s+([0-9]+\\s+[Yy]ears?)\\s+Managing\\s+[Ss]ince\\s+(Inception|[A-Z0-9]+)",
      fields: ["name","exp","since"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Y?ield to Maturity|YTM|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*minimum_application": ["_extract_amt_data", "min_amt"],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*aaum": ["_extract_generic_data", "aum"],
    ".*quantitative_indicators":["_extract_generic_data","metric"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(date_of_allotment|inception_date)",
    ".*fund_manager",
    "metrics",
    ".*benchmark",
    ".*minimum_application",
    ".*monthly_avg_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics: [
      "metrics",
      ".*(total_expense_ratio|portfolio_turnover_ratio|other_parameter|quantitative_indicators)",
    ],
  },
  CLONEKEYS: {
    monthly_avg_aum: ".*aaum",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
