{
  AMC_NAME: "Bandhan Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "360 ONE Asset Management Limited",
    mutual_fund_name: "Dyna SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "DynaSIF.+?Fund",
      bbox: [0, 0, 460, 70],
    },
    clip_bbox: [[0, 70, 155, 895]],
    line_x: 200.0,
    data: {
      size: [6, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 6,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*crores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Investment Objective",
      "Fund Manager",
      "Launch Date",
      "Benchmark",
      "Exit Load",
      "AUM as on",
      "Net AUM",
      "Monthly Average AUM",
      "Net Asset Value",
      "Exit\\s*[Ll]oad",
      "NAV",
      "EOL",
    ],
    manager: {
      pattern: "([A-Za-z]+\\s*[A-Za-z]+)\\s*(?:\\(.+?\\))?\\s*(?:Nearly|Over)\\s*(\\d{1,2}\\s*[Yy]ears?)",
      fields: ["name", "exp"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    ter: "([\\d.]+)",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    nav: "(Regular Plan Growth|Regular Plan IDCW|Direct Plan Growth|Direct Plan IDCW)[\\s]+([\\d]+(?:\\.\\d+)?|NA|Nil)",
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+|\\(Annualized\\)|\u00b7",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    // ".*minimum_investment": ["_extract_amt_data", "min_amt"],
    // ".*(total_expense_ratio|portfolio_turnover_ratio|other_parameter)": [
    //   "_extract_generic_data",
    //   "metric",
    // ],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    // ".*benchmark": ["_extract_generic_data", "benchmark"],
    // ".*(monthly_avg_aum|month_end_aum)": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*launch_date",
    ".*fund_manager",
    // "metrics",
    ".*benchmark",
    ".*minimum_investment",
    ".*monthly_avg_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*exit_load"],
    // metrics: [
    //   "metrics",
    //   ".*(total_expense_ratio|portfolio_turnover_ratio|other_parameter)",
    // ],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
