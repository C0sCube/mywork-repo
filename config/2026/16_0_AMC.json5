{
  AMC_NAME: "Bandhan Mutual Fund",
  CLONEKEYS: {},
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Bandhan Asset Management Company Limited",
    mutual_fund_name: "Bandhan Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*exit_load"],
    metrics: [
      "metrics",
      ".*(total_expense_ratio|portfolio_turnover_ratio|other_parameter)",
    ],
  },
  PARAMS: {
    clip_bbox: [[0, 80, 200, 812]],
    content_size: [30, 10],
    data: {
      color: [23],
      font: ["Ubuntu-Bold"],
      size: [6, 9],
      update_size: 30,
    },
    line_side: "",
    line_x: 200,
    max_financial_index_highlight: 9,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 490, 45],
      ocr: false,
      pattern: "Bandhan.+?(?:Funds?|Path|Saver|ETF|F[oO]F)\\s*(?:of [Ff]unds?.*?Plan|[Ff]und of [Ff]unds?.*?Plan|[Ff]unds?|F[oO]F|.*?Plan)?",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+\\s*crores?)",
    benchmark: "((?:^\\d{1,2}%|Russell|Nifty?|BSE|CRISIL|Domestic|NIFTY?|\\bICE\\b).+?)(?=\\(|$)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:]+|\\(Annualized\\)|TRI",
    manager: {
      name: "(?:Mr|Mrs|Ms)\\.?\\s*([A-Za-z]+\\s+[A-Za-z]+)",
      since: "(\\d{1,2}(?:nd|st|rd|th)?\\s*[A-Za-z]+,?\\s*\\d{4}|[A-Za-z]+\\s*\\d{2},?\\s*\\d{4})",
    },
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Y?ield to Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    min_amt: "([\\d,]+).*?(\\d+|any)\\s*(?:amount|thereafter)?",
    nav: "(Regular Plan Growth|Regular Plan IDCW|Direct Plan Growth|Direct Plan IDCW)[\\s]+([\\d]+(?:\\.\\d+)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    scheme: [
      "About the Fund",
      "Monthly Avg AUM",
      "Month end AUM",
      "Inception Date",
      "Fund Manager",
      "Total Expense Ratio",
      "Benchmark:?",
      "SIP\\s*\\(Minimum Amount",
      "Fund Manager",
      "Portfolio Turnover Ratio",
      "Benchmark:?",
      "SIP\\s*\\(Minimum Amount",
      "Fund Manager",
      "Other Parameter",
      "Benchmark:?",
      "SIP\\s*\\(Minimum Amount",
      "Minimum Investment Amount",
      "Option Available",
      "Exit Load",
      "NAV\\s*\\(",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(monthly_avg_aum|month_end_aum)": ["_extract_generic_data", "aum"],
    ".*(total_expense_ratio|portfolio_turnover_ratio|other_parameter)": [
      "_extract_generic_data",
      "metric",
    ],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*minimum_investment": ["_extract_amt_data", "min_amt"],
  },
  SELECTKEYS: [
    ".*inception_date",
    ".*fund_manager",
    "metrics",
    ".*benchmark",
    ".*minimum_investment",
    ".*monthly_avg_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
