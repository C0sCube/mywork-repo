{
  AMC_NAME: "Kotak Mahindra Asset Management Company Limited",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Kotak Mahindra Asset Management Company Limited",
    mutual_fund_name: "Infinity SIF",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "Infinity.+?(?:FUND|Fund)",
      bbox: [0, 0, 460, 120],
    },
    clip_bbox: [
      [0, 110, 305, 800],
      [300, 110, 600, 800],
    ],
    line_x: 200.0,
    data: {
      size: [6, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Investment Objective",
      "Investment Strategy",
      "Product Details",
      "EOL",
      "Inception Date",
      "Benchmark",
      "Fund manager",
      "AUM",
      "AAUM",
      "Folio Count",
      "Exit load",
      "Minimum investment",
      "EOL",
    ],
    manager: {
      pattern: "(?:Mrs?|Ms)\\.?\\s*([A-Za-z]+\\s+[A-Za-z]+)",
      fields: ["name"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified\\s+Duration|(?:Average|Avg)\\s+Maturity|(?:Macaulay|Mac)\\s+Duration|Y?ield to Maturity|YTM|Information Ratio|Tracking\\s*Error.+?|Portfolio Turnover)\\s*[:-]?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*minimum_(?:application|investment)": ["_extract_amt_data", "min_amt"],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*(product_details|folio_count)":["_extract_generic_data","metric"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(date_of_allotment|inception_date)",
    ".*fund_manager",
    "metrics",
    ".*benchmark",
    ".*minimum_investment",
    ".*aaum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics: [
      "metrics",
      ".*(total_expense_ratio|portfolio_turnover_ratio|other_parameter|quantitative_indicators|product_details|folio_count)",
    ],
  },
  CLONEKEYS: {
    // monthly_avg_aum: ".*aaum",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
