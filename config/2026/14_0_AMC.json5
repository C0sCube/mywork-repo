{
  AMC_NAME: "Icici Prudential Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "ICICI Prudential Asset Management Company Limited",
    mutual_fund_name: "ICICI Prudential Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "((?:ICICI|BHARAT).+?(?:Funds?|ETF|F[Oo]F|Plan|Saver|Index|Path)\\s*(?:of\\s*[Ff]unds?|Fund\\s*of\\s*[Ff]unds?|F[Oo]F|.+?Plan)?)",
      bbox: [0, 0, 540, 60],
    },
    clip_bbox: [
      [0, 90, 200, 800],
      [200, 90, 380, 800],
      [380, 90, 612, 800],
    ],
    line_x: 175.0,
    data: {
      size: [5, 9],
      color: [-12],
      update_size: 30.0,
      font: ["Mulish-Regular"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: ["v", "s"],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*crores)",
    benchmark: "((?:BSE|NSE|NYSE|Domestic|Nifty|CRISIL).+?(?:Silver|Gold|\\s+Inde?x?|\\s+TRI?))",
    date: "\\s*\\:?\\s*(\\d{1,2}\\s*\\-\\s*[A-Za-z]+\\s*\\-\\s*\\d{2,4}).*$",
    scheme: [
      "Fund Managers",
      "Indicative Investment Horizon",
      "Inception\\/?Allotment date",
      "Monthly AAUM",
      "Closing AUM",
      "Application Amount for fresh",
      "Min\\.?Addl\\.?Investment",
      "Exit\\s*load",
      "Total Expense Ratio",
      "Quantitative Indicators",
      "EOL",
      "Riskometer",
      "Scheme\\s*Benchmark",
      "EOL",
    ],
    manager: {
      pattern: "\\s*([\\w\\s]+)\\s\\(Managing this fund since\\s*([A-Za-z]+\\,?\\s*[0-9]+)\\s*overall\\s*([0-9]+ years).+?\\)",
      fields: ["name", "since", "exp"],
    },
    lumpsum: ".+?Application Amount(.+)Min.Addl.Investment(.+)$",
    min_amt: "\\.?\\s*([\\d,.]+).*?\\.?\\s*([\\d.,]+)\\)?.+$",
    metrics: {
      key: "(\\bPE\\b|\\bPB\\b|Average\\s*Dividend|\\(Annuali[zs]ed\\s*\\)|Turnover|Sharpe|Beta|Tracking Error\\s*1 year|Tracking Error\\s*3 year|Average Maturity|Macaulay Duration|Modified Duration|Portfolio\\s*YTM)",
      value: "(\\-?\\d+\\.\\d*\\s*(?:[Dd]ays?|[Yy]ears?|[Mm]onths?|[Tt]imes?|%)?)",
    },
    escape: "[^a-zA-Z0-9\\.\\,\\+\\s\\-\\(\\)\\%]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy|scheme_details).*": [
      "_extract_scheme_non_esc_data",
      "scheme",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    // ".*quantitative_indicators": ["_extract_metric_data", "metrics"],
    ".*(monthly_aaum|closing_aum)$": ["_extract_generic_data", "aum"],
    ".*fund_managers": ["_extract_manager_data", "manager"],
    ".*benchmark$": ["_extract_generic_data", "benchmark"],
    ".*(min.addl.investment|application_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*allotment_date$": ["_extract_generic_data", "date"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "mutual_fund_name",
    "page_number",
    ".*fund_managers",
    "metrics",
    "load",
    ".*allotment_date",
    ".*scheme_benchmark$",
    ".*monthly_aaum",
    ".*(min.addl.investment|application_amount)",
  ],
  MERGEKEYS: {
    load: [".*exit_load"],
    // metrics: ["^metrics", "^metrics_bravo", ".*quantitative_indicators"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
