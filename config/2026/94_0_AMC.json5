{
  AMC_NAME: "TATA AIA Life Insurance Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "TATA AIA Life Insurance AMC Limited",
    mutual_fund_name: "TATA AIA Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: ".+?FUND",
      bbox: [0, 0, 430, 110],
    },
    clip_bbox: [[0, 0, 275, 860]],
    port_bbox: [
      {
        bbox: [275, 90, 465, 641],
        support_lines: [420],
        anchor: {
          anchor_t: "Instrument",
          anchor_b: "Fund\\s+Performance",
          anchor_r: null,
          anchor_l: null,
        },
      },
      {
        bbox: [458, 88, 649, 627],
        support_lines: [600],
        anchor: {
          anchor_t: "Instrument",
          anchor_b: "Total",
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    method:"clip"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*Crs?)",
    date: "\\d{2}-[A-Za-z]+-\\d{2}",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      ".+?FUND",
      "Fund\\s*Details",
      "Investment\\s*Objective",
      "NAV as on",
      "Benchmark",
      "Corpus as on",
      "Fund\\s*Manager",
      "Asset\\s*Allocation",
      "AUM\\s*Equity",
      "EOL",
    ],
    metric: {
      key: "(Std\\s+Dev|Sharpe\\s+Ratio|Portfolio\\s+Beta)",
      value: "([\\d.]+\\s*(?:%)?)",
    },
    manager: {
      pattern: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    "before.fund_manager": ["_extract_manager_data", "manager"],
    ".*corpus_as_on": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin|benchmark)",
    ".*fund_manager",
    "metric",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*corpus_as_on",
    sfin: "^before.+fund$",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
