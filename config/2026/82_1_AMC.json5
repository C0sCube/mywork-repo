{
  AMC_NAME: "HDFC Life Insurance Fund",
  MAIN_MAP: {
    select: true,
    map: true,
    special: true,
  },
  IMP_DATA: {
    amc_name: "HDFC Life Insurance AMC Limited",
    mutual_fund_name: "HDFC Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(.+)\\s*as\\s*on\\s*[A-Za-z]+",
      bbox: [0, 0, 525, 65],
    },
    clip_bbox: [
      [0, 75, 345, 800],
      [335, 75, 525, 575],
    ],
    port_bbox: [
      {
        bbox: [0, 200, 350, 800],
        support_lines: [280],
        anchor: {
          anchor_t: "Portfolio",
          anchor_b: "Grand\\s+Total",
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    max_financial_index_highlight: 3,
    pdf_ocr: false,
    method:"clip"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: ".+\\s+(\\d+\\,?\\d*\\.\\d+)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "SFIN\\s*Code",
      "Inception\\s*Date",
      "NAV",
      "Fund.+?Benchmark\\s+Performance",
      "Debt\\s*Parameters",
      "EOL",
      "AUM.+?Equity.+?Total",
      "Equity\\s+Fund\\s+Debt\\s+Fund\\s+Hybrid\\s+Fund",
      "Asset\\s+Category",
      "EOL",
    ],
    manager: {
      pattern: "(?:Mr|Mrs|Ms)\\.?\\s*([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*equity_fund_debt": ["_extract_manager_data", "manager"],
    ".*aum.+total$": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin_code|inception_date)",
    ".*fund_manager",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*aum.+total$",
    fund_manager: ".*equity_fund_debt_fund",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
