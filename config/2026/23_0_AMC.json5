{
  "AMC_NAME": "Kotak Mahindra Mutual Fund",
  "CLONEKEYS": {
    "additional_investment": ".*minimum_investment_amount"
  },
  "DUPLICATE_MUTUAL_FUNDS": {},
  "IMP_DATA": {
    "amc_name": "Kotak Mahindra Asset Management Company Limited",
    "mutual_fund_name": "Kotak Mahindra Mutual Fund"
  },
  "MAIN_MAP": {
    "map": true,
    "select": true,
    "special": true
  },
  "MERGEKEYS": {
    "load": [
      ".*entry_load$",
      ".*exit_load$",
      "^load"
    ],
    "metrics": [
      ".*net_asset_value$"
    ]
  },
  "PARAMS": {
    "clip_bbox": [
      [
        0,
        80,
        150,
        812
      ]
    ],
    "content_size": [
      30,
      10
    ],
    "data": {
      "color": [
        -15445130,
        -14590595
      ],
      "font": [
        "Frutiger-Bold"
      ],
      "size": [
        6,
        8
      ],
      "update_size": 30
    },
    "line_side": "",
    "line_x": 150,
    "max_financial_index_highlight": 5,
    "method": "clip",
    "pdf_ocr": false,
    "sanitize_fund": false,
    "stop_words": [],
    "title": {
      "bbox": [
        0,
        0,
        612,
        70
      ],
      "ocr": false,
      "pattern": "(KOTAK.*?(?:FUND\\s*(?:OF FUNDS?\\s*|-\\s*\\w+)?|ETF|FOF|PATH|FTF|INDEX\\s*(?:.*?FUND)?))"
    },
    "update_min_add": false
  },
  "PATTERN_TO_FUNCTION": {
    "^before": [
      "_extract_scheme_data",
      "scheme"
    ]
  },
  "PRE_DATA_SELECT": [],
  "PROMOTE_KEYS": {},
  "REGEX": {
    "escape": "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\&]+|·",
    "manager": {
      "fields": [
        "name"
      ],
      "pattern": "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)"
    },
    "metric": "(P\\s*E|P\\s*BV|Portfolio Turnover|Standard Deviation|Beta|Sharpe|Tracking Error|Average Maturity|Modified Duration|Annualised YTM|Macaulay Duration|Tracking Error)\\s*(?:\\([\\w\\s%-]*\\)|\\*)?\\s*(-?[\\d.]+\\s*(?:[Dd]ays?|[Yy]e?a?rs?|[Mm]onths?|%|[Tt]imes?)?)",
    "min_amt": "([\\d,]+).*?([\\d,]+|any)",
    "scheme": [
      "Fund\\s*Manager",
      "AAUM",
      "AUM",
      "Benchmark",
      "Allotment\\s*[Dd]ate",
      "Folio\\s*Count",
      "Minimum Investment Amount",
      "Systematic Investment Plan",
      "Net Asset Value",
      "Load Structure",
      "Entry\\s*Load",
      "Exit\\s*Load",
      "Data\\s*[Aa]s\\s*[Oo]n",
      "EOL"
    ]
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*fund_manager": [
      "_extract_manager_data",
      "manager"
    ],
    ".*minimum_investment_amount": [
      "_extract_amt_data",
      "min_amt"
    ],
    ".*net_asset_value": [
      "_extract_generic_data",
      "metric"
    ]
  },
  "SELECTKEYS": [
    "metrics",
    ".*aaum$",
    ".*fund_manager",
    ".*benchmark",
    ".*allotment_date",
    "additional_investment",
    ".*minimum_investment_amount",
    "load",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
    "minimum_investment_clone"
  ],
  "SPECIAL_FUNCTIONS": {},
  "TERTIARY_PATTERN_TO_FUNCTION": {},
  "Z_MUTUAL_FUND_DATA": {}
}