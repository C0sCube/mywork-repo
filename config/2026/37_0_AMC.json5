{AMC_NAME: "Sundaram Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Sundaram Asset Management Company Limited", mutual_fund_name: "Sundaram Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Sundaram.+?(?:Funds?|Plan|Path|ETF|F[Oo]F)\\s*\\-?\\s*(?:of Funds?|Funds?|F[Oo]F|Fund of [Ff]unds?)?\\s*(?:Series\\s+[IVXLCDM]+(?:[-\\s,]+[IVXLCDM]+)*)?)", bbox: [0, 0, 480, 50]}, clip_bbox: [[0, 5, 220, 812]], line_x: 220.0, data: {size: [6, 12], color: [6969], update_size: 30.0, font: ["UniversNextforMORNW02-Cn"]}, content_size: [30.0, 12.0], method: "clip", line_side: "", max_financial_index_highlight: 5, pdf_ocr: false, sanitize_fund: false, stop_words: [], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {"long\\s*term\\s*tax\\s*advantage": ["Sundaram Long Term Tax Advantage Fund Series III", "Sundaram Long Term Tax Advantage Fund Series IV", "Sundaram Long Term Tax Advantage Fund Series II"], "long\\s*term\\s*micro\\s*cap\\s*tax\\s*advantage": ["Sundaram Long Term Micro Cap Tax Advantage Fund Series III", "Sundaram Long Term Micro Cap Tax Advantage Fund Series IV", "Sundaram Long Term Micro Cap Tax Advantage Fund Series V", "Sundaram Long Term Micro Cap Tax Advantage Fund Series VI"]}, PRE_DATA_SELECT: [], REGEX: {nav: "(Growth|IDCW)\\s*(-?[\\d,.]+)\\s*(-?[\\d,.]+)", decimal: "([\\d,.]+) Cr.", metric: "(Information Ratio|Turnover Ratio|Standard Deviation|Beta|Sharpe Ratio|Average Maturity\\D*|Modified Duration\\D*|YTM\\D*|Macaulay Duration\\D*)\\s*\\:?\\s*(-?[\\d.,]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|times?)?)", scheme: ["Category", "Fund Managers", "Month End AUM", "Avg\\.?\\s*AUM", "Inception Date", "Benchmark", "Plans", "Options", "Minimum Amount", "SIP\\s*STP\\s*SWP", "Exit Load", "NET\\s*ASSET\\s*VALUE", "EOL|Weighted Avg", "EOL"], min_amt: "([\\d,]+).*?([\\d,]+)", manager: {pattern: "([\\w\\s]+)[,&]?", fields: ["name"]}, load: "^()(.*$)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+"}, PATTERN_TO_FUNCTION: {"^(scheme|before).*": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*minimum_amount$": ["_extract_amt_data", "min_amt"], ".*fund_managers$": ["_extract_manager_data", "manager"], ".*load$": ["_extract_load_data", "load"], "(^metric|.*net_asset_value)": ["_extract_generic_data", "metric"], ".*weighted_avg": ["_extract_generic_data", "metric"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["load", "metrics", ".*minimum_amount", ".*(benchmark|inception_date|avg.?_.?aum|fund_managers)", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", ".*weighted_avg", "mutual_fund_name"], MERGEKEYS: {metrics: ["metrics", ".*weighted_avg", ".*net_asset_value"], load: [".*exit_load"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}, Z_MUTUAL_FUND_DATA: {}}