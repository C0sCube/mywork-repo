{
  AMC_NAME: "AlphaGrep Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "AlphaGrep Investment Management Private Limited",
    mutual_fund_name: "AlphaGrep Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "AlphaGrep.+?Fund",
      bbox: [130, 20, 410, 120],
    },
    clip_bbox: [[300, 40, 585, 300],[200, 440, 395, 825],[385, 440, 590, 820]],
    line_x: 200.0,
    data: {
      size: [6, 9],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*[Cc]rores?)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "FACTHSEET DATE",
      "BENCHMARK",
      "Month.+?AUM",
      "Fund managers?",
      "[aA]llotment\\s+[dD]ate",
      "Holdings.+?[Ee]quity\\s+[Ss]tocks?",
      "EOL",
      "FUND FEATURES",
      "Minimum\\s+purchase",
      "Minimum\\s+SIP",
      "Entry\\s+[lL]oad:?",
      "Exit\\s+[lL]oad:?",
      "BASE EXPENSE RATIO",
      "EOL",
      "PORTFOLIO METRICS", 
      "EOL"
    ],
    manager: {
      pattern: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+)",
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    metric: "(Aggregate|Beta|R\\s*Squared|Standard Deviation|Sharpe\\*?|Modified Duration|Average Maturity|Macaulay Duration|Yield\\s+[Tt]o\\s+Maturity|Information Ratio|Tracking\\s*Error.+?)\\s*\\:?\\s*(-?[\\d.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?|NA|Nil)",
    ptr: "(Equity|Aggregate|Tracking Error)\\s*(-?[\\d.]+)",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*minimum_purchase": ["_extract_amt_data", "min_amt"],
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*monthend_aum":["_extract_generic_data","aum"],
    ".*portfolio_metrics":["_extract_generic_data","metric"]
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*allotment_date",
    ".*fund_manager",
    "metrics",
    ".*benchmark",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "load",
    "(min_amt|min_addl_amt|monthly_avg_aum)"
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics: [
      "metrics",
      ".*(other_parameter|portfolio_metrics)",
    ],
  },
  CLONEKEYS: {
    "monthly_avg_aum":".*monthend_aum",
    "min_addl_amt":".*minimum_purchase",
    "min_amt":".*minimum_purchase"
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
