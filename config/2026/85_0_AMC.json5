{
  AMC_NAME: "Kotak Mahindra Life Insurance Fund",
  IMP_DATA: {
    amc_name: "Kotak Mahindra Life Insurance AMC Limited",
    mutual_fund_name: "Kotak Mahindra Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(?:Group\\s+Funds?|Individual\\s+Funds?|GROUP\\s+FUND|INDIVIDUAL\\s+FUND)\\s+(.+?)\\(",
      bbox: [0, 30, 500, 90],
    },
    clip_bbox: [[0, 65, 170, 830]],
    port_bbox: [
      {
        bbox: [160, 130, 390, 830],
        support_lines: [312.57],
        anchor: {
          anchor_t: "Holdings",
          anchor_b: "NCA",
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    method:"clip"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "Rs.\\s*([\\d,.]+)",
    date: "\\d{2}-[A-Za-z]+-\\d{2}",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "SFIN",
      "Fact\\s*Sheet\\s*for",
      "Investment\\s*Objective",
      "Date of Inception",
      "AUM",
      "crore",
      "Equity",
      "Targeted Asset Allocation",
      "Quantitative Indicators",
      "EOL",
    ],
    metric: {
      key: "(Std\\s+Dev|Sharpe\\s+Ratio|Portfolio\\s+Beta)",
      value: "([\\d.]+\\s*(?:%)?)",
    },
    manager: {
      pattern: "([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*crore": ["_extract_manager_data", "manager"],
    "before.aum$": ["_extract_generic_data", "aum"],
    ".*date_of_inception": ["_extract_generic_data", "date"],
    ".*quantitative_indicators": ["_extract_metric_data", "metric"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(sfin|date_of_inception)",
    ".*fund_manager",
    "metric",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*aum$",
    fund_manager: ".*crore",
    metric: ".*quantitative_indicators",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
