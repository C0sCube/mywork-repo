{AMC_NAME: "Jm Financial Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "JM Financial Asset Management Limited", mutual_fund_name: "JM Financial Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(JM.*?(?:Fund|ETF|FOF|Path|Index)\\s*(?:of Funds?|FOF)?)", bbox: [0, 0, 400, 50]}, clip_bbox: [[390, 105, 730, 812], [20, 90, 207, 570], [207, 90, 393, 570]], line_x: 390.0, data: {size: [6, 9], color: [0], update_size: 30.0, font: ["MyriadPro-BoldCond"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: [], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: ["^before", "^dummy.*"], REGEX: {aum: "\\D*\\s*([\\d,.]+\\s*crore)", benchmark: "(.+?)Additional Benchmark", metric: "(Annualised Portfolio YTM|Modified Duration|Average Maturity|Macaulay Duration)\\s*([\\d,.]+\\s*(?:years?|days?|months?)?)", metric2: {key: "(Beta|Sharpe|Std\\.?\\s*Dev\\.?)", value: "(\\d+\\.\\d+)"}, lumpsum: "Purchase(.+?)Additional Purchase(.+?)$", manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)?\\s*([\\w\\s]+)\\s*\\(Managing.+?since\\s*([A-Za-z]+.+?\\d{4})\\D+?(\\d+\\s*(?:years?|decades?)).+?\\)", fields: ["name", "since", "exp"]}, scheme: ["INCEPTION DATE", "Benchmark Index", "FUND MANAGER DETAILS", "NAV DETAILS", "FUND SIZE", "Month End AUM", "Monthly AAUM", "PORTFOLIO TURNOVER RATIO", "MINIMUM APPLICATION AMOUNT\\s*Purchase", "Additional Purchase", "EXIT LOAD|EXPENSE RATIO", "EXPENSE RATIO", "RISK RATIOS", "EOL", "RISK RATIOS", "PORTFOLIO STATISTICS", "EOL", "EXIT LOAD", "PORTFOLIO STATISTICS", "EOL"], ptr: "^(\\d+\\.\\d+).+$", min_amt: "([\\d,]+).*?([\\d,]+)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+"}, PATTERN_TO_FUNCTION: {"^(before|dummy.*)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(month_end_aum|monthly_aaum)$": ["_extract_generic_data", "aum"], ".*statistics": ["_extract_generic_data", "metric"], ".*risk_ratios": ["_extract_metric_data", "metric2"], ".*(additional_purchase|amount_purchase)": ["_extract_amt_data", "min_amt"], ".*portfolio_turnover_ratio": ["_extract_generic_data", "ptr"], ".*fund_manager_details": ["_extract_manager_data", "manager"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*fund_manager", ".*monthly_aaum$", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", ".*portfolio_turnover", "load", ".*(inception_date|benchmark_index)", "metrics", ".*(minimum_application_amount_purchase|additional_purchase)"], MERGEKEYS: {load: ["exit_load"], metrics: ["metrics", ".*portfolio_turnover_ratio", ".*(risk_ratio|statistics)"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}, Z_MUTUAL_FUND_DATA: {}}