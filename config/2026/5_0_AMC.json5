{AMC_NAME: "Bank Of India Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "BOI STAR Investment Managers Private Limited", mutual_fund_name: "Bank of India Mutual Fund"}, PARAMS: {method: "line", line_side: "both", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: [], title: {ocr: false, pattern: "(Bank of India.*?(?:Plan|Funds?|ETF|FOF|FTF|Saver)\\s*(?:of Funds?|FO?o?F)?)", bbox: [0, 55, 280, 105]}, clip_bbox: [[0, 480, 290, 812]], line_x: 290.0, data: {size: [6, 9], color: [6969], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 10.0], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {load: "Entry Load\\s*(Nil|.*?)\\s*Exit Load\\s*(.+?)$", ptr: "([\\d\\.]+\\s*[Tt]imes?)", scheme: ["INVESTMENT\\s*OBJECTIVE", "WHO\\s*SHOULD\\s*INVEST", "BENCHMARK", "DATE\\s*OF\\s*ALLOTMENT", "FUND\\s*MANAGER", "AVERAGE\\s*AUM", "LATEST\\s*AUM", "MINIMUM\\s*APPLICATION\\s*AMOUNT", "ADDITIONAL\\s*PURCHASE\\s*AMOUNT", "EOL"], scheme2: ["ADDITIONAL\\s*PURCHASE\\s*AMOUNT", "PORTFOLIO TURNOVER\\s*RATIO", "OTHER\\s*PARAMETERS", "EXPENSE RATIO", "LOAD STRUCTURE", "EOL"], manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+(?P<actual_name>[A-Za-z]+\\s[A-Za-z]+)(?:\\s+\\(w\\.e\\.f\\.?s*(?P<wef>[A-Za-z]+\\s*[\\d,\\s]+)\\))?.*?(?P<experience>\\d{1,2}\\s+years)", fields: ["name", "since", "exp"]}, min_amt: "([\\d,]+).*?([\\d,]+)", metrics: "(Standard Deviation|Modified Duration|Annualised Yield|Average\\s*\\_?Residual Maturity|Macaulay Duration|Tracking Error|Sharpe Ratio|Beta|R\\s*Squared|Treynor)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%)?)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(Annualized\\)"}, PATTERN_TO_FUNCTION: {"^before": ["_extract_scheme_data", "scheme"], "^dummy.*": ["_extract_scheme_data", "scheme2"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*fund_manager": ["_extract_manager_data", "manager"], ".*load_structure": ["_extract_load_data", "load"], ".*other_parameters?": ["_extract_generic_data", "metrics"], ".*(additional_purchase_amount|application_amount)": ["_extract_amt_data", "min_amt"], ".*portfolio_turn.*": ["_extract_generic_data", "ptr"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*load_structure", ".*(additional_purchase_amount|application_amount)", ".*average_aum", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "metrics", ".*fund_manager", ".*date_of_allotment", "benchmark_index"], MERGEKEYS: {metrics: ["metrics", ".*portfolio_turnover", ".*other_parameters?"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}, Z_MUTUAL_FUND_DATA: {}}