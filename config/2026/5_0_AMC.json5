{
  AMC_NAME: "Bank Of India Mutual Fund",
  CLONEKEYS: {},
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Bank of India Investment Managers Private Limited",
    mutual_fund_name: "Bank of India Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    metrics: ["metrics", ".*portfolio_turnover", ".*other_parameters?"],
  },
  PARAMS: {
    clip_bbox: [[0, 480, 290, 812]],
    content_size: [30, 10],
    data: {
      color: [6969],
      font: ["Calibri-Bold"],
      size: [6, 9],
      update_size: 30,
    },
    line_side: "both",
    line_x: 290,
    max_financial_index_highlight: 7,
    method: "line",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 55, 280, 105],
      ocr: false,
      pattern: "(Bank\\s+[Oo]f\\s+India.*?(?:Plan|Funds?|ETF|FOF|FTF|Saver)\\s*(?:of Funds?|FO?o?F)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    "^before": ["_extract_scheme_data", "scheme"],
    "^dummy.*": ["_extract_scheme_data", "scheme2"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(Annualized\\)",
    load: "Entry Load\\s*(Nil|.*?)\\s*Exit Load\\s*(.+?)$",
    manager: {
      fields: ["name", "since", "exp"],
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+(?P<actual_name>[A-Za-z]+\\s[A-Za-z]+)(?:\\s+\\(w\\.e\\.f\\.?s*(?P<wef>[A-Za-z]+\\s*[\\d,\\s]+)\\))?.*?(?P<experience>\\d{1,2}\\s+years)",
    },
    metrics: "(Standard Deviation|Modified Duration|Annualised Yield|Average\\s*\\_?Residual Maturity|Macaulay Duration|Tracking Error|Sharpe Ratio|Beta|R\\s*Squared|Treynor)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%)?)",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    ptr: "([\\d\\.]+\\s*[Tt]imes?)",
    scheme: [
      "INVESTMENT\\s*OBJECTIVE",
      "WHO\\s*SHOULD\\s*INVEST",
      "BENCHMARK",
      "DATE\\s*OF\\s*ALLOTMENT",
      "FUND\\s*MANAGER",
      "AVERAGE\\s*AUM",
      "LATEST\\s*AUM",
      "MINIMUM\\s*APPLICATION\\s*AMOUNT",
      "ADDITIONAL\\s*PURCHASE\\s*AMOUNT",
      "EOL",
    ],
    scheme2: [
      "ADDITIONAL\\s*PURCHASE\\s*AMOUNT",
      "PORTFOLIO TURNOVER\\s*RATIO",
      "OTHER\\s*PARAMETERS",
      "EXPENSE RATIO",
      "LOAD STRUCTURE",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(additional_purchase_amount|application_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*other_parameters?": ["_extract_generic_data", "metrics"],
    ".*portfolio_turn.*": ["_extract_generic_data", "ptr"],
  },
  SELECTKEYS: [
    ".*load_structure",
    ".*(additional_purchase_amount|application_amount|benchmark)",
    ".*average_aum",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "metrics",
    ".*fund_manager",
    ".*date_of_allotment",
    // "benchmark_index",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
