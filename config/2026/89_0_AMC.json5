{
  AMC_NAME: "Pramerica Life Insurance Fund",
  IMP_DATA: {
    amc_name: "Pramerica Life Insurance AMC Limited",
    mutual_fund_name: "Pramerica Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(.+)SFIN",
      bbox: [0, 0, 465, 80],
    },
    clip_bbox: [
      [0, 0, 305, 795],
      [290, 60, 590, 780],
    ],
    port_bbox: [
      {
        bbox: [290, 60, 590, 780],
        support_lines: [480],
        anchor: {
          anchor_t: "Security\\s+Name",
          anchor_b: "Portfolio\\s+Total",
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    method:"clip"
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "\\d+\\,?\\d+\\.\\d+",
    sfin: "\\((.+?)\\)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "SFIN",
      "[A-Za-z]+\\s+[0-9]{4}",
      "Investment Objective",
      "NAV\\s+as\\s+on",
      "Inception\\s+[dD]ate",
      "Fund Manager",
      "Fund\\s*v/s\\s*Benchmark",
      "EOL",
    ],
    metric: {
      key: "(Std\\s+Dev|Sharpe\\s+Ratio|Portfolio\\s+Beta)",
      value: "([\\d.]+\\s*(?:%)?)",
    },
    manager: {
      pattern: "([A-Za-z]+\\s+[A-Za-z]+)",
      fields: ["name"],
    },
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*investment_insight": ["_extract_generic_data", "sfin"],
    ".*nav_as_on": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(inception_date|fund_manager)",
    ".*sfin",
    "metric",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*nav_as_on",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
