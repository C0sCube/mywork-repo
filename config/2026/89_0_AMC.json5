{
  AMC_NAME: "Pramerica Life Insurance Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Pramerica Life Insurance AMC Limited",
    mutual_fund_name: "Pramerica Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(.+)SFIN",
      bbox: [0, 0, 465, 80],
    },
    clip_bbox: [
      [0, 0, 305, 795],
      [290, 60, 590, 780],
    ],
    port_bbox: [
      {
        bbox: [290, 60, 590, 780],
        support_lines: [445, 505],
        anchor_t: null,
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
      },
    ],
    line_x: 200.0,
    data: {
      size: [6, 18],
      color: [23],
      update_size: 30.0,
      font: ["Ubuntu-Bold"],
    },
    content_size: [30.0, 18.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 4,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "[A-Za-z]{3}\\s+\\d{2}\\s+([\\d,.]+)\\s+[Cc]rs?",
    sfin: "\\((.+?)\\)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "SFIN",
      "Investment Objective",
      "NAV as on",
      "Inception Date",
      "Fund Manager",
      "Fund\\s*v/s\\s*Benchmark",
      "NAV as on",
      "Inception Date",
      "Benchmark",
      "AUM as on",
      "Asset Allocation",
      "EOL",
    ],
    metric: {
      key: "(Std\\s+Dev|Sharpe\\s+Ratio|Portfolio\\s+Beta)",
      value: "([\\d.]+\\s*(?:%)?)",
    },
    manager: {
      pattern: "(?:Mr|Mrs|Ms)\\.\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      fields: ["name"],
    },
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_mana": ["_extract_manager_data", "manager"],
    ".*investment_insight": ["_extract_generic_data", "sfin"],
    ".*aum_as_on": ["_extract_generic_data", "aum"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(inception_date|fund_manager|benchmark)",
    "sfin",
    "metric",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    sfin: ".*investment_insight",
    monthly_aaum_value: ".*aum_as_on",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
