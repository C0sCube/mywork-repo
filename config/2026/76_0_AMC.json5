  IMP_DATA: {
    amc_name: "Aviva Life Insurance AMC Limited",
    mutual_fund_name: "Aviva Life Insurance Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: ".+?(?:FUND|Fund)\\s*\\-?\\s*[I]{0,3}",
      bbox: [
        0,
        0,
        365,
        95,
      ],
    },
    clip_bbox: [
      [
        0,
        0,
        470,
        1000,
      ],
    ],
    port_bbox: [
      {
        bbox: [
          470,
          5,
          850,
          1000,
        ],
        support_lines: [
          580,
          770,
        ],
        anchor_t: "Security Name",
        anchor_b: null,
        anchor_r: null,
        anchor_l: null,
        anchor: {
          anchor_t: "Security Name",
          anchor_b: null,
          anchor_r: null,
          anchor_l: null,
        },
      },
    ],
    data: {
      size: [
        5,
        18,
      ],
      color: [
        23,
      ],
      update_size: 30.0,
      font: [
        "Ubuntu-Bold",
      ],
    },
    content_size: [
      30.0,
      18.0,
    ],
    max_financial_index_highlight: 3,
    pdf_ocr: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "[Tt]otal\\s*([\\d,.]+)",
    benchmark: "((?:Russell|Nifty?|BSE|CRISIL|Domestic|\\bICE\\b).+(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Life Unit Linked\\s*[A-Za-z]+\\s*\\d{4}",
      "Fund\\s*[dD]etails",
      "Investment\\s*[oO]bjective",
      "NAV\\s*as\\s*on",
      "Inception\\s*[dD]ate",
      "Fund\\s*[mM]anager",
      "Benchmark\\s*[rR]eturn",
      "Asset\\s*[cC]lass\\s*[wW]ise\\s*AUM",
      "EOL",
      "AUM\\s*\\(in",
      "EOL",
    ],
    manager: {
      pattern: "([A-Z]{1}[a-z]+\\s*[A-Z]{1}[a-z]+)",
      fields: [
        "name",
      ],
    },
    date: "([A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{3,4})",
    escape: "[^a-zA-Z0-9.,\\s\\(\\)\\-\\+\\%\\:\\/]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy.*)": [
      "_extract_scheme_data",
      "scheme",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_mana": [
      "_extract_manager_data",
      "manager",
    ],
    ".*asset_class_wise": [
      "_extract_generic_data",
      "aum",
    ],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*sfin",
    ".*fund_manager",
    ".*inception_date",
    "main_scheme_name",
    "monthly_aaum_date",
    "monthly_aaum_value",
    "page_number",
    "mutual_fund_name",
    "amc_name",
    "portfolio_data",
  ],
  MERGEKEYS: {},
  CLONEKEYS: {
    monthly_aaum_value: ".*asset_class_wise_aum$",
    sfin: ".*life_unit_linked",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}