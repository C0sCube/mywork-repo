{AMC_NAME: "CapitalMind Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "CapitalMind Asset Management Private Limited", mutual_fund_name: "CapitalMind Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Capitalmind.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)", bbox: [0, 0, 600, 120]}, clip_bbox: [[0, 235, 300, 750], [0, 115, 190, 250], [185, 115, 370, 250], [360, 115, 580, 250]], line_x: 590.0, data: {size: [8, 18], color: [0], update_size: 30.0, font: ["Swiss721BT-Bold"]}, content_size: [30.0, 17.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: [], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)", date: "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})", scheme: ["Scheme\\s*Category", "Minimum\\s*Application\\s*Amount", "Systematic\\s*Investment\\s*Plan", "Entry\\s*Load", "Dividend\\s*History", "Exit\\s*Load", "Total\\s*Expense\\s*Ratio", "Quantitative\\s*Measures", "EOL", "Month-end\\s*AUM", "AAUM", "Date\\s*of\\s*Allotment", "Benchmark", "Market Cap", "EOL", "Fund\\s*Managers", "EOL"], metrics: "(YTM|Macaulay Duration|Yield\\s*to|average maturity|Modified Duration|Tracking\\s*Error|Portfolio\\s*Turnover)\\s*\\-?\\:?\\s*(-?\\d+\\.?\\d*\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)", min_amt: "([\\d,]+).*?(\\d+|any)", load: "Entry Load(.*)Exit Load(.*)$", manager: {pattern: "(?:Mr|Mrs|Ms)\\.?\\s*([\\w\\s]+)\\s*(?:\\([A-Za-z\\s]+\\))?\\s*\\(\\s*[Mm]anaging.+?since([A-Za-z0-9\\s]+)\\s*overal.+?of\\s*(\\d{1,2}\\+? [Yy]ears?)\\)", fields: ["name", "since", "exp"], name: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)", exp: "Total\\s*Experience\\s*([0-9]+\\s*[Yy]ears?)", since: "fund\\s*since\\s*([A-Za-z]+\\s+\\d{4})"}, escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)"}, PAT