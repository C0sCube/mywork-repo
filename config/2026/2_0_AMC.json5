{
  AMC_NAME: "Baroda Bnp Paribas Mutual Fund",
  CLONEKEYS: {},
  DUPLICATE_MUTUAL_FUNDS: {},
  IMP_DATA: {
    amc_name: "Baroda BNP Paribas Asset Management India Private Limited",
    mutual_fund_name: "Baroda BNP Paribas Mutual Fund",
  },
  MAIN_MAP: {
    map: true,
    select: true,
    special: true,
  },
  MERGEKEYS: {
    load: [".*(exit_?load|entry_?load)"],
    // metrics: [".*key_statistics$", ".*quantitative.*$", ".*expense_ratio$"],
  },
  PARAMS: {
    clip_bbox: [[0, 100, 205, 800]],
    content_size: [30, 8],
    data: {
      color: [-1],
      font: ["Unnamed-T3"],
      size: [9, 10],
      update_size: 30,
    },
    line_side: "left",
    line_x: 210,
    max_financial_index_highlight: 4,
    method: "clip",
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
    title: {
      bbox: [0, 0, 220, 120],
      ocr: false,
      pattern: "(Baroda\\s*BNP.*?(?:Fund|Path|ETF|F[Oo]F|Index|Plan)\\s*(?:Funds?|of [Ff]und?|Fund of [Ff]unds?)?)",
    },
    update_min_add: false,
  },
  PATTERN_TO_FUNCTION: {
    before: ["_extract_scheme_non_esc_data", "scheme"],
  },
  PRE_DATA_SELECT: [],
  PROMOTE_KEYS: {},
  REGEX: {
    aum: "([\\d,.]+\\s*crores?)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(TRI\\)|TRI|Total\\s*Returns?\\s*Index",
    load: "(?:Entry Load)?(.*?)Exit Load\\s*(.*)$",
    lumpsum: ".+Lumpsum investment(.+?)Minimum Additional Purchase Amount(.+?)$",
    manager: {
      fields: ["name", "since", "exp"],
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s+(\\d{2}-[A-Za-z]{3}-\\d{2})\\s+(\\d+\\s*years?)",
    },
    metric: "(RoE\\D+|Average\\s*Maturity|Macaulay\\s*Duration|Tracking Error\\s*(?:Regular)?|Modified\\s*Duration|YTM\\D*|Portfolio\\s*Turnover\\s*Ratio|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|Tracking\\s*Error\\s*Direct)\\s*[\\:\\-]?\\s*(\\(?\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?\\s*\\)?\\s*[\\:\\-]?\\s*-?\\d+\\.?\\d*\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    min_amt: "([\\d,]+)\\s*and\\s*in\\s*multiples\\s*of\\s*([\\d,]+)",
    scheme: [
      "NAV\\s+Details",
      "Benchmark Index",
      "Date\\s+[Oo]f\\s+[aA]llotment",
      "Monthly\\s+AAUM\\s+[Aa]s\\s+[Oo]n",
      "AUM\\s+[Aa]s\\s+[Oo]n",
      "Fund\\s+Manager",
      "Load\\s+Structure",
      "Exit\\s*[Ll]oad",
      "Expense\\s+[rR]atio",
      "Minimum\\s*[aA]mount",
      "Minimum\\s*[aA]dditional\\s*[pP]urchase\\s*[aA]mount",
      "EOL",
      "Minimum\\s*Application\\s*Amount",
      "Minimum\\s*Additional\\s*Application\\s*Amount",
      "EOL",
    ],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_?amount|minimum_?additional_?purchase_?amount|minimum_?application_?amount|minimum_?additional_?application_?amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*(quantitative.*|key_statistics|expense_ratio)$": [
      "_extract_generic_data",
      "metric",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*monthly_aaum": ["_extract_generic_data", "aum"],
  },
  SELECTKEYS: [
    ".*benchmark_index",
    ".*date_of_allotment",
    ".*monthly_?aaum",
    ".*fund_manager",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "mutual_fund_name",
    "page_number",
    ".*(minimum_amount|minimum_?additional_?purchase_?amount|minimum_?application_?amount|minimum_?additional_?application_?amount)",
  ],
  SPECIAL_FUNCTIONS: {},
  TERTIARY_PATTERN_TO_FUNCTION: {},
  Z_MUTUAL_FUND_DATA: {},
}
