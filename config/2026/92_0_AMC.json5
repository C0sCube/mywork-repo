  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(^.+?)SFIN",
      bbox: [
        120,
        0,
        495,
        160,
      ],
    },
    clip_bbox: [
      [
        0,
        95,
        200,
        825,
      ],
      [
        120,
