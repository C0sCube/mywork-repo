{AMC_NAME: "Old Bridge Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Old Bridge Asset Management Private Limited", mutual_fund_name: "Old Bridge Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(OLD BRIDGE.+?(?:FUND))", bbox: [0, 0, 520, 80]}, clip_bbox: [[0, 160, 270, 700], [270, 160, 600, 700]], line_x: 270.0, data: {size: [8, 14], color: [-11614235, -14475488], update_size: 30.0, font: ["Montserrat-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 10, pdf_ocr: false, sanitize_fund: false, stop_words: [], update_min_add: false}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {benchmark: "(.+?TRI)", aum: "([\\d.]+)", scheme: ["Scheme Category", "Benchmark", "Inception Date", "Face Value", "Minimum Investment Amount", "Minimum Additional Subscription Amount", "Minimum Redemption Amount", "SIP Frequency", "Fund Manager", "Entry Load", "Exit Load", "Holdings", "EOL", "Direct Plan", "Monthly", "Avg AUM", "Equity Turnover", "Total Turnover", "NAV", "EOL"], min_amt: "([\\d,]+).*?([\\d]+)", manager: {pattern: "([A-Za-z.]+(?:\\s+[A-Za-z.]+)+)\\s*\\(Managing since\\s*(Inception).*?experience\\s+(\\d+\\s+years)\\)", fields: ["name", "since", "exp"]}, escape: "[^a-zA-Z0-9\\.\\,\\(\\)\\s\\-\\+\\%]+"}, PATTERN_TO_FUNCTION: {"^(fund_features|scheme_details|dummy.*)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*benchmark": ["_extract_generic_data", "benchmark"], ".*(minimum_investment_amount|minimum_additional_subscription)": ["_extract_amt_data", "min_amt"], ".*monthly": ["_extract_generic_data", "aum"], ".*fund_manager": ["_extract_manager_data", "manager"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["amc_name", "main_scheme_name", "mutual_fund_name", "page_number", "monthly_aaum_date", "metrics", "dummy.*?monthly$", ".*(fund_manager|minimum_investment_amount|minimum_additional_subscription)", ".*(benchmark|inception_date)", "load"], MERGEKEY