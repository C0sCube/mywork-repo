{
  AMC_NAME: "Lic Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "LIC Mutual Fund Asset Management Limited",
    mutual_fund_name: "LIC Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: true,
      pattern: "((?:LI?i?C|BSE|BANK|SMALL|HEALTH|MNEY|[aA]n\\s*open).*?(?:FUND|Path|ETF|FTF|EOF|FOF|PLAN|SAVER|tax saving scheme|small cap stocks)\\s*(?:FUND\\s*OF\\s*FUND)?)",
      bbox: [300, 0.00, 595, 80],
    },
    clip_bbox: [[0, 80, 210, 812]],
    line_x: 210.0,
    data: {
      size: [6, 12],
      color: [666],
      update_size: 30.0,
      font: ["Arial-BoldMT"],
    },
    content_size: [30.0, 16.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*crs?)",
    load: "(?:Entry Load)?\\s*(Nil|.*?)\\s*Exit Load\\s*(.*)$",
    min_amt: "([\\d,]+).*?([\\d,]*)",
    scheme: [
      "Scheme Type",
      "Date\\s+of\\s+[aA]llotment",
      "Fund Size",
      "Average AUM",
      "Load Structure",
      "Entry Load",
      "Exit Load",
      "Benchmark\\s*:?",
      "Minimum Investment",
      "Fund\\s*M\\s*anager\\s*:?",
      "NAV",
      "EOL",
    ],
    metric: "(Portfolio Turnover Ratio|Standard Deviation|Portfolio Beta|Sharpe Ratio|Average Maturity|Macaulay Duration|Tracking Error|Modified Duration|Yield to Maturity\\D*)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)",
    manager: {
      pattern: "(?:Mr.|M\\s*.|Mrs.|Ms.)\\s*([\\w\\s]+)\\s*(?:\\((.+?)\\))?\\s*Total Experience\\s*\\:?\\s*([\\d.]+\\+?\\s*years?)",
      fields: ["name", "exp","since"],
      name: "(?:Mr.|Mrs.|Ms.|M .)\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "(\\d+.?\\d*\\+?\\s*years?)",
      since:"(LOL)"
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: { "^before": ["_extract_scheme_data", "scheme"] },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*nav$": ["_extract_generic_data", "metric"],
    ".*minimum_investment": ["_extract_amt_data", "min_amt"],
    ".*average_aum": ["_extract_generic_data", "aum"],
    ".*fund.+?ger": ["_update_manager_data", null],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(date_of_allotment|benchmark)",
    "load",
    "monthly_aaum_value",
    ".*average_aum",
    ".*minimum_investment",
    ".*fund.+?ger",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
  ],
  MERGEKEYS: {
    // fund_manager: [".*fund_managers?"],
    load: [".*(exit_load|entry_load)"],
    metrics: [".*nav"],
  },
  CLONEKEYS: { monthly_aaum_value: ".*average_aum\\s*_?\\s*for$" },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
  Z_MUTUAL_FUND_DATA: {},
}
