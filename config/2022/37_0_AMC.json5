{
  AMC_NAME: "Sundaram Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Sundaram Asset Management Company Limited",
    mutual_fund_name: "Sundaram Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Sundaram.+?(?:Focus|Opportunities?|Equity\\s*(?:Hybrid\\s*Fund|Savings?\\s*Fund)?|Funds?|Plan|Path|ETF|F[Oo]F|Cap)\\s*\\-?\\s*(?:of Funds?|Funds?|F[Oo]F|Fund of [Ff]unds?)?\\s*(?:\\s*Series\\s*[IVXLCDM&\\-\\s]+)?)",
      bbox: [0, 15, 570, 55],
    },
    clip_bbox: [
      [0, 60, 205, 840],
      [345, 55, 570, 840],
    ],
    line_x: 220.0,
    data: {
      size: [6, 13],
      color: [666],
      update_size: 30.0,
      font: ["UniversNextforMORNW02-Cn"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    nav: "(Growth|IDCW)\\s*(-?[\\d,.]+)\\s*(-?[\\d,.]+)",
    decimal: "([\\d,.]+) Cr.",
    metric: "(Alpha|Sortino\\s*Ratio|Arithmetic\\s*Mean|Treynor\\s*Ratio|Tracking\\s*Error|Information Ratio|Turnover Ratio|Standard Deviation|Beta|Sharpe Ratio|Avg\\s*Maturity\\D*|Average Maturity\\D*|Modified Duration\\D*|YTM\\D*|Macaulay\\s*Duration\\D*)\\s*\\:?\\s*(-?[\\d.,]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?|%)?)",
    scheme: [
      "Category",
      "Fund\\s*[Tt]ype",
      "Benchmark\\s*(?:TRI)?",
      "Fund\\s*Manager",
      "Investment Objective",
      "Av[era]*ge?\\s*AUM",
      "Month\\s*End\\s*AUM",
      "EOL",
      "Performance\\s*Analysis",
      "EOL",
    ],
    min_amt: "([\\d,]+).*?([\\d,]+)",
    manager: {
      pattern: "([A-Za-z]+\\s*[A-Za-z]+)\\s*has.*?(?:around|about|of)?\\s*([0-9]+\\s*[Yy]ears?).+?(?:since)\\s*([A-Za-z]+\\s*\\d{4}|inception)",
      fields: ["name", "exp", "since"],
    },
    load: "^()(.*$)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(scheme|before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_managers?": ["_extract_manager_data", "manager"],
    ".*(performance_analysis|month_end_aum|investment_objective)": [
      "_extract_generic_data",
      "metric",
    ],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "load",
    "metrics",
    ".*minimum_amount",
    "benchmark_index",
    ".*(inception_date|av[era]*ge?_aum|fund_managers?)",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    ".*weighted_avg",
    "mutual_fund_name",
  ],
  MERGEKEYS: {
    metrics: [
      "metrics",
      ".*investment_objective",
      ".*weighted_avg",
      ".*performance_analysis",
      ".*month_end_aum",
    ],
    load: [".*exit_load"],
  },
  CLONEKEYS: { benchmark_index: "before.benchmark.*" },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
