{
  AMC_NAME: "Franklin Templeton Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Franklin Templeton Asset Management (India) Private Limited",
    mutual_fund_name: "Franklin Templeton Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "((?:Franklin|Templeton).*?(?:Taxshield|Funds?|Plan|ETF|F[Oo]F)\\s*(?:of\\s*Funds|Fund of Funds?|F[Oo]F|.+?Plan)?\\s*(?:\\(Number of Segregated Portfolio.+?\\))?)",
      bbox: [0, 0, 470, 80],
    },
    clip_bbox: [[0, 80, 180, 812]],
    line_x: 180.0,
    data: {
      size: [6, 9],
      color: [-1],
      update_size: 30.0,
      font: ["ZurichBT-BoldCondensed"],
    },
    content_size: [30.0, 12.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 6,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    scheme: [
      "TYPE\\s*OF\\s*SCHEME",
      "SCHEME\\s*CATEGORY",
      "INVESTMENT\\s*OBJECTIVE",
      "DATE OF ALLOTMENT",
      "FUND MANAGER",
      "BENCHMARK",
      "NAV AS OF",
      "FUND\\s*SIZE",
      "EXPENSE RATIO",
      "MINIMUM\\s*INVESTMENT.+?INVESTORS",
      "INVESTMENT\\s*FOR\\s*SIP",
      "ADDITIONAL\\s*INVESTMENT",
      "LOAD STRUCTURE",
      "EOL",
      "BENCHMARK",
      "FUND\\s*SIZE",
      "NAV AS OF",
      "EOL",
    ],
    benchmark: "(.+?)\\s*(?:FUND SIZE\\s*\\(AUM|$)",
    metric: "(MACAULAY DURATION|AVERAGE\\s*MATURITY|RESIDUAL\\s*MATURITY\\D*|ANNUALISED\\s*PORTFOLIO\\s*YTM|PORTFOLIO\\s*YIELD|MODIFIED DURATION|Tracking Error.+?Period\\D*|Monthly Average|Sharpe Ratio|Standard Deviation|Beta|Portfolio Turnover)\\s*\\:?\\s*(-?[\\d\\,\\.]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)",
    load: "ENTRY LOAD(.*?)\\s*EXIT LOAD\\s*(.*?)$",
    min_amt: "([\\d,]+).*?([\\d,]+)",
    manager: {
      pattern: "\\b(?:[A-Z]\\.|[A-Z][a-z]+)(?:\\s(?:[A-Z]\\.|[A-Z][a-z]+)){1,2}\\b(?![^()]*\\))",
      fields: ["name"],
    },
    ptr: "(Portfolio\\s*Turnover(?:\\s*\\(Equity\\d*\\))?)\\s*(\\d{1,3}(?:,\\d{3})*\\.\\d+)%?",
    escape: "[^A-Za-z0-9\\/\\s\\-\\(\\).,\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(dummy.*|before)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(additional_investment|minimum_investment.*)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*(fund_size|expense_ratio)": ["_extract_generic_data", "metric"],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*date_of_allotment",
    ".*fund_manager",
    ".*benchmark",
    ".*(minimum_investment_amount|additional_investment)",
    "load",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
  ],
  MERGEKEYS: {
    metrics: [".*fund_size", ".*expense_ratio"],
    load: [".*load_structure"],
    minimum_investment_amount: [".*multiples_for_new_investors"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: { metrics: { monthly_aaum_value: "^monthly.+?verage" } },
  SPECIAL_FUNCTIONS: {},
}
