{AMC_NAME: "Shriram Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Shriram Asset Management Company Limited", mutual_fund_name: "Shriram Mutual fund"}, PARAMS: {title: {ocr: true, pattern: "(SHRIRAM.+?(?:FUNDS?|ETF|INDEX)\\s*(?:OF FUNDS?|Fo?O?F)?)", bbox: [0, 0, 445, 60]}, clip_bbox: [[0, 50, 205, 850], [295, 0, 585, 850]], line_x: 290.0, data: {size: [6, 15], color: [0], update_size: 30.0, font: ["Poppins-SemiBold"]}, content_size: [30.0, 8.0], method: "clip", line_side: "", max_financial_index_highlight: 3, pdf_ocr: true, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(?:Net|Latest)\\s*AUM\\D*([\\d.]+\\s*cr)", benchmark: "^.+?(?:Index|TRI)", date: "(\\d{1,2}\\s*(?:th|st|rd|nd)?\\s*[A-Za-z]+\\s*,?\\s*\\d{3,4})", scheme: ["About the Fund", "Date of Inception", "Average AUM", "Latest AUM", "Benchmark", "Loads", "Minimum Investment", "EOL", "Quantitative Data", "EOL", "Date\\s*of\\s*Inception", "Fund Managers", "As\\s*on\\s*[A-Za-z]+\\s*\\d{2}\\,?\\s*\\d{4}", "EOL"], ptr: "([\\d.]+)", min_amt: "Rs\\.?\\s*([\\d,]+)\\D*(\\d+)", manager: {pattern: "(?:Mr\\.?|Ms\\.?)\\s*([\\w\\s]+)\\(Since\\s*([A-Za-z\\s,0-9]+?)\\)\\D*?Experience\\D*?(\\d{1,2} years)", fields: ["name", "since", "exp"]}, metrics: "(Portfolio Turnover Ratio\\D*|Standard Deviation|Portfolio Beta|Sharpe Ratio|Information Ratio|Average Maturity|Residual Maturity\\D*|Modified Duration\\D*|Macaulay Duration\\D*|Annualised Portfolio YTM\\D*|Yield to Maturity)\\s*(-?[\\d.]+\\s*(?:years?|days?|months?|%)?)", load: "Entry\\s*Load(.+?)Exit\\s*Load(.+)$", escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\-\\%]+|\\(Annualised\\)"}, PATTERN_TO_FUNCTION: {"^(before|dummy).*": ["_extract_scheme_non_esc_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*load": ["_extract_load_data", "load"], ".*(quantitative|expense_ratio|as_on_.*|latest_aum)": ["_extract_generic_data", "metrics"], ".*date_of_inception": ["_extract_manager_data", "mana