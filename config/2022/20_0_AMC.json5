{
  AMC_NAME: "IndiaBulls Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "IndiaBulls Asset Management Company Limited",
    mutual_fund_name: "IndiaBulls Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(India[Bb]ulls.*?(?:FUNDS?|Funds?|ETF|PLAN|PATH|Funds?|Plan|Path)\\s*(?:F[oO]F|FUND OF FUNDS?|OF FUNDS?|FUNDS?|of [Ff]unds?|Fund of Funds?)?)",
      bbox: [0, 0, 470, 60],
    },
    clip_bbox: [[0, 100, 180, 812]],
    line_x: 220.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["NunitoSans7pt-ExtraBold"],
    },
    content_size: [30.0, 15.0],
    method: "line",
    line_side: "left",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "(Monthly Average AUM|Month end AUM)\\s*([\\d,.]+\\s*crore)",
    date: "\\(Date of Allotment\\)\\s*(.+)$",
    scheme: [
      "Inception Date",
      "Benchmark",
      "Fund Manager",
      "Minimum\\s*Investment\\s*Amount",
      "Minimum\\s*Additional\\s*Investment",
      "Load Structure",
      "Entry Load",
      "Exit Load",
      "Maturity and Yield|Quantitative.+?Measures",
      "Fund Size",
      "Monthly Average AUM",
      "Month End AUM",
      "NAV of Plans",
      "EOL",
    ],
    min_amt: "([\\d,]+).*?([\\d,]+)",
    metrics: {
      key: "(Standard|Sharpe|Portfolio|Beta|R\\s*Square|Modified|Average|Macaulay|Annuali[sz]ed|YTM)",
      value: "(-?\\d+\\.?\\d+\\s*(?:[Dd]ays?|[Yy]ears?|[Mm]onths?|%|[Tt]imes?)?)",
    },
    manager: {
      pattern: "(?:Mrs?\\.?) ([A-Za-z]+\\s[A-Za-z]+) \\(Managing.+?([A-Za-z]+ \\d{1,2}\\, \\d{4})\\).+?Experience: (\\d{1,2} [Yy]ears?)",
      fields: ["name", "since", "exp"],
    },
    load: "Entry Load\\s*(.+?)\\s*Exit Load\\s*(.+)$",
    escape: "[^A-Za-z0-9\\/\\s\\-\\(\\)\\.\\,\\+\\%\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    before: ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_investment|minimum_additional).*$": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*(maturity.*$|measures$)": ["_extract_iter_data", "metrics"],
    ".*inception_date": ["_extract_generic_data", "date"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(minimum_investment_amount|minimum_additional_investment)$",
    "amc_name",
    ".*fund_manager",
    ".*(benchmark|inception_date)",
    ".*monthly_average_aum",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "metrics",
    "load",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    "metrics":[".*(maturity.*$|measures$)"]
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
