{AMC_NAME: "Edelweiss Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Edelweiss Asset Management Limited", mutual_fund_name: "Edelweiss Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(.+?(?:Nifty\\s*(?:50|100\\s*Quality\\s*30|Bank)|Fund|Path|ETF(?:\\s*\\-?\\s*(?:Nifty 50|Nifty Bank|Nifty 100 Quality 30)?)?|F[Oo]F|Path|Plan)\\s*(?:[Ff]und of [Ff]unds?|of [Ff]unds?|[Ff]unds?|[A-Za-z\\s]+\\s*[0-9]+)?)", bbox: [0, 0, 400, 90]}, clip_bbox: [[420, 0, 612, 812]], line_x: 410.0, data: {size: [5, 15], color: [0], update_size: 30.0, font: ["Roboto-Bold"]}, content_size: [30.0, 15.0], method: "clip", line_side: "right", max_financial_index_highlight: 6, pdf_ocr: false, sanitize_fund: true, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: ["^before.*"], REGEX: {metric: "(Sharpe Ratio|Standard Deviation|Beta|Annualised)\\s*\\:?\\s*(-?[\\d,]+\\.\\d+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|%|[Tt]imes?)?)", date: "(\\d{1,2}\\-[A-Za-z]+\\-\\d{2})", min_amt: "([\\d,]+).*?([\\d,]+)", aum: "Crore\\s*[\\d,\\s.Rs]+\\s*Crore\\s*([\\d,.]+)", scheme: ["Inception Date", "Fund Managers Details", "Benchmark", "Fund Size", "Monthly Average AUM", "NAV.+?as on", "Minimum Investment Amount", "Additional investment amount", "Exit Load", "Total Expense Ratios", "EOL", "Minimum Investment Amount", "Creation Unit Size", "Exit Load", "NAV.+?as on", "Minimum Creation Unit Size", "Exit Load"], scheme2: ["Quantitative indicators", "Fund Performance", "EOL"], manager: {pattern: "(?:Mr\\.|Ms\\.|mrs\\.)\\s*([A-Za-z\\s]+)\\s*(\\d{1,2}\\s*years)\\s*(\\d{1,2}\\s*\\-\\s*[A-Za-z]+\\s*\\-\\s*\\d{1,2})", fields: ["name", "exp", "since"]}, escape: "[^A-Za-z0-9\\s\\-\\(\\).,\\+\\%]+"}, PATTERN_TO_FUNCTION: {"^before.*": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(minimum_investment|additional_investment)": ["_extract_amt_data", "min_amt"], ".*inception_date": ["_extract_generic_data", "date"], ".*monthly_average_aum": ["_extract_generic_data", "aum"], ".*fund_manager": ["_extract_manager_data", "manager"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["before.inception_date", "fund_manager", ".*benchmark", ".*monthly_average_aum", ".*(minimum_investment_amount|additional_investment_amount)", "load", "metrics", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name"], MERGEKEYS: {load: [".*exit_load"], fund_manager: [".*fund_manager"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}