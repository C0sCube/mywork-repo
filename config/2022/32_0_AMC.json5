{
  AMC_NAME: "Quantum Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Quantum Asset Management Company Private Limited",
    mutual_fund_name: "Quantum Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(QUANTUM.+?(?:FUNDS?|ETF|PATH|.+?PLAN|SAVER)\\s*(?:FUND\\s+OF\\s+FUNDS?|FUNDS?|OF\\s+FUNDS?|F[oO]F)?)",
      bbox: [0, 0, 200, 260],
    },
    clip_bbox: [
      [250, 0, 570, 835],
      [0, 260, 250, 835],
    ],
    line_x: 180.0,
    data: {
      size: [6, 15],
      color: [666], //-23
      update_size: 30.0,
      font: ["Prompt-SemiBold"],
    },
    content_size: [30.0, 15.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 3,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "(Average AUM|Absolute AUM)\\s*([\\d,.]+)",
    load: "Entry Load\\s*(.*?)\\s*Exit Load\\s*(.*?)$",
    scheme: [
      "Scheme Features",
      "Fund Manager",
      "Category of Scheme",
      "Inception Date",
      "Declaration of Net Asset Value",
      "Entry.+?Sales Load",
      " Total Expense Ratio",
      "Benchmark Index",
      "Minimum Application Amount",
      "Additional Purchase",
      "EOL",
      "Minimum Application Amount",
      "Additional Purchase",
      "Redemption Proceeds",
      "EOL",
      "Total Expense Ratio",
      "Portfolio Turnover Ratio",
      "EOL",
    ],
    scheme2: [
      "Investment Options",
      "Redemption Proceeds",
      "Exit Load",
      "Taxation",
      "Average AUM",
      "Cumulative Daily AUM",
      "EOL",
    ],
    scheme3: ["Key Statistics|Weighted Average Maturity", "EOL"],
    ptr: "([\\d\\.]+\\s*(?:%)?|NA)",
    manager: {
      pattern: "(?:Mrs|Ms|Mr)\\.? ([A-Za-z]+\\s[A-Za-z]+) Work [Ee]xperience\\s*(\\d+\\.?\\d* [Yy]ears?).+?fund since (\\w+.+?\\d{4})",
      fields: ["name", "exp", "since"],
    },
    min_amt: "([\\d,]+)-?\\D+?([\\d]+)-?",
    metric: "(Residual Maturity\\D*|Average Maturity.+?of the Month|Annualised Portfolio YTM|Modified Duration|Macaulay\\s*s? Duration|Standard Deviation|Beta\\D*|Sharpe Ratio\\D*|Tracking Error|Alpha)\\s*(-?[\\d.]+\\s*(?:[Tt]imes?|[Dd]ays?|[Mm]onths?|[Yy]ears?|%)?)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\&]+|\\(Annualised\\)|\\(\\s*Date\\s*of\\s*Allotment\\s*\\)",
  },
  PATTERN_TO_FUNCTION: {
    before: ["_extract_scheme_data", "scheme"],
    "dummy.*one$": ["_extract_scheme_data", "scheme3"],
    "dummy.*two$": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_application_amount|additional_purchase)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*(key_statistics|portfolio_information|metric|average_maturity)$": [
      "_extract_generic_data",
      "metric",
    ],
    ".*portfolio_turnover_ratio": ["_extract_generic_data", "ptr"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(inception_date|benchmark_index)",
    "load",
    "amc_name",
    ".*average_aum",
    ".*fund_manager",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "metrics",
    ".*(minimum_application_amount|additional_purchase)",
  ],
  MERGEKEYS: {
    load: [".*entry_sales_load", ".*exit_load"],
    metrics: [
      ".*key_statistics$",
      "metrics",
      ".*portfolio_turnover_ratio",
      ".*portfolio_information$",
      ".*average_maturity$"
    ],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
