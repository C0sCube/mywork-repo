{
  AMC_NAME: "Sbi Mutual Fund Passive",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "SBI Funds Management Limited",
    mutual_fund_name: "SBI Mutual Fund",
  },
  PARAMS: {
    title: { ocr: false, pattern: "(An\\s*[Oo]pen.+$)", bbox: [0, 0, 580, 65] },
    clip_bbox: [[0, 120, 165, 765]],
    line_x: 290.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["HelveticaNeue-Medium"],
    },
    content_size: [30.0, 10.0],
    method: "line",
    line_side: "both",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "([\\d,.]+\\s*crores?)",
    benchmark: "((?:Nifty|Domestic|Price|CRISIL|BSE).+?(?:TRI|Index|Silver|Gold))",
    scheme: [
      "Inception Date",
      "AAUM for the Month",
      "AUM as on",
      "Benchmark\\/?Underlying Index",
      "Load Structure",
      "Exchange Listed|Exchange Platform|Plans Available",
      "Minimum Investment",
      "Additional Investment|EOL",
      "EOL",
    ],
    manager: {
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([A-Za-z]+\\s*[A-Za-z]+).*?managing.*?([A-Za-z]+\\s*\\d{3,4})\\s*Total Experience (?:Over|Around)\\s*([0-9]+\\s*years)",
      fields: ["name", "since", "exp"],
    },
    min_amt: "([\\d.,]+)\\D*(?:multiple)\\D*(\\d+)",
    load: "(?:Entry)?(.+)Exit(.+)$",
    metrics: "(Modified Duration|Average Maturity|Macaulay Duration|Yield to Maturity|Standard Deviation|Beta|Sharpe Ratio|Total Turnover|Tracking Error\\s*[0-9]*-?year)\\s*([\\d,.]+\\s*(?:years?|months?|days?)?)",
    escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%]+",
  },
  PATTERN_TO_FUNCTION: { scheme_details: ["_extract_scheme_data", "scheme"] },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*aaum_for.*": ["_extract_generic_data", "aum"],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*(minimum_investment|additional_investment)": [
      "_extract_amt_data",
      "min_amt",
    ],
    "(metrics|portfolio_turnover_ratio)": ["_extract_generic_data", "metrics"],
    ".*benchmark.+?index": ["_extract_generic_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*inception_date",
    ".*aaum_for",
    ".*benchmark.+$",
    "fund_manager",
    ".*load_structure",
    ".*minimum_investment",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_value",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "load",
  ],
  MERGEKEYS: {
    load: [".*exit_load", ".*entry_load"],
    fund_manager: ["^fund_manager", "^fund_manager_bravo"],
    metrics: ["^metrics", "^portfolio_turnover.*"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { fund_manager: "_update_manager_data" },
}
