{
  AMC_NAME: "Hdfc Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "HDFC Asset Management Company Limited",
    mutual_fund_name: "HDFC Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(HDFC.*?(?:FUND|Fund\\s*(?:of Funds?)?|ETF\\s*(?:Fund of Funds?)?))",
      bbox: [0, 0, 400, 60],
    },
    clip_bbox: [
      [0, 70, 195, 812],
      [370, 100, 570, 812],
    ],
    line_x: 200.0,
    data: {
      size: [5, 13],
      color: [666],
      update_size: 30.0,
      font: ["Taz-SemiBold", "Cambria-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    sanitize_fund: false,
    pdf_ocr: false,
    stop_words: [],
    update_min_add: false,
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "of\\s*[A-Za-z]+\\s*2021\\s*([\\d,]+\\.\\d+)",
    track: ".+?months\\s*(?:regular)?\\s*([\\d.]+)",
    escape: "[^A-Za-z0-9\\/\\s\\-\\(\\)\\.\\,\\+\\%\\&]+|\\([dD]ate of [aA]llotment\\)",
    scheme: [
      "investment objective",
      "Fund Manager",
      "Inception Date",
      "NAV",
      "[aA]SSETS UNDER MANAGEMENT",
      "Average for Month",
      "quantitative data",
      "TOTAL EXPENSE RATIO",
      "BENCHMARK INDEX",
      "addl.\\s+BENCHMARK INDEX",
      "Exit Load",
      "[pP]lan[sS].+?[oO]ptions",
      "Minimum Application Amount",
      "Additional Purchase",
      "EOL",
    ],
    load: "",
    date:"\\(Date of Allotment\\)\\s+(.+$)",
    manager: "",
    min_amt: "([\\d,]+).*?([\\d,]+|any)",
    metric: "(Average Maturity|Turnover Ratio\\s*\\(.+?\\)|Total Turnover|Standard Deviation|Beta|Sharpe Ratio|Residual Maturity|Macaulay Duration|Modified Duration|Annualized Portfolio YTM|Yield to Maturity)\\s*([\\d,.]+\\s*(?:years|days|months)?)",
  },
  PATTERN_TO_FUNCTION: {
    "(before|dummy.*)": ["_extract_scheme_non_esc_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*quantitative_data": ["_extract_generic_data", "metric"],
    ".*average_for_month": ["_extract_generic_data", "aum"],
    // "before.inception_date": ["_extract_generic_data", "date"],
    ".*(minimum_application_amount|additional_purchase)":["_extract_amt_data","min_amt"]
    // tracking_error: ["_extract_generic_data", "track"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*fund_manager",
    ".*(additional_purchase|minimum_application_amount)",
    ".*(benchmark_index|average_for_month)$",
    "before.inception_date$",
    "metrics",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "load",
  ],
  MERGEKEYS: {
    load: ["exit_load"],
    metrics: ["metrics", "tracking_error", ".*quantitative_data"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { fund_manager: "_update_manager_data" },
