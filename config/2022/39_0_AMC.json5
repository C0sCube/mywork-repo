{AMC_NAME: "Taurus Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Taurus Asset Management Company Limited", mutual_fund_name: "Taurus Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "((?:TAURUS|Taurus).+?(?:FUNDs?|SHIELD|Funds?|ETF|Path|.+?Plan|F[oO]F|Saver)\\s*(?:Funds?|of Funds?|Fund of Funds?|F[oO]F|.+?Plan)?)", bbox: [0, 0, 560, 70]}, clip_bbox: [[0, 65, 205, 840]], line_x: 205.0, data: {size: [6, 12], color: [-1], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(Monthly Average AUM)\\s*([\\d,.]+\\s*Cr)", scheme: ["Investment\\s*Objec.*?ve", "Fund Manager", "Date of Allotment", "Benchmark", "Monthly AUM", "Monthly Average AUM", "Month End AUM", "Entry Load", "Exit Load", "Minimum\\s*Applica.*?on\\s*Amount", "Net Asset Value", "Quan.*?ta.*?ve\\s*Data", "DIVIDEND HISTORY", "EOL"], min_amt: "([\\d,]+).*?([\\d,]+)", manager: {pattern: "(?:[Mm][rs]+\\.?)\\s*([\\w\\s]+)\\s*\\(\\s*w\\.?e\\.?f\\.?\\s*(.+?)\\)\\s*Total.+?rience\\s*\\:\\s*(\\d{2}\\s*(?:years?|yrs?))", fields: ["name", "since", "exp"]}, load: "Entry Load\\s*(.*?)\\s*Exit Load\\s*(.*)$", metric: "(Port?f?olio Turnover|Standard Deviation|Standard\\s*Deviat?i?on|Modif?i?ed Duration|Annualised Yield|Macaulay Duration|Tracking Error|Sharpe Rat?i?o|Beta|R Squared|Treynor|YTM)\\s*(?:\\:|\\-)?\\s*(-?[\\d,.]+\\s*(?:[Yy]ears?|[mM]onths?|[Dd]ays?|[Tt]imes?|%)?)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\&\\:]+|\u00b7"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*minimum.+?amount": ["_extract_amt_data", "min_amt"], "(.*metrics|.*quantitative_data)": ["_extract_generic_data", "metric"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*date_of_allotment", ".*benchmark", ".*monthly_average_aum$", "monthly_aaum_date", "mutual_fund_name", "amc_name", "minimum_application_amount", "main_scheme_name", "metrics", "load", "page_number", "benchmark_index"], MERGEKEYS: {load: [".*load"], metrics: [".*metrics", ".*quant.+?data"]}, CLONEKEYS: {minimum_application_amount: ".*minimum.+?amount"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}