{
  AMC_NAME: "Canara Robeco Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Canara Robeco Asset Management Company Limited",
    mutual_fund_name: "Canara Robeco Mutual Fund",
  },
  PARAMS: {
    title: { ocr: false, pattern: "CANARA.*?\\)", bbox: [0, 0, 460, 80] },
    clip_bbox: [
      [20, 120, 215, 812],
      [215, 120, 400, 812],
    ],
    data: {
      size: [8, 11],
      update_size: 30.0,
      font: ["Taz-SemiLight"],
      color: [-1],
    },
    content_size: [30.0, 10.0],
    line_x: 180.0,
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 0,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    benchmark: "(.+?)\\s*\\d*\\s*(?:FUND\\s*MANAGER|Source ICRA)",
    scheme: [
      "SCHEME OBJECTIVE",
      "Monthend AUM",
      "Monthly\\s*AVG\\s*AUM",
      "NAV",
      "DAT.+?ALLOTMENT",
      "ASSET ALLOCATION",
      "MINIMUM INVESTMENT",
      "Subsequent\\s*(?:Purchases?)?|Additional",
      "SIP",
      "PLAN.+?PTIONS",
      "ENTRY\\s*LOAD",
      "EXIT\\s*LOAD",
      "EXPENSE\\s*RATIO",
      "BENCHMARK",
      "FUND\\s*MANAGER",
      "TOTAL.*?ENCE",
      "MANAGING\\s*THIS\\s*FUND",
      "MANAGING\\s*THIS\\s*FUND",
      "PRODUCT POSITIONING",
      "QUANTITATIVE INFORMATION",
      "EOL",
    ],
    metric: "(Yield\\s*to\\s*Maturity|Modified Duration|Annualised Portfolio YTM|Average Maturity|Portfolio Turnover Ratio\\s*\\(Total\\)|Standard Deviation|Residual Maturity|Modified Duration|Annualised Yield|Macaulay Duration|Tracking Error|Sharpe Ratio|Portfolio Beta|R\\s*-?\\s*Squared|Treynor)\\s*(-?[\\d.]+\\s*(?:years?|days?|months?)?)",
    manager: {
      name: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s+([A-Z][a-z]+\\s[A-Z][a-z]+)",
      exp: "([\\d]+ years?)",
      since: "Since\\s*([0-9]+\\s*-\\s*[A-Za-z]+\\.?\\s*-\\s*[0-9]+)",
    },
    lumpsum: "(.+?)(?:Subsequent|Additional)\\s*purchases?(.+?)(?:SIP|Systematic)",
    min_amt: "([\\d,]+(?:\\.\\d+)?).*?([\\d,]+(?:\\.\\d+)?)",
    escape: "[^a-zA-Z0-9.,\\s\\-\\(\\)\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(scheme|dummy|before).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(quantitative_information)": ["_extract_generic_data", "metric"],
    ".*(minimum_investment|subsequent|additional)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*benchmark_index": ["_extract_findall_select_first_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*allotment",
    ".*monthly_avg_aum",
    "fund_manager",
    "benchmark_index",
    ".*(minimum_investment|subsequent|additional_investment)",
    "metrics",
    "load",
    "fund_manager",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "mutual_fund_name",
    "monthly_aaum_date",
  ],
  MERGEKEYS: {
    load: [".*entry_load", ".*exit_load"],
    fund_manager: [".*fund_manager", ".*total_exper.*", ".*managing_this.*"],
    metrics: [".*quantitative"],
  },
  CLONEKEYS: {
    additional_investment: ".*subsequent",
    benchmark_index: ".*benchmark$",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {
    fund_manager: "_update_manager_data",
    // benchmark_index: "_update_benchmark_data",
  },
}
