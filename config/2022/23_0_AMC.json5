{
  AMC_NAME: "Kotak Mahindra Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Kotak Mahindra Asset Management Company Limited(KMAMCL)",
    mutual_fund_name: "Kotak Mahindra Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(KOTAK.*?(?:PLAN|PATH|FUND\\s*(?:OF FUNDS?\\s*|-\\s*\\w+)?|ETF|FOF|PATH|FTF|INDEX\\s*(?:.*?FUND)?)\\s*(?:SERIES\\s*\\d+)?)",
      bbox: [0, 0, 420, 80],
    },
    clip_bbox: [[0, 80, 155, 812]],
    line_x: 150.0,
    data: {
      size: [6, 8],
      color: [-15445130, -14590595],
      update_size: 30.0,
      font: ["Frutiger-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    scheme: [
      "Fund Manager",
      "AAUM",
      "AUM",
      "Benchmark",
      "Allotment\\s*date",
      "Folio count",
      "Investment\\s*[Oo]bjective",
      "IDCW Frequency",
      "Minimum\\s*Investment\\s*Amount",
      "Additional\\s*Investment",
      "Entry\\s*Load",
      "Exit\\s*Load",
      "Total\\s*Expense\\s*Ratio",
      "EOL",
    ],
    metric: "(PE|PBV|Portfolio Turnover|Standard Deviation|Beta|Sharpe|Tracking Error|Average Maturity|Modified Duration|Annualised YTM|Macaulay Duration|Tracking Error)\\s*(?:\\([\\w\\s%-]*\\)|\\*)?\\s*(-?[\\d.]+\\s*(?:[Dd]ays?|[Yy]e?a?rs?|[Mm]onths?|%|[Tt]imes?)?)",
    manager: {
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)",
      fields: ["name"],
    },
    min_amt: "([\\d,]+).*?([\\d,]+|any)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\u00b7",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    "^(metrics.*|.*dividend_frequency|.*idcw_frequency)": ["_extract_generic_data", "metric"],
    ".*(additional_investment|minimum_investment_amount)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*fund_manager": ["_extract_manager_data", "manager"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "metrics",
    "aaum$",
    ".*fund_manager",
    ".*benchmark",
    ".*allotment_date",
    ".*additional_investment",
    ".*minimum_investment_amount",
    "load",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
  ],
  MERGEKEYS: {
    load: [".*entry_load$", ".*exit_load$", "^load"],
    metrics: [".*(dividend_frequency|idcw_frequency)", "metrics"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
