{
  AMC_NAME: "Pgim India Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "PGIM India Asset Management Private Limited",
    mutual_fund_name: "PGIM India Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "([A-Z0-9\\s\\-]+\\s*PGIM INDIA|CREDIT RISK FUND)",
      bbox: [0, 0, 300, 80],
    },
    clip_bbox: [
      [0, 115, 210, 812],
      [0, 730, 570, 812],
    ],
    line_x: 210.0,
    data: {
      size: [6, 12],
      color: [-1],
      update_size: 30.0,
      font: ["PrudentialModern-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: true,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [
    "fund_details",
    "^regular_plan_and_direct_plan.*",
    "for_subscription_as_*",
  ],
  REGEX: {
    aum: ".*Monthly Average AUM.*?([\\d,.]+)$",
    benchmark: "((?:Nifty|BSE|NYSE|Domestic|CRISIL).+?(?:Gold|Silver|TRI|Index))",
    date: "(\\d+\\/\\d+\\/\\d{3,4})",
    scheme: [
      "Investment Objective",
      "Fund Manager",
      "Benchmark",
      "Option",
      "Monthly Average AUM",
      "AUM as on",
      "NAV",
      "Load Structure",
      "Entry Load",
      "Exit Load",
      "IDCW\\s+History",
      "EOL",
    ],
    lumpsum: [
      "Inception Date",
      "Direct Plan",
      "EOL",
      "Application Amount",
      "Additional Purchase",
      "SIP",
      "EOL",
    ],
    min_amt: "([\\d,.]+)\\s*\\/?\\s*\\-?\\s*and in multiples of\\s*([\\d,.]+)\\s*\\/?\\s*\\-?\\s*thereafter\\.?",
    manager: {
      pattern: "(?:\\(w\\.e\\.f\\.?\\s*(.*?)\\)?)?\\s*(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s*(?:\\(.+?\\))?\\s*\\(.*?([0-9]+ years) of experience.*?\\)",
      fields: ["since", "name", "exp"],
    },
    metrics: "(Portfolio\\s*Turnover|Standard\\s*Deviation\\s*of\\s*Fund|Beta|Sharpe\\s*Ratio|Average\\s*Maturity|Modified Duration|Macaulay Duration|Portfolio Yield).*?\\s*(-?[\\d.,]+\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]e?a?rs|%)?)",
    load: "Entry Load(.+)Exit Load(.+)$",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\/\\:]+",
  },
  PATTERN_TO_FUNCTION: {
    before: ["_extract_scheme_data", "scheme"],
    "dummy.*one": ["_extract_scheme_data", "lumpsum"],
    // "^for_subscription.*": ["_extract_scheme_data", "lumpsum"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*fund_manager": ["_extract_manager_data", "manager"],
    // ".*load_structure": ["_extract_load_data", "load"],
    // ".*average_aum$": ["_extract_generic_data", "aum"],
    ".*aum_as_on$": ["_extract_generic_data", "metrics"],
    "dummy.*(application_amount|additional_purchase)$": [
      "_extract_amt_data",
      "min_amt",
    ],
    // "^for_subscription.*": ["_extract_amt_data", "min_amt"],
    ".*inception_date": ["_extract_generic_data", "date"],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(additional_purchase|application_amount)",
    ".*(fund_manager|benchmark|average_aum|inception_date)",
    "load",
    "amc_name",
    "main_scheme_name",
    "mutual_fund_name",
    "page_number",
    "monthly_aaum_date",
    "metrics",
  ],
  MERGEKEYS: {
    load: [".*(entry_load|exit_load)"],
    metrics: [".*aum_as_on"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
