{
  AMC_NAME: "Jio BlackRock Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Jio BlackRock Asset Management Private Limited",
    mutual_fund_name: "Jio BlackRock Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Jio\\s*Black\\s*Rock.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)",
      bbox: [0, 0, 600, 120],
    },
    clip_bbox: [[0, 120, 590, 820]],
    line_x: 590.0,
    data: {
      size: [8, 18],
      color: [0],
      update_size: 30.0,
      font: ["Swiss721BT-Bold"],
    },
    content_size: [30.0, 17.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)",
    date: "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})",
    scheme: [
      "INVESTMENT OBJECTIVE",
      "[Pp]lan and [Oo]ptions?",
      "Allotment Date",
      "Minimum Investment.*?Lumpsum",
      "Minimum Investment\\s*\\-\\s*SIP",
      "Total Expense Ratio",
      "Benchmark",
      "NAV per Unit",
      "Exit Load",
      "FUND\\s*MANAGER",
      "FUND SIZE",
      "Monthly\\s*Average\\s*AUM",
      "QUANTITATIVE\\s*DATA",
      "EOL",
    ],
    metrics: "(YTM|Macaulay Duration|Yield\\s*to|average maturity|Modified Duration|Tracking\\s*Error|Portfolio\\s*Turnover\\s*Ratio)\\s*\\-?\\:?\\s*(-?\\d+\\.?\\d*\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)",
    min_amt: "([\\d,]+).*?(\\d+|any)",
    load: "Entry Load(.*)Exit Load(.*)$",
    manager: {
      name: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "Total\\s*Experience\\s*([0-9]+\\s*[Yy]ears?)",
      since: "fund\\s*since\\s*([A-Za-z]+\\s+\\d{4})",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dummy).*": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_investment_lumpsum|additional_purchase)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*assets_under_management": ["_extract_generic_data", "aum"],
    ".*(quantitative_data|net_asset_value)": [
      "_extract_generic_data",
      "metrics",
    ],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "load",
    "metrics",
    ".*(minimum_application_amount|minimum_additional)",
    ".*fund_manager",
    ".*allotment_date",
    ".*benchmark",
    ".*monthly_average_aum",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
  ],
  MERGEKEYS: {
    minimum_application_amount: [".*minimum_investment_lumpsum"],
    metrics: [".*quantitative_indicators", ".*quantitative_data"],
    load: [".*(entry_load|exit_load)"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { ".*fund_manager": "_update_manager_data" },
}
