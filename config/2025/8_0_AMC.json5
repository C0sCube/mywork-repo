{AMC_NAME: "Dsp Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "DSP Investment Managers Private Limited", mutual_fund_name: "DSP Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "((?:DSP|Bharat).+?(?:Funds?|FUNDS|ETF|F[Oo]F|Path|Plan)\\s*(?:of [Ff]unds?|Fund of [Ff]unds?|F[Oo]F|Funds?)?)", bbox: [0, 0, 580, 40]}, clip_bbox: [[0, 5, 120, 812], [480, 5, 624, 812]], data: {size: [7, 11], update_size: 30.0, font: ["TrebuchetMS-Bold"], color: [-1]}, content_size: [30.0, 10.0], line_x: 180.0, method: "clip", line_side: "", max_financial_index_highlight: 5, pdf_ocr: false, sanitize_fund: false, stop_words: ["last_12_months"], table: "107-123"}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: ["^before.*", "^dummy.*"], REGEX: {scheme: ["INCEPTION DATE?", "BENCHMARK", "NAV AS ON", "TOTAL AUM", "EOL"], scheme2: ["INCEPTION DATE", "BENCHMARK", "NAV AS ON", "TOTAL AUM", "EOL"], lumpsum: "(.+?)\\s*Options available", load: "Entry\\s*Load\\s*\\:?(.+?)Exit\\s*Load\\s*\\:?(.+?)$", min_amt: "minimum investment\\D+(\\d+)\\D*?((?:any|\\d+))\\s*.+?ereafter", manager: {pattern: "(?:Mr|Mrs|Ms)?\\.?\\s*([A-Za-z\\s]+)\\s*(?:\\([A-Za-z\\s]+\\))?\\s*Total Work\\D+(\\d+\\s*years?)\\.?\\s*Managing.+?since\\s*([A-Za-z]+\\s+\\d{1,2},\\s+\\d{4}|[A-Za-z]+\\s+\\d{4})", fields: ["name", "exp", "since"]}, metrics: "(MONTHLY AVER?A?G?E?|MONTHLY AVERAGE AUM|PORTFOLIO YTM|MAC DURATION|AVERAGE MATU|MODIFIED DURA|\\(Last\\s*[0-9]+\\s*months\\)|YTM|MACAULAY\\s*DURATION|MODIFIED DURATION|AVERAGE MATURITY|Standard Deviation|Beta|R-Squared|Sharpe Ratio|Tracking Error\\s*Regular Plan)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Yy]ears?|[Dd]ays?|[Mm]onths?|Cr|[tT]imes?|%)?)", escape: "[^a-zA-Z0-9.,\\s\\-\\(\\)\\+\\%]+|\u2022"}, PATTERN_TO_FUNCTION: {"^dummy.*": ["_extract_scheme_data", "scheme"], "^before.*": ["_extract_scheme_data", "scheme2"], load: ["_extract_load_data", "load"], minimum_investment: ["_extract_generic_data", "lumpsum"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*total_aum": ["_extract_generic_data", "metrics"], fund_manager: ["_extract_manager_data", "manager"], minimum_investment: ["_extract_amt_data", "min_amt"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["amc_name", "main_scheme_name", "page_number", "mutual_fund_name", "monthly_aaum_date", ".*benchmark", ".*inception", "metrics", ".*month_end_expense", "load", "fund_manager", "min_amt", "min_addl_amt"], MERGEKEYS: {load: [".*(entry_load|exit_load)"], min_amt: [".*minimum_investment"], metrics: [".*total_aum"]}, CLONEKEYS: {min_addl_amt: "minimum_investment"}, PROMOTE_KEYS: {metrics: {monthly_aaum_value: ".*(monthly_aver?a?g?e?)"}}, SPECIAL_FUNCTIONS: {}}