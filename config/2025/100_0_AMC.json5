{
  "AMC_NAME": "The Wealth Company Mutual Fund",
  "CLONEKEYS": {},
  "DUPLICATE_MUTUAL_FUNDS": {},
  "IMP_DATA": {
    "amc_name": "Wealth Company Asset Management Holdings Private Limited",
    "mutual_fund_name": "Wealth Company Mutual Fund"
  },
  "MAIN_MAP": {
    "map": true,
    "select": true,
    "special": true
  },
  "MERGEKEYS": {
    "load": [
      ".*(entry_load|exit_load)"
    ],
    "metrics": [
      ".*quantitative_indicators",
      ".*quantitative_data"
    ],
    "minimum_application_amount": [
      ".*minimum_investment_lumpsum"
    ]
  },
  "PARAMS": {
    "clip_bbox": [
      [
        0,
        90,
        585,
        680
      ],
      [
        0,
        490,
        290,
        840
      ],
      [
        300,
        490,
        585,
        840
      ]
    ],
    "content_size": [
      30,
      17
    ],
    "data": {
      "color": [
        0
      ],
      "font": [
        "Swiss721BT-Bold"
      ],
      "size": [
        8,
        18
      ],
      "update_size": 30
    },
    "line_side": "",
    "line_x": 590,
    "max_financial_index_highlight": 7,
    "method": "clip",
    "pdf_ocr": false,
    "sanitize_fund": false,
    "stop_words": [],
    "title": {
      "bbox": [
        0,
        0,
        600,
        100
      ],
      "ocr": false,
      "pattern": "(Wealth Company.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)"
    }
  },
  "PATTERN_TO_FUNCTION": {
    "^before.*": [
      "_extract_scheme_data",
      "scheme"
    ],
    "^dummy.*": [
      "_extract_scheme_data",
      "scheme2"
    ]
  },
  "PRE_DATA_SELECT": [],
  "PROMOTE_KEYS": {},
  "REGEX": {
    "aum": "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)",
    "date": "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})",
    "escape": "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)",
    "load": "Entry Load(.*)Exit Load(.*)$",
    "manager": {
      "exp": "Total\\s*Experience\\s*([0-9]+\\s*[Yy]ears?)",
      "name": "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      "since": "fund\\s*since\\s*([A-Za-z]+\\s+\\d{4})"
    },
    "metrics": "(YTM|Macaulay Duration|Yield\\s*to|average maturity|Modified Duration|Tracking\\s*Error|Portfolio\\s*Turnover\\s*Ratio)\\s*\\-?\\:?\\s*(-?\\d+\\.?\\d*\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)",
    "min_amt": "([\\d,]+).*?(\\d+|any)",
    "scheme": [
      "Investment\\s*Objective",
      "Scheme\\s*Details",
      "Allotment Date",
      "Face Value",
      "Minimum Application Amount",
      "Minimum Additional Amount",
      "Benchmark",
      "Special faciltiies",
      "EOL"
    ],
    "scheme2": [
      "Fund\\s*Managers?\\s+",
      "Fund Size",
      "Month End AUM",
      "Monthly Avg\\.?\\s*AUM",
      "EOL",
      "Load Structure",
      "Entry\\s*load",
      "Expense ratio",
      "Fund Size",
      "Month End AUM",
      "Monthly Avg\\.?\\s*AUM",
      "EOL"
    ]
  },
  "SECONDARY_PATTERN_TO_FUNCTION": {
    ".*(minimum_application|minimum_additional)": [
      "_extract_amt_data",
      "min_amt"
    ],
    ".*load_structure": [
      "_extract_generic_data",
      "aum"
    ],
    ".*quantitative_measures": [
      "_extract_generic_data",
      "metrics"
    ]
  },
  "SELECTKEYS": [
    "load",
    "metrics",
    ".*(minimum_application_amount|minimum_additional)",
    ".*fund_manager",
    ".*date_of_allotment",
    ".*benchmark",
    ".*monthly_avg\\.?\\s*aum$",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name"
  ],
  "SPECIAL_FUNCTIONS": {},
  "TERTIARY_PATTERN_TO_FUNCTION": {}
}