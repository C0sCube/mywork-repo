{
  AMC_NAME: "The Wealth Company Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Wealth Company Asset Management Holdings Private Limited",
    mutual_fund_name: "Wealth Company Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(Wealth Company.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)",
      bbox: [0, 0, 600, 100],
    },
    clip_bbox: [
      [0, 90, 585, 680],
      [0, 490, 290, 840],
      [300, 490, 585, 840],
    ],
    line_x: 590.0,
    data: {
      size: [8, 18],
      color: [0],
      update_size: 30.0,
      font: ["Swiss721BT-Bold"],
    },
    content_size: [30.0, 17.0],
    method: "clip",
    line_side: "",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    aum: "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)",
    date: "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})",
    scheme: [
      "Investment\\s*Objective",
      "Scheme\\s*Details",
      "Allotment Date",
      "Face Value",
      "Minimum Application Amount",
      "Minimum Additional Amount",
      "Benchmark",
      "Special faciltiies",
      "EOL",
    ],
    scheme2: [
      "Fund\\s*Managers?\\s+",
      "Fund Size",
      "Month End AUM",
      "Monthly Avg\\.?\\s*AUM",
      "EOL",
      "Load Structure",
      "Entry\\s*load",
      "Expense ratio",
      "Fund Size",
      "Month End AUM",
      "Monthly Avg\\.?\\s*AUM",
      "EOL",
    ],
    metrics: "(YTM|Macaulay Duration|Yield\\s*to|average maturity|Modified Duration|Tracking\\s*Error|Portfolio\\s*Turnover\\s*Ratio)\\s*\\-?\\:?\\s*(-?\\d+\\.?\\d*\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|[Cc]rores?|%)?)",
    min_amt: "([\\d,]+).*?(\\d+|any)",
    load: "Entry Load(.*)Exit Load(.*)$",
    manager: {
      name: "(?:Mr|Mrs|Ms)\\.?\\s+([A-Za-z]+\\s*[A-Za-z]+)",
      exp: "Total\\s*Experience\\s*([0-9]+\\s*[Yy]ears?)",
      since: "fund\\s*since\\s*([A-Za-z]+\\s+\\d{4})",
    },
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)",
  },
  PATTERN_TO_FUNCTION: {
    "^before.*": ["_extract_scheme_data", "scheme"],
    "^dummy.*": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(minimum_application|minimum_additional)": [
      "_extract_amt_data",
      "min_amt",
    ],
    ".*load_structure": ["_extract_generic_data", "aum"],
    ".*quantitative_measures": ["_extract_generic_data", "metrics"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "load",
    "metrics",
    ".*(minimum_application_amount|minimum_additional)",
    ".*fund_manager",
    ".*date_of_allotment",
    ".*benchmark",
    ".*monthly_avg\\.?\\s*aum$",
    "amc_name",
    "main_scheme_name",
    "page_number",
    "monthly_aaum_date",
    "mutual_fund_name",
  ],
  MERGEKEYS: {
    minimum_application_amount: [".*minimum_investment_lumpsum"],
    metrics: [".*quantitative_indicators", ".*quantitative_data"],
    load: [".*(entry_load|exit_load)"],
  },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
