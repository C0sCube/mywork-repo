{AMC_NAME: "Motilal Oswal Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Motilal Oswal Asset Management Company Limited", mutual_fund_name: "Motilal Oswal Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Motilal.*?(?:Fund\\s*(?:o?O?f Funds?(?:.+?Aggressive|.+?Conservative)?)?|ETF(?:.+? of Funds?)?|FoF))", bbox: [0, 0, 600, 60]}, clip_bbox: [[0, 65, 170, 812], [370, 265, 700, 812]], line_x: 170.0, data: {size: [7, 14], color: [-1], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 15.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: ["category"]}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {benchmark: "(?:Index\\s*Fund|^)\\s*(.+?)(?:\\s*Redemption\\b|Minimum application|$)", metric: "(Monthly AAUM|Information Ratio|Latest AUM|Beta|Portfolio Turnover Ratio|Standard Deviation|Sharpe Ratio|Average Maturity|YTM|Macaulay Duration|Modified Duration)\\s*(-?[\\d,.]+\\s*(?:years?|months?|days?)?)", load: "(?:Entry Load)?\\s*(Nil|\\S.*?)\\s*(?:Exit Load\\s*(Nil|\\S.*?))?$", lumpsum: "Minimum Application Amount(.+?)Minimum Additional Purchase(.+)$", min_amt: "([\\d,]+).*?([\\d,]+)", date: "\\d{2}\\-?[A-Za-z]+\\-?\\d{4}", scheme: ["Investment Objective", "Benchmark", "Minimum\\s*A?a?pplication Amount", "Additional\\s*(?:Application|Purchase)\\s*Amount", "Entry\\s*Load", "Exit\\s*Load", "Inception Date|Allotment Date", "NAV", "Monthly AAUM", "Latest AUM", "Fund Manager", "Total Expenses Ratio", "EOL", "Total Expenses Ratio", "Quantitative Indicators", "EOL", "Fund Manager", "Quantitative Indicators", "Total Expenses Ratio", "EOL", "Monthly AAUM", "Latest AUM", "Quantitative Indicators", "EOL", "Benchmark", "Redemption\\s*P?p?roceeds", "Minimum.+?pplication Amount", "Exit Load"], manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s*(?:Managing this|has managed this)\\s*fund since\\s*(\\d{1,2}\\-?[A-Za-z,]+\\-?\\d{3,4}|Inception).+?(\\d+\\s*years?)", fields: ["name", "since", "exp"]}, exit: ".+?Exit\\s*Load(.+)(?:NAV|Fund Manager|$)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,]+"}, PATTERN_TO_FUNCTION: {"^(before|dummy.*)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(latest_aum|quantitative_indicators)": ["_extract_generic_data", "metric"], ".*(purchase_amount|application_amount)$": ["_extract_amt_data", "min_amt"], ".*fun.*ana.*": ["_extract_manager_data", "manager"], "befo.+?benchmark": ["_extract_generic_data", "benchmark"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*(minimum_applicationt|additional_purchase)", "load", ".*allotment_date", "benchmark_index", "metrics", "fund_manager", "main_scheme_name", "amc_name", "page_number", "mutual_fund_name", "monthly_aaum_date", "check_monthly_aaum", ".*monthly_aaum$"], MERGEKEYS: {load: ["before.entry_load", "before.exit_load"], fund_manager: [".*fun.*mana.*"], metrics: [".*latest_aum", ".*quantitative_indicators"], minimum_application: [".*application_amount"], additional_purchase: [".*purchase_amount"]}, CLONEKEYS: {benchmark_index: "befo.+?benchmark"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}