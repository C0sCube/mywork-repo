{AMC_NAME: "Angel One Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Angel One Asset Management Company Limited", mutual_fund_name: "Angel One Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Angel\\s*One.+?(?:Fund|ETF|Plan|Duration|Saver|Index|F[Oo]F)\\s*(?:.+?Growth|Fund of Funds?|of Funds|Funds?|F[Oo]F)?)", bbox: [0, 0, 500, 170]}, clip_bbox: [[0, 160, 300, 812], [300, 160, 600, 812]], line_x: 300.0, data: {size: [14, 20], color: [-1], update_size: 30.0, font: ["Barlow-Medium"]}, content_size: [30.0, 18.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "Rs\\.?\\s*([\\d,.]+\\s*crs?)", benchmark: "((?:Nifty|BSE|Domestic|CRISIL).+?(?:Index|TRI|Silver|Gold))", load: "Entry Load(.*?)\\s*Exit Load(.*)$", scheme: ["Inception Date", "Benchmark Index", "ISIN", "NAV", "Fund Manager", "EOL", "Monthly Average AUM", "Month End AUM", "Tracking Error", "Total Expense Ratio", "Load Structure", "Investment Options", "Minimum Investment Amount", "Additional Investment Amount", "Quantitative Indicators", "EOL", "Benchmark Index", "NAV", "EOL"], manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([\\w\\s]+)\\s*(?:Overall|Total)\\s*experience\\s*(\\d+ years?).+?managing.+?since\\s*([A-Za-z]+\\s+\\d{4})", fields: ["name", "exp", "since"]}, tracking: "(\\d+\\.\\d*)", min_amt: "([\\d,]+).*?([\\d,]+)", metric: "(Residual Maturity|Macaulay Duration|Modif?i?ed Duration|Average Maturity|Portfolio YTM|Standard Deviation|Beta|Sharpe Ratio|Portfolio Turnover|Treynor Ratio|Average PE|Average PBV|Average Dividend Yield)\\s*([\\d.]+\\s*(?:[Yy]ears?|[Dd]ays?|[Mm]onths?|[Tt]imes?)?)", escape: "[^A-Za-z0-9\\s\\.,\\-\\(\\)\\+\\%]+"}, PATTERN_TO_FUNCTION: {"^(before|dummy.*)": ["_extract_scheme_non_esc_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(additional_investment_amount|minimum_investment_amount)": ["_extract_amt_data", "min_amt"], ".*monthly_average_aum": ["_extract_generic_data", "aum"], ".*tracking_error": ["_extract_generic_data", "tracking"], ".*load_structure": ["_extract_load_data", "load"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*quantitative_indicators": ["_extract_generic_data", "metric"], ".*benchmark": ["_extract_generic_data", "benchmark"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["main_scheme_name", "amc_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "metrics", "load", ".*monthly_average_aum", ".*(inception_date|benchmark_index)", ".*(minimum_investment_amount|additional_investment_amount)", ".*fund_manager"], MERGEKEYS: {fund_manager: ["fund_manager", "experience_in_managing_the_fund", "managing_fund_since"], metrics: ["metrics", ".*tracking_error", ".*quantitative_indicato"], load: [".*load_structure"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}