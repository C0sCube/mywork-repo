{
  AMC_NAME: "Uti Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "UTI Asset Management Company Limited",
    mutual_fund_name: "UTI Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(UTI.*?(?:FUND|PLAN|ETF|FTF|FOF|Fund|ETF)\\s*(?:FUND OF FUND|\\s*OF FUND|.+?DURATION)?)",
      bbox: [0, 0, 460, 35],
    },
    clip_bbox: [
      [0, 65, 200, 812],
      [380, 65, 580, 812],
      [205, 65, 450, 812],
    ],
    line_x: 200.0,
    data: {
      size: [7, 10],
      color: [666], //[-65794, -1
      update_size: 30.0,
      font: ["Calibri-Bold"],
    },
    content_size: [30.0, 8.0],
    method: "clip",
    line_side: "left",
    max_financial_index_highlight: 5,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    load: "Entry Load(.*)Exit Load(.*)$",
    scheme: [
      "Investment Objective",
      "Date\\s*[Oo]f\\s*[iI]nception",
      "Benchmark\\s*[Ii]ndex",
      "Fund\\s*Manager",
      "Plan.+?Option",
      "Load Structure",
      "Fund AUM.+?Folio",
      "Fund Size Monthly Average",
      "Closing AUM",
      "Minimum Investment Amount",
      "NAV per unit",
      "EOL",
    ],
    scheme2: ["Quan.*?ta.*?ve Indicators", "EOL","Po.+?olio\\s*Parameters","EOL"],
    min_amt: "(?:Growth)?\\s*([\\d,]+\\.?\\d+)\\-?\\D*\\s*((?:[\\d,.]+)?)",
    manager: {
      pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([A-Za-z]+\\s*[A-Za-z]+).*?Managing (?:the|this) scheme since\\s*([A-Za-z]+\\s*[0-9]+|Inception|[0-9]+-[A-Za-z]+-[0-9]+)",
      fields: ["name", "since"],
    },
    metrics: "(Yield to Maturity|Weighted Average Maturity|Modi.+?Dura.*?on|Macaulay\\s*Dur.+?on|Standard\\s*Devia.+?on|Beta|Sharpe Ra.+?o|Por.+?olio Turnover|Tracking Error|P\\s*E|ROE|P\\s*B)\\s*([\\d,.]+\\s*([Yy]e?a?rs?|[Dd]ays?|[Mm]onths?|%)?)",
    escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+",
    date:"(\\d{2}.+$)"
  },
  PATTERN_TO_FUNCTION: {
    before: ["_extract_scheme_non_esc_data", "scheme"],
    "^dummy.*": ["_extract_scheme_data", "scheme2"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    // ".*monthly_average": ["_extract_generic_data", "aum"],
    ".*date_of_inception": ["_extract_generic_data", "date"],
    ".*fund_manager": ["_extract_manager_data", "manager"],
    ".*load_structure": ["_extract_load_data", "load"],
    ".*(metrics|market_capital|quan.+?dicators|por.+?_parameter).*": [
      "_extract_generic_data",
      "metrics",
    ],
    ".*minimum_investment": ["_extract_amt_data", "min_amt"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    ".*(benchmark_index|date_of_inception)",
    ".*fund_manager",
    ".*monthly_average",
    ".*load_structure",
    ".*minimum_investment",
    "amc_name",
    "main_scheme_name",
    "monthly_aaum_date",
    "page_number",
    "mutual_fund_name",
    "metrics",
  ],
  MERGEKEYS: { metrics: ["^metrics$", "^metrics_.*", ".*market_capital",".*quan.+?dicators",".*por.+?_parameter"] },
  CLONEKEYS: {},
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: {},
}
