{AMC_NAME: "Canara Robeco Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Canara Robeco Asset Management Company Limited", mutual_fund_name: "Canara Robeco Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "CANARA.*?\\)", bbox: [0, 0, 500, 55]}, clip_bbox: [[0, 55, 220, 850]], data: {size: [8, 11], update_size: 30.0, font: ["Taz-SemiLight"], color: [-1]}, content_size: [30.0, 10.0], line_x: 180.0, method: "clip", line_side: "", max_financial_index_highlight: 0, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {benchmark: "((?:BSE|NIFTY|CRISIL|Physical).+?(?:TRI|Index|Silver|Gold))", scheme: ["SCHEME OBJECTIVE", "DAT.+?ALLOTMENT", "BENCHMARK", "ASSET ALLOCATION", "MINIMUM INVESTMENT", "Subsequent|Additional", "SIP", "EXIT LOAD", "FUND\\s*MANAGER", "Month end Assets Under Management", "Monthly AVG Assets Under Management", "NAV", "EXPENSE RATIO", "QUANTITATIVE INFORMATION", "EOL"], metric: "(Modified Duration|Annualised Portfolio YTM|Yield|Average Maturity|Portfolio Turnover Ratio|Standard Deviation|Residual Maturity|Modified Duration|Annualised Yield|Macaulay Duration|Tracking Error|Sharpe Ratio|Portfolio Beta|R\\s*-?\\s*Squared|Treynor)\\s*(-?[\\d.]+\\s*(?:years?|days?|months?)?)", manager: {pattern: "(?:Mr|Mrs|Ms)\\.\\s*([A-Za-z]+\\s*[A-Za-z]+)\\s*(?:\\(.+\\))?\\s*\\(Managing.+?(\\d{1,2}\\s*-\\s*[A-Za-z]+\\s*-\\s*\\d{1,2}).+?([0-9]+\\s*[Yy]ears?)\\)", fields: ["name", "since", "exp"]}, lumpsum: "(.+?)(?:Subsequent|Additional)\\s*purchases?(.+?)(?:SIP|Systematic)", min_amt: "([\\d,]+(?:\\.\\d+)?).*?([\\d,]+(?:\\.\\d+)?)", aum: "([\\d,.]+)\\s*Crores", escape: "[^a-zA-Z0-9.,\\s\\-\\(\\)\\+\\%\\:\\&]+"}, PATTERN_TO_FUNCTION: {"^(scheme|dummy|before).*": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(quantitative_information)": ["_extract_generic_data", "metric"], ".*(minimum_investment|subsequent|additional)": ["_extract_amt_data", "min_amt"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*monthly_avg_assets_under_management": ["_extract_generic_data", "aum"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*allotment", ".*monthly_avg_assets_under_management", "fund_manager", "benchmark_index", ".*(minimum_investment|subsequent|additional_investment)", "metrics", "load", ".*fund_manager", "amc_name", "main_scheme_name", "page_number", "mutual_fund_name", "monthly_aaum_date"], MERGEKEYS: {load: [".*entry_load", ".*exit_load"], metrics: [".*quantitative"]}, CLONEKEYS: {additional_investment: ".*subsequent", benchmark_index: ".*benchmark$", monthly_aaum_value: ".*monthly_avg_assets_under_management"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {benchmark_index: "_update_benchmark_data"}}