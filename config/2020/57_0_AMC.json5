{AMC_NAME: "Nj Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "NJ Asset Management Private Limited", mutual_fund_name: "NJ Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(NJ.+?(?:FUNDS?|ETF|F[Oo]F|PATH|SCHEME|PLAN)\\s*(?:OF FUNDS?|FUND OF FUNDS?|F[Oo]F|FUNDS?)?)", bbox: [0, 30, 480, 70]}, clip_bbox: [[0, 5, 250, 812]], line_x: 250.0, data: {size: [6, 11], color: [-14475488], update_size: 30.0, font: ["Swiss721BT-Medium"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+", min_amt: "([\\d,]+).*?([\\d,]+)", lump_amt: "For Lumpsum .+?\\s*([\\d,]+).*?([\\d,]+)", manager: {name: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)\\s*([A-Za-z]+\\s*[A-Za-z]+)", since: "(?:since|from)\\s*([A-Za-z]+\\s*\\d{1,2},\\s*\\d{3,4}|inception)", exp: "\\d{1,2} years"}, metrics: "(Beta|Portfolio Turnover Ratio|Standard Deviation|Sharpe Ratio|Average Maturity|YTM|Yield to Maturity|Macaulay Duration|Modified Duration)\\s*([\\d.]+\\s*(?:days|months|years|yrs)?)"}, PATTERN_TO_FUNCTION: {"^(exit.*|entry.*|.*benchmark|additional_bench*|monthly_average|closing_aum)": ["_extract_str_data", null], ".*date_of_allotment": ["_extract_str_data", null]}, SECONDARY_PATTERN_TO_FUNCTION: {metrics: ["_extract_generic_data", "metrics"], additional_investment: ["_extract_amt_data", "min_amt"], minimum_investment: ["_extract_amt_data", "lump_amt"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*(entry_load|exit_load)", "load", "fund_manager", "work_experience", "managing_the_scheme_since", "amc_name", "date_of_allotment", "main_scheme_name", "monthly_aaum_date", "mutual_fund_name", "page_number", "monthly_average_aum", "additional_investment", "metrics", "minimum_investment", "benchmark_index"], MERGEKEYS: {load: ["entry_load", "exit_load"], fund_manager: ["fund_manager", "managing_the_scheme_since", "work_experience"], metrics: ["metrics", "metrics_"], benchmark_index: [".*benchmark"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {fund_manager: "_update_manager_data", benchmark_index: "_update_benchmark_data"}}