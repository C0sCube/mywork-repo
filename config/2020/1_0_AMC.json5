{
  AMC_NAME: "Axis Mutual Fund",
  MAIN_MAP: { select: true, map: true, special: true },
  IMP_DATA: {
    amc_name: "Axis Asset Management Company Limited",
    mutual_fund_name: "Axis Mutual Fund",
  },
  PARAMS: {
    title: {
      ocr: false,
      pattern: "(AXIS.*?(?:FUNDS?|ETF[Ss]?|INDEX|PLAN|PATH|F[Oo]F)\\s*(?:OF\\s*FUNDS?|F[Oo]F|FUNDS?|FUND OF FUNDS?|.+?PLAN)?)",
      bbox: [0, 0, 580, 36],
    },
    clip_bbox: [
      [0, 90, 200, 500],
      [180, 90, 360, 500],
      [0, 470, 360, 820],
    ],
    line_x: 260.0,
    data: {
      size: [6, 12],
      color: [23],
      update_size: 30.0,
      font: ["Lato-Bold"],
    },
    content_size: [30.0, 10.0],
    method: "clip",
    line_side: "both",
    max_financial_index_highlight: 7,
    pdf_ocr: false,
    sanitize_fund: false,
    stop_words: [],
  },
  DUPLICATE_MUTUAL_FUNDS: {},
  PRE_DATA_SELECT: [],
  REGEX: {
    date: "(\\d{1,2}\\s*(?:th|rd|st|nd)?\\s*(?:Jan|Feb|Mar|Apr|May|June|July|Aug|Sep|Oct|Nov|Dec)\\D*\\d{4})",
    benchmark: "(.+?)\\s*(?:FUND\\s*MAN?|STATISTICAL\\s*MEAS|TRACKING|$)",
    scheme: [
      "DATE\\s*OF\\s*ALLOTMENT",
      "BENCHMARK",
      "PORTFOLIO\\s*TURNOVER",
      "EOL",
      "Entry Load",
      "Exit Load",
      "EOL",
      "MONTHLY\\s*AVERAGE",
      "AS ON",
      "EOL",
      "BENCHMARK",
      "FUND\\s*MANAG?E?R?",
      "EOL",
    ],
    aum: "([\\d.,]+\\s*[Cc]r)",
    ptr: "([\\d.]+ times)",
    tracking: "([\\d.]+)\\s*(?=\\(As comp)",
    manager: {
      name: "(?:Mr|Ms|Mrs)\\.?\\s*(\\w+\\s\\w+)",
      exp: "p?e?r?i?e?n?c?e?\\s*(\\d+\\s*[Yy]ears?)",
    },
    metrics: "(MODIFIED\\s*DURATION|AVERAGE\\s*MATURITY|RESIDUAL\\s*MATURITY|PORTFOLIO\\s*YIELD\\s*\\(YIELD|MACAULAY\\s*DURATION|TRACKING\\s*ERROR|Standard\\s*Deviation|Beta|Sharpe\\s*Ratio|PORTFOLIO\\s*TURNOVER\\s*\\(\\d+YEAR\\))\\D*(-?\\d+\\.?\\d*\\s*(?:[Yy]ears?|[Dd]ays?|[Mm]onths?|%|[Tt]imes?|%)?)",
    escape: "[^A-Za-z0-9\\s\\.,\\-\\(\\)\\+\\%\\:\\&]+",
  },
  PATTERN_TO_FUNCTION: {
    "^(before|dumm.*)": ["_extract_scheme_data", "scheme"],
  },
  SECONDARY_PATTERN_TO_FUNCTION: {
    ".*(statistical_measure.*|as_on)": ["_extract_generic_data", "metrics"],
    ".*monthly_?average$": ["_extract_generic_data", "aum"],
    ".*portfolio_turnover": ["_extract_generic_data", "ptr"],
    ".*tracking_error": ["_extract_generic_data", "tracking"],
    ".*date_?of_?allotment": ["_extract_generic_data", "date"],
    ".*benchmark": ["_extract_generic_data", "benchmark"],
  },
  TERTIARY_PATTERN_TO_FUNCTION: {},
  SELECTKEYS: [
    "main_scheme_name",
    "mutual_fund_name",
    "monthly_aaum_value",
    "scheme_launch_date",
    "amc_name",
    "page_number",
    "monthly_aaum_date",
    ".*benchmark",
    "fund_manager",
    "metrics",
    "load",
    "pgn",
  ],
  MERGEKEYS: {
    load: [".*entry_load", ".*exit_load"],
    metrics: [
      ".*(portfolio_turnover|tracking_error|statistical_measure.*|as_on.*)",
    ],
    fund_manager: [".*fund_manager"],
  },
  CLONEKEYS: {
    monthly_aaum_value: ".*monthly_?average$",
    scheme_launch_date: ".*date_of_?allotment$",
  },
  PROMOTE_KEYS: {},
  SPECIAL_FUNCTIONS: { fund_manager: "_update_manager_data" },
}
