{AMC_NAME: "Motilal Oswal Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Motilal Oswal Asset Management Company Limited", mutual_fund_name: "Motilal Oswal Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Motilal.*?(?:Fund\\s*(?:o?O?f Funds?(?:.+?Aggressive|.+?Conservative)?)?|ETF(?:.+? of Funds?)?|FoF))", bbox: [0, 0, 600, 60]}, clip_bbox: [[0, 65, 170, 860], [370, 265, 770, 860]], line_x: 170.0, data: {size: [7, 14], color: [-1], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 15.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: ["category"]}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {benchmark: "^(.*?)(?:\\s*Redemption\\b|$)", metric: "(Monthly AAUM|Information Ratio|Latest AUM|Beta|Portfolio Turnover Ratio|Standard Deviation|Sharpe Ratio|Average Maturity|YTM|Macaulay Duration|Modified Duration|Tracking\\s*Error)\\s*\\:?\\s*(-?[\\d,.]+\\s*(?:[Yy]ears?|[Mm]onths?|[Dd]ays?|[Yy]rs|[Tt]imes?|%)?)", load: "(?:Entry Load)?\\s*(Nil|\\S.*?)\\s*(?:Exit Load\\s*(Nil|\\S.*?))?$", lumpsum: "Minimum Application Amount(.+?)Minimum Additional Purchase(.+)$", min_amt: "([\\d,]+).*?([\\d,]+)", date: "\\d{2}\\-?[A-Za-z]+\\-?\\d{4}", scheme: ["Investment Objective", "Benchmark", "Minimum\\s*[Aa]pplication\\s*[Aa]mount", "[Aa]dditional\\s*[Aa]pplication\\s*[Aa]mount", "Entry\\s*Load", "Exit\\s*Load", "Date\\s*of\\s*[Aa]llotment", "NAV", "Monthly AAUM", "Latest\\s*AUM", "Fund\\s*Manager", "EOL", "Quantitative\\s*Indicators?", "EOL"], manager: {pattern: "(?:Mr|Mrs|Ms)\\.?\\s*([A-Za-z]+\\s*[A-Za-z]+)\\s*.+?(?:since|from)\\s*([0-9]+\\s*-\\s*[A-Za-z]+\\s*\\-\\s*\\d{4}|[A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4}|inception).+?(?:than|overall|around|about|over|to|has)\\s*([0-9]+\\s*years?)", fields: ["name", "since", "exp"]}, exit: ".+?Exit\\s*Load(.+)(?:NAV|Fund Manager|$)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+"}, PATTERN_TO_FUNCTION: {"^(before|dummy.*)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(latest_aum|quantitative_indicators)": ["_extract_generic_data", "metric"], ".*(minimum.+?amount$|additional_.+?_amount)": ["_extract_amt_data", "min_amt"], ".*fund_manager": ["_extract_manager_data", "manager"], "befo.+?benchmark": ["_extract_generic_data", "benchmark"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*(minimum_application_amount|additional_investment)", "load", ".*date_of_allotment", "benchmark_index", "metrics", ".*fund_manager", "main_scheme_name", "amc_name", "page_number", "mutual_fund_name", "monthly_aaum_date", "check_monthly_aaum", ".*monthly_aaum$"], MERGEKEYS: {load: [".*entry_load", ".*exit_load"], metrics: [".*latest_aum", ".*quantitative_indicators"]}, CLONEKEYS: {benchmark_index: "befo.+?benchmark", additional_investment: ".*additional_application_amount"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}