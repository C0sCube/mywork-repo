{AMC_NAME: "Samco Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Samco Asset Management Private Limited", mutual_fund_name: "Samco Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Samco.*?(?:Fund|ETF|FOF|Index)\\s*(?:of Funds?|FOF)?)", bbox: [0, 30, 600, 100]}, clip_bbox: [[35, 120, 250, 812], [250, 120, 624, 812]], line_x: 200.0, data: {size: [7, 12], color: [-1], update_size: 30.0, font: ["Inter-SemiBold", "Inter-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: ["(Fixed Income Portion of Portfolio)"]}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(AUM|Average AUM).*?([\\d,]+\\.\\d{2})", min_amt: "([\\d,]+).*?([\\d,]+)", date: "\\d{2}[A-Za-z]+\\d{4}", nav: "(Regular Growth|Direct Growth|Regular IDCW|Direct IDCW)\\s*([\\d,.]+)", metric: "(Standard\\s*Deviation|Portfolio\\s*Turnover\\s*Ratio|Annualised\\s*Portfolio\\s*YTM|Macaulay\\s*Duration|Residual\\s*Maturity|Modified\\s*Duration|Beta|Treynor\\D*?|Sharpe\\D*?)\\s*(-?[\\d,.]+\\s*(?:days?|months?|years?)?)", scheme: ["Inception Date", "Benchmark", "Min.?\\s*Application", "Additional", "Entry Load", "Exit Load", "Total Expense", "EOL"], manager: {pattern: "(?:mr|ms|mrs)\\.?\\s*(.+?)(?:,\\s*([\\w\\s,]+?))?\\(Managing.+?scheme since(.*?)\\)\\s*Total Experience\\s*(?:Over|Around)\\s*(\\d+ years?)", fields: ["name", "desig", "since", "exp"]}, escape: "[^a-zA-Z0-9\\.\\,\\+\\(\\)\\s\\%]+"}, PATTERN_TO_FUNCTION: {"^fund_manag": ["_extract_manager_data", "manager"], "^scheme_det": ["_extract_scheme_non_esc_data", "scheme"], "^aum.*": ["_extract_generic_data", "aum"]}, SECONDARY_PATTERN_TO_FUNCTION: {"^(metrics|quantitative_data).*": ["_extract_generic_data", "metric"], ".*(min_application|min.application|additional|min._application|min_.application)": ["_extract_amt_data", "min_amt"], ".*inception_date": ["_extract_generic_data", "date"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*(inception_date|benchmark)", "min_amt", "min_addl_amt", "fund_manager", "aum.average_aum", "amc_name", "main_scheme_name", "monthly_aaum_date", "metrics", "mutual_fund_name", "page_number", "load"], MERGEKEYS: {load: [".*entry_load", ".*exit_load"], metrics: ["^metrics.*", "quantitative_data.*"], min_amt: [".*(min.application|min_.application|min._application)"], min_addl_amt: [".*additional"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}