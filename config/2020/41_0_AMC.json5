{AMC_NAME: "Uti Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "UTI Asset Management Company Limited", mutual_fund_name: "UTI Mutual Fund"}, PARAMS: {title: {ocr: true, pattern: "(UTI.*?(?:SCHEME|FUNDS?|PLAN|ETF|F[Oo]F|Fund|ETF)\\s*(?:FUND\\s*OF\\s*FUNDS?|\\s*OF\\s*FUNDS?|.+?DURATION|.+?PLAN)?)", bbox: [0, 0, 560, 75]}, clip_bbox: [[0, 80, 295, 850], [295, 80, 600, 850]], line_x: 200.0, data: {size: [7, 14], color: [-666], update_size: 30.0, font: ["Calibri-Bold"]}, content_size: [30.0, 12.0], method: "clip", line_side: "left", max_financial_index_highlight: 5, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(.+Average|.+AUM)\\s*([\\d,.]+)", scheme: ["Type of Scheme", "Date of inception\\s*allotment", "Fund Manager", "Monthly Average", "Closing AUM", "NAV in the month", "Minimum Investment Amount", "Unit Holding", "Entry\\s*Load", "Exit\\s*Load", "NAV per unit", "EOL"], scheme2: ["Por.+?olio as on", "Quan.+?ve\\s*Indicators", "EOL"], load: "Entry Load(.*)Exit Load(.*)$", min_amt: "([\\d,]+\\.?\\d+)\\-?\\D*\\s*((?:[\\d,.]+)?)", manager: {pattern: "(?:Mrs\\.?|Ms\\.?|Mr\\.?)?\\s*([A-Za-z]+\\s*[A-Za-z]+).+?scheme\\s*since\\s*([A-Za-z]+\\s*\\-?\\s*\\d{4})", fields: ["name", "since"]}, metrics: "(Yield to Maturity|Weighted Average Maturity|Modif?i?ed\\D*|Macaulay\\D*|Standard Deviat?i?on|Beta|Sharpe Rat?i?o|Port?f?olio Turnover\\D*|Tracking Error|PE|ROE|PB)\\s*\\:?\\s*(-?[\\d,.]+\\s*([Yy]e?a?rs?|[Dd]ays?|[Mm]onths?|[Tt]imes?|%)?)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(Annual\\)|\u00b7|\\(%\\)"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"], dummy: ["_extract_scheme_data", "scheme2"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*fund_manager": ["_extract_manager_data", "manager"], "^(metrics|market_capital|.*quantave_indicators|.*unit_holding).*": ["_extract_generic_data", "metrics"], ".*minimum_investment": ["_extract_amt_data", "min_amt"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*date_of_incepti.*", "benchmark_index", ".*fund_manager", ".*monthly_average", "load", "aum", ".*minimum_investment", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "metrics"], MERGEKEYS: {metrics: [".*unit_holding", "^metrics$", "^metrics_.*", "^market_capital", ".*quantave_indicators"], load: [".*(entry_load|exit_load)"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}