ERN_TO_FUNCTION: {"^(before|dummy.*?(?:one|two)|scheme_details).*": ["_extract_scheme_non_esc_data", "scheme"], "^dummy.*three": ["_extract_generic_data", "benchmark"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*quantitative_indicators": ["_extract_metric_data", "metrics"], ".*(monthly_aaum|closing_aum)$": ["_extract_generic_data", "aum"], ".*fund_managers": ["_extract_manager_data", "manager"], ".*benchmark$": ["_extract_generic_data", "benchmark"], ".*(min.addl.investment|application_amount)": ["_extract_amt_data", "min_amt"], ".*allotment_date$": ["_extract_generic_data", "date"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["amc_name", "main_scheme_name", "monthly_aaum_date", "monthly_aaum_value", "mutual_fund_name", "page_number", ".*fund_managers", "metrics", "load", ".*allotment_date", "benchmark_index", ".*monthly_aaum", ".*(min.?addl.?investment|application_amount)"], MERGEKEYS: {load: [".*exit_load"], metrics: ["^metrics", "^metrics_bravo", ".*quantitative_indicators"]}, CLONEKEYS: {benchmark_index: "^dummy.*?three$"}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}