{AMC_NAME: "Hdfc Mutual Fund Passive", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "HDFC Asset Management Company Limited", mutual_fund_name: "HDFC Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(HDFC.*?(?:FUND|Fund|ETF|FO?o?F|Index|Active|Tax[Ss]aver)\\s*(?:of Funds?|.+?Plan|Fund of Funds?|Fund)?)", bbox: [0, 0, 460, 60]}, clip_bbox: [[0, 60, 210, 812]], line_x: 210.0, data: {size: [5, 13], color: [-15970928, -14401393, -15971185, -1], update_size: 30.0, font: ["Taz-SemiBold", "Cambria-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: [], table: ""}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(As on|Average for Month).*?([\\d,.]+)\\s*Cr", track: ".+?months\\s*(?:regular)?\\s*([\\d.]+)", escape: "[^A-Za-z0-9\\/\\s\\-\\(\\)\\.\\,\\+\\%]+|\u00a5|\u00b7", load: "", manager: "", metric: "(Total Turnover|Standard Deviation|Beta|Sharpe Ratio|Residual Maturity|Macaulay Duration|Modified Duration|Annualized Portfolio YTM)\\s*(-?[\\d.]+\\s*(?:years|days|months)?)"}, PATTERN_TO_FUNCTION: {"^(tracking_error|date_of_allotment|.*benchmark_index|exit_load).*$": ["_extract_str_data", null], "^aum": ["_extract_generic_data", "aum"]}, SECONDARY_PATTERN_TO_FUNCTION: {metrics: ["_extract_generic_data", "metric"], tracking_error: ["_extract_generic_data", "track"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["fund_manager", ".*average_for_month$", "metrics", "_?benchmark_index", "addl_benchmark_index", "exit_load", "^date_of_allotment.*", "amc_name", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "tracking_error", "load"], MERGEKEYS: {load: ["exit_load"], metrics: ["metrics", "tracking_error"], benchmark_index: [".*benchmark_index$"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {fund_manager: "_update_manager_data", benchmark_index: "_update_benchmark_data"}}