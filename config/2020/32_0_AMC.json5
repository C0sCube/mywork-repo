{AMC_NAME: "Quantum Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Quantum Asset Management Company Private Limited", mutual_fund_name: "Quantum Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(QUANTUM.+?(?:FUNDS?|ETF|PATH|.+?PLAN|SAVER)\\s*(?:FUND\\s+OF\\s+FUNDS?|FUNDS?|OF\\s+FUNDS?|F[oO]F)?)", bbox: [0, 0, 490, 90]}, clip_bbox: [[0, 140, 320, 860], [320, 140, 600, 860]], line_x: 180.0, data: {size: [6, 11], color: [-23], update_size: 30.0, font: ["Prompt-SemiBold"]}, content_size: [30.0, 8.0], method: "clip", line_side: "", max_financial_index_highlight: 2, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "(Average AUM|Absolute AUM)\\s*([\\d,.]+)", load: "Entry Load\\s*(.*?)\\s*Exit Load\\s*(.*?)$", scheme: ["Category of Scheme", "Investment Objective", "Inception Date", "Benchmark Index", "Declaration of Net Asset Value", "Average AUM", "Absolute AUM", "Fund Manager", "Portfolio Information|Key\\s*Statistics", "Entry Load", "Exit Load", "Total Expense Ratio|EOL", "Minimum Application Amount", "Additional Purchase", "Portfolio Turnover Ratio", "Redemption Proceeds", "EOL", "Minimum Application Amount", "Additional Purchase", "Redemption Proceeds", "EOL", "Total Expense Ratio", "Portfolio Turnover Ratio", "EOL"], ptr: "([\\d\\.]+\\s*(?:%)?|NA)", manager: {pattern: "(?:Mr\\.?|Mrs\\.?|Ms\\.?)?\\s*([\\w\\s]+)(?:\\s*\\-\\s*([\\w\\s]+)\\s*)?\\(Work Experience\\s*([\\d]+ years)\\)(?:.*?(?:effective from|fund since)?\\s*([A-Z][a-z]+\\s*\\d{1,2},?\\s*\\d{4}))?", fields: ["name", "desig", "exp", "since"]}, min_amt: "([\\d,]+)-?\\D+?([\\d]+)-?", metric: "(Residual Maturity\\D*|Average Maturity.+?of the Month|Annualised Portfolio YTM|Modified Duration|Macaulays? Duration|Standard Deviation|Beta\\D*|Sharpe Ratio\\D*|Tracking Error|Alpha)\\s*(-?[\\d.]+\\s*(?:days|months|years|%)?)", escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(Annualised\\)|\\(\\s*Date\\s*of\\s*Allotment\\s*\\)"}, PATTERN_TO_FUNCTION: {"^(before|dummy.*)": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(minimum_application_amount|additional_purchase)": ["_extract_amt_data", "min_amt"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*(key_statistics|portfolio_information|metric)$": ["_extract_generic_data", "metric"], ".*portfolio_turnover_ratio": ["_extract_generic_data", "ptr"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*(inception_date|benchmark_index)", "load", "amc_name", ".*average_aum", ".*fund_manager", "main_scheme_name", "monthly_aaum_date", "page_number", "mutual_fund_name", "metrics", ".*(minimum_application_amount|additional_purchase)"], MERGEKEYS: {load: [".*entry_load", ".*exit_load"], metrics: [".*key_statistics$", "metrics", ".*portfolio_turnover_ratio", ".*portfolio_information$"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}