{AMC_NAME: "Quant Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Quant Money Managers Limited", mutual_fund_name: "Quant Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "([Qq]uant.*?(?:Bond|FUNDS?|Funds?|ETF|Index|Plan|Path)\\s*(?:of [Ff]unds?|F[oO]F|Funds?|Fund of [Ff]unds?)?)", bbox: [0, 0, 480, 80]}, clip_bbox: [[0, 85, 195, 830]], line_x: 200.0, data: {size: [7, 20], color: [-666], update_size: 30.0, font: ["Calibri,Bold", "Inter-Bold"]}, content_size: [30.0, 14.0], method: "clip", line_side: "", max_financial_index_highlight: 5, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: ["^dummy.*"], REGEX: {scheme: ["INVESTMENT OBJECTIVE", "DATE\\s*OF\\s*ALLOTMENT", "FUND\\s*MANAGERS?", "NAV as on", "MINIMUM INVESTMENT", "SUBSEQUENT INVESTMENT", "EXPENSE RATIO", "LOAD\\s*STRUCTURE", "FUND SIZE", "BENCHMARK INDEX", "EOL"], load: "Entry(.+?)Exit(.+?)\\s*(?=NAV Details|BENCHMARK INDEX|$)", aum: "([\\d,.]+\\s*[Cc]r?)", manager: {pattern: "([A-Za-z\\s]{2,}),?", fields: ["name"]}, min_amt: "([\\d,]+).*?([\\d,]+)", date: "([0-9]+\\s*[A-Za-z]+\\s*[0-9]+)", metrics: "(Standard\\s*Deviation|Sharpe\\s*Ratio|Sortino\\s*Ratio|Jensens\\s*Alpha|R-?\\s*Squared|Downside\\s*Deviation|Upside\\s*Deviation|Average\\s*Maturity|Modified\\s*Duration|Macaulay\\s*Duration|Yield to Maturity|Beta|Portfolio\\s*Turnover\\s*Ratio)\\s*\\:?\\s*(-?\\d+\\,?(?:\\.\\d+)?\\s*(?:[Dd]ays?|[Mm]onths?|[Yy]ears?|%|[Tt]imes?|%)?)", escape: "([^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\:\\&]+|\\(1\\s*[Yy]ear\\))"}, PATTERN_TO_FUNCTION: {before: ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(subsequent_investment|minimum_investment)$": ["_extract_amt_data", "min_amt"], ".*load_structure": ["_extract_generic_data", "metrics"], ".*fund_size": ["_extract_generic_data", "aum"], ".*inception_date": ["_extract_generic_data", "date"], ".*fund_managers?": ["_extract_manager_data", "manager"]}, TERTIARY_PATTER