{AMC_NAME: "Tata Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Tata Asset Management Private Limited", mutual_fund_name: "Tata Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "((?:Tata|Treasury|TATA).*?(?:Funds?(?:.*?Plan)?|ETF\\s*(?:Fund of Funds?)?|FOF|EOF|Plan.*?(?:days)?))", bbox: [0, 0, 540, 40]}, clip_bbox: [[0, 50, 160, 750]], line_x: 160.0, data: {size: [5, 8], color: [-1], update_size: 30.0, font: ["Swiss721BT-BoldCondensed", "DMSans-Bold"]}, content_size: [30.0, 10.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {nav: "((?:Regular|Direct|Reg)\\s*(?:Growth|IDCW))\\s*([\\d,.]+)", decimal: "([\\d,]+\\.\\d+)", ter: "(Regular|Direct)\\s*([\\d,.]+)", metric: "(PE|PB|Average Maturity|Macaulay Duration|Modified Duration|Modif?i?ed Duration|Yield to Maturity\\D+?|Std. Dev|Sharpe Ratio|Portfolio Beta|R Squared|Treynor|Jenson|Portfolio Turnover\\D*)\\s*(-?[\\d.]+\\s*(?:years?|months?|days?|%)?|NA)", manager: {pattern: "([A-Za-z\\s]+)\\s*\\(Managing Since\\s*([A-Za-z0-9\\s\\-]+) and overall experience of ([a-z0-9\\s]+)\\)", fields: ["name", "since", "exp"]}, load: "Entry\\s*Load\\s*(.*?)Exit\\s*Load\\s*(.*?)$", min_amt: "([\\d,]+).*?([\\d,]+)", scheme: ["INVESTMENT STYLE", "INVESTMENT OBJECTIVE", "DATE OF ALLOTMENT", "FUND MANAGER", "BENCHMARK", "NAV", "MONTHLY AVERAGE AUM", "TURN OVER", "VOLATILITY MEASURES", "MINIMUM INVESTMENT", "ADDITIONAL INVESTMENT", "LOAD\\s*STRUCTURE", "EOL"], escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%\\&]+|\\(Annualised\\)"}, PATTERN_TO_FUNCTION: {"before.*": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(monthly_average|portfolio_turnover).*": ["_extract_generic_data", "decimal"], ".*fund_manager": ["_extract_manager_data", "manager"], ".*(volatility_measures|turn_over)": ["_extract_generic_data", "metric"], ".*(minimum_investment|additional_investment)": ["_extract_amt_data", "min_amt"], ".*load_structure": ["_extract_load_data", "load"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: [".*date_of_allotment", ".*fund_manager", ".*benchmark", ".*monthly_average_aum", "monthly_aaum_date", "mutual_fund_name", "amc_name", "main_scheme_name", "metrics", ".*(minimum_investment|additional_investment)", ".*load_structure", "page_number"], MERGEKEYS: {metrics: [".*volatility_measures", "portfolio_turnover_ratio", ".*turn_over"]}, CLONEKEYS: {}, PROMOTE_KEYS: {}, SPECIAL_FUNCTIONS: {}}