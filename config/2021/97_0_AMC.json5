{AMC_NAME: "Unifi Mutual Fund", MAIN_MAP: {select: true, map: true, special: true}, IMP_DATA: {amc_name: "Unifi Asset Management Company Private Limited", mutual_fund_name: "Unifi Mutual Fund"}, PARAMS: {title: {ocr: false, pattern: "(Unifi.+?(?:Fund|ETF|F[Oo]F|Index|Path|Duration|Index|Plan)\\s*(?:.+?Growth|F[Oo]F|Fund of Funds?|of Funds?|Fund?)?)", bbox: [0, 0, 600, 60]}, clip_bbox: [[0, 55, 270, 580], [270, 55, 580, 580]], line_x: 270.0, data: {size: [8, 18], color: [0], update_size: 30.0, font: ["Swiss721BT-Bold"]}, content_size: [30.0, 17.0], method: "clip", line_side: "", max_financial_index_highlight: 7, pdf_ocr: false, sanitize_fund: false, stop_words: []}, DUPLICATE_MUTUAL_FUNDS: {}, PRE_DATA_SELECT: [], REGEX: {aum: "[\\d,.]+\\s*crores?\\s*([\\d,.]+\\s*crores?)", date: "([A-Za-z]+\\s*\\d{2}\\,\\s*\\d{4})", scheme: ["Name of the Fund", "Type of the Scheme", "Date of Allotment", "Tier\\s*1\\s*Benchmark Index", "Additional Benchmark", "Fund Specs", "Assets Under Management", "Quantitative Indicators", "Fund Holdings", "EOL", "Initial purchase", "Additional purchase", "Load Structure", "Entry Load", "Exit Load", "TER", "Net Asset Value", "EOL", "Fund Holdings", "Initial purchase"], metrics: {key: "(Assets\\s*Under\\s*Management|Average\\s*AUM|Regular Plan|Direct Plan|Macaulay Duration|Yield\\s*to|avg maturity|Modified Duration)", value: "(-?\\d+\\.\\d+\\s*(?:days?|months?|years?|crores?|%)?)"}, min_amt: "([\\d,]+)()\\s*Minimum", load: "Entry Load(.*)Exit Load(.*)$", manager: {pattern: "(\\w+\\s+\\w+)\\s*([A-Za-z]+\\s*Fund\\s*Manager)", fields: ["name", "desig"]}, escape: "[^A-Za-z0-9\\s\\-\\(\\)\\.\\,\\+\\%]+|\\(For disclaimers refer page no\\.\\s*[0-9]+\\)"}, PATTERN_TO_FUNCTION: {"^(before|dummy).*": ["_extract_scheme_data", "scheme"]}, SECONDARY_PATTERN_TO_FUNCTION: {".*(initial_purchase|additional_purchase)": ["_extract_amt_data", "min_amt"], ".*assets_under_management": ["_extract_generic_data", "aum"], ".*(quantitative_indicators|net_asset_value)": ["_extract_iter_data", "metrics"]}, TERTIARY_PATTERN_TO_FUNCTION: {}, SELECTKEYS: ["load", "metrics", "(minimum_application_amount|minimum_additional)", "fund_manager", "scheme_launch_date", ".*tier_1_benchmark_index", "monthly_aaum_value", "amc_name", "main_scheme_name", "page_number", "monthly_aaum_date", "mutual_fund_name"], MERGEKEYS: {minimum_application_amount: [".*initial_purchase"], minimum_additional: [".*additional_purchase"], metrics: [".*quantitative_indicators", ".*net_asset_value"], load: [".*(entry_load|exit_load)"]}, CLONEKEYS: {fund_manager: "before.date_of_allotment", scheme_launch_date: "before.date_of_allotment", monthly_aaum_value: "before.assets_under_management"}, PROMOTE_KEYS: {".*fund_specs": {monthly_aaum_value: "average"}}, SPECIAL_FUNCTIONS: {scheme_launch_date: "_update_date_data", fund_manager: "_update_manager_data"}}